#Область РаботаСРегистром
&НаСервере
Процедура mona_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка) 
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;	
	Mona_СоздатьРеквизитыЭлементыДляДанныхРегистра();
	ЕстьДанные = mona_ОбработкаИнтернетЗаказа.ЗаполнитьФормуЗаказаИзРегистра(ЭтаФорма); 	
	ЭтаФорма["СостояниеВСборке"] = mona_СтатусыЗаказов.ВСборке();
	ЭтаФорма["ЕстьДанныеРегистра"] = ЕстьДанные;  
	ЭтаФорма["mona_ПоказыватьДанныеОнлайн"] = Истина;   
	Элементы.mona_ГруппаЗаказОнлайн.Видимость = Истина;
	Если ЕстьДанные Тогда
		mona_ОбработкаИнтернетЗаказа.ЗаполнитьПоТочкеОтгрузки(Объект);
		Элементы.ВидЗаказа.Доступность = Ложь;     
		Элементы.СпособДоставки.Видимость = Ложь;   
		Если Объект.ВидЗаказа = mona_ОбработкаИнтернетЗаказа.ВидЗаказаПВЗ() Тогда       
			Элементы.СтраницаДоставка.Доступность =  Ложь;
			Элементы.СтраницаДоставка.Видимость =  Ложь;
		Иначе 
			Элементы.ДоставкаУльтраПраваяКолонка.Доступность =  Ложь; 
			Элементы.ДоставкаУльтраПраваяКолонка.Видимость =  Ложь; 
			Элементы.ГруппаРассчитатьДоставку.Видимость =  Истина;    
			Элементы.НоменклатураДоставки.Видимость =  Истина;
			Элементы.Курьер.Видимость =  Истина;
			Элементы.ТрекНомер.Видимость =  Истина;  
			Элементы.ГруппаСтоимостьВсплывающая.Видимость =  Истина;
		КонецЕсли;
		Если Элементы.Найти("СтруктурнаяЕдиницаРезерв")<> Неопределено Тогда     
			Элементы.СтруктурнаяЕдиницаРезерв.Доступность = Не ЗначениеЗаполнено(Объект.СтруктурнаяЕдиницаРезерв);
		КонецЕсли;	
	КонецЕсли; 
КонецПроцедуры   

&НаСервере
Процедура Mona_СоздатьРеквизитыЭлементыДляДанныхРегистра() 
	Добавляемые = Новый Массив;   
	
	Добавляемые.Добавить(Новый РеквизитФормы("СостояниеВСборке", Новый ОписаниеТипов("СправочникСсылка.СостоянияЗаказовПокупателей")));
	Добавляемые.Добавить(Новый РеквизитФормы("НовыйЧек", Новый ОписаниеТипов("ДокументСсылка.ЧекККМ")));
	Добавляемые.Добавить(Новый РеквизитФормы("ХолоднаяЧастьСобрана", Новый ОписаниеТипов("Булево")));
	Добавляемые.Добавить(Новый РеквизитФормы("СухаяЧастьСобрана", Новый ОписаниеТипов("Булево")));
	Добавляемые.Добавить(Новый РеквизитФормы("ИсточникЗаказа", Новый ОписаниеТипов("Строка")));
	Добавляемые.Добавить(Новый РеквизитФормы("МоментОтмены", Новый ОписаниеТипов("Дата")));
	Добавляемые.Добавить(Новый РеквизитФормы("НачалоВременногоИнтервалаДоставки", Новый ОписаниеТипов("Дата")));
	Добавляемые.Добавить(Новый РеквизитФормы("ПричинаОтмены", Новый ОписаниеТипов("СправочникСсылка.ПричиныОтменыЗаказа")));
	Добавляемые.Добавить(Новый РеквизитФормы("ПризнакОтложенногоВозврата", Новый ОписаниеТипов("Булево")));
	Добавляемые.Добавить(Новый РеквизитФормы("ПризнакЧастичнойСборки", Новый ОписаниеТипов("Булево")));    
	Добавляемые.Добавить(Новый РеквизитФормы("ДатаОкончанияПриема", Новый ОписаниеТипов("Дата")));
	Добавляемые.Добавить(Новый РеквизитФормы("mona_ПоказыватьДанныеОнлайн", Новый ОписаниеТипов("Булево")));
	Добавляемые.Добавить(Новый РеквизитФормы("ВремяУстановкиЧастичнойСборки", Новый ОписаниеТипов("Дата"))); 
	Добавляемые.Добавить(Новый РеквизитФормы("ОтменаДоОтгрузки", Новый ОписаниеТипов("Строка")));
	Добавляемые.Добавить(Новый РеквизитФормы("ЗаказОтменен", Новый ОписаниеТипов("Булево")));
	Добавляемые.Добавить(Новый РеквизитФормы("Холодный", Новый ОписаниеТипов("Булево"),"Объект.Запасы"));
	Добавляемые.Добавить(Новый РеквизитФормы("ЕстьДанныеРегистра", Новый ОписаниеТипов("Булево")));  
    //Добавил
	Добавляемые.Добавить(Новый РеквизитФормы("РешениеОператораПринято",
    Новый ОписаниеТипов("Булево")));
	Добавляемые.Добавить(Новый РеквизитФормы("ДатаРешенияОператора",
    Новый ОписаниеТипов("Дата")));
	
	ИзменитьРеквизиты(Добавляемые);           
	
	Группа = Элементы.Добавить("mona_ГруппаЗаказОнлайн", Тип("ГруппаФормы"),ЭтаФорма);	
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;  
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная; 
	Группа.Заголовок   = "Данные онлайн-заказа";
	Элементы.Переместить(Группа, Группа.Родитель, Mona_ПолучитьСледующийПосле("Шапка"));   
	
	ГруппаСборка = mona_Общий.ДобавитьПодгруппу(Элементы,"mona_ГруппаСборка","Сборка",Группа);   
	mona_Общий.ДобавитьПолеФормы(Элементы,"СухаяЧастьСобрана",ГруппаСборка,"Сухая собрана");
	mona_Общий.ДобавитьПолеФормы(Элементы,"ХолоднаяЧастьСобрана",ГруппаСборка,"Холодная собрана");   
	mona_Общий.ДобавитьПолеФормы(Элементы,"ПризнакЧастичнойСборки",ГруппаСборка,"Частичная сборка");
	ГруппаОтмена = mona_Общий.ДобавитьПодгруппу(Элементы,"mona_ГруппаОтмена", "Отмена",Группа);
	mona_Общий.ДобавитьПолеФормы(Элементы,"ОтменаДоОтгрузки",ГруппаОтмена,"Момент отмены");
	mona_Общий.ДобавитьПолеФормы(Элементы,"ПричинаОтмены",ГруппаОтмена,"Причина отмены");
	mona_Общий.ДобавитьПолеФормы(Элементы,"ПризнакОтложенногоВозврата",ГруппаОтмена,"Отложенный возврат"); 
	mona_Общий.ДобавитьПолеФормы(Элементы,"ДатаОкончанияПриема",ГруппаОтмена,"Дата окончания приема на возврат");   
	ГруппаДоставка = mona_Общий.ДобавитьПодгруппу(Элементы,"mona_ГруппаДоставка", "Доставка" ,Группа);   
	mona_Общий.ДобавитьПолеФормы(Элементы,"НачалоВременногоИнтервалаДоставки",ГруппаДоставка, "Слот доставки");
	mona_Общий.ДобавитьПолеФормы(Элементы,"ИсточникЗаказа",ГруппаДоставка, "Источник");             
	mona_Общий.ДобавитьПолеФормы(Элементы,"Долгота",ГруппаДоставка, ,"Объект.mona_Долгота");             
	mona_Общий.ДобавитьПолеФормы(Элементы,"Широта",ГруппаДоставка, ,"Объект.mona_Широта"); 
	//Добавил
	mona_Общий.ДобавитьПолеФормы(Элементы, "РешениеОператораПринято", ГруппаОтмена, "Решение оператора принято");
	mona_Общий.ДобавитьПолеФормы(Элементы, "ДатаРешенияОператора", ГруппаОтмена, "Дата решения");

	Группа.Видимость = ЭтаФорма["mona_ПоказыватьДанныеОнлайн"];     
	Элементы.mona_Поле_ИсточникЗаказа.Доступность = Ложь;   
	Элементы.mona_Поле_НачалоВременногоИнтервалаДоставки.Доступность = Ложь; 
	
	НоваяКолонка = Элементы.Вставить("ЗапасыХолодный", Тип("ПолеФормы"), Элементы.Запасы,Элементы.ЗапасыГруппаНоменклатура);
	НоваяКолонка.Вид = ВидПоляФормы.ПолеНадписи;
	
	// Связываем визуальный элемент с программно созданным реквизитом данных
	НоваяКолонка.ПутьКДанным = "Объект.Запасы.Холодный";
	НоваяКолонка.Заголовок = "Холодный";
	НоваяКолонка.Формат = "БЛ=; БИ=❄";
	Для Каждого стр из Объект.Запасы Цикл
		Если mona_ОбработкаИнтернетЗаказа.ЯвляетсяСкоропортом(стр.Номенклатура) Тогда 
			стр.Холодный = Истина;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	    



&НаСервере
Функция Mona_ПолучитьСледующийПосле(ИмяЭлемента)                                                  
	Элем = Элементы.Найти(ИмяЭлемента);
	Если Элем = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Родитель = Элем.Родитель;
	Индекс = Родитель.ПодчиненныеЭлементы.Индекс(Элем);
	Если Индекс +1< Родитель.ПодчиненныеЭлементы.Количество() Тогда
		Возврат Родитель.ПодчиненныеЭлементы.Получить(Индекс +1);
	КонецЕсли;
	Возврат Неопределено;		
КонецФункции		

&НаКлиенте
функция ВСборке()
	Возврат Объект.СостояниеЗаказа = ЭтаФорма["СостояниеВСборке"];	
КонецФункции
#КонецОбласти 


#Область СобытияФормы
&НаКлиенте
Процедура mona_ПриОткрытииПосле(Отказ)  
	Если Не ЭтаФорма["ЕстьДанныеРегистра"] Тогда
		ПроверкаСобранности();                  
	КонецЕсли;   
	
	//Добавил
	Если ФлагЧастичнойСборкиВРегистре(Объект.Ссылка) Тогда
   		Элементы.mona_Поле_ПризнакЧастичнойСборки.Доступность = Ложь;
	Иначе
    	Элементы.mona_Поле_ПризнакЧастичнойСборки.Доступность = ВСборке();
	КонецЕсли;    
    ///////
	
	mona_УстановитьОбязательностьПричиныОтмены();
	Если  ВСборке() тогда
		РежимСборки = Не РежимСборки;
		Элементы.РежимСборкиЗаказа.Пометка = РежимСборки;
		
		ЕстьСобранныеПозиции = СборкаЗаказовКлиент.ЕстьСобранныеПозиции(Объект.Запасы, ТекущийВариантКП);
		
		СборкаЗаказовКлиент.УстановитьВидимостьЭлементовФормыСборкиЗаказа(ЭтаФорма);
		
		Если РежимСборки Тогда
			Для Каждого СтрокаЗапасы Из Объект.Запасы Цикл
				СборкаЗаказовКлиент.РассчитатьРасхождения(ЭтаФорма, СтрокаЗапасы, Ложь);
			КонецЦикла;
			СборкаЗаказовКлиент.УстановитьОтборСобранныхПозиций(Элементы, Истина, ТекущийВариантКП);
		Иначе
			УстановитьОтборПоВариантуКП();
			Элементы.ДекорацияОтборПоРасхождениям.Видимость = Ложь;
		КонецЕсли;
	конецесли;
	
	СтароеСостояние = Объект.СостояниеЗаказа; 
	Если НЕ РежимОстаткиИРезервы Тогда
		ОстаткиИРезервы(Неопределено);
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура mona_СостояниеЗаказаПриИзмененииПосле(Элемент)
	ОчиститьСообщения();
	mona_СостояниеЗаказаНаСервер(СтароеСостояние);
	mona_УстановитьОбязательностьПричиныОтмены();
	Если Не ЭтаФорма["НовыйЧек"].Пустая() Тогда  
		ПробитиеЧека(ЭтаФорма["НовыйЧек"]);
		ЭтаФорма["НовыйЧек"] = Неопределено;
	КонецЕсли;	
	
	//Если Строка(Объект.СостояниеЗаказа) = "Отгружен" и ПроверитьСменаОткрытаНаКассе() тогда
	//	Чек = mona_СозданиеЧеков(Объект.Ссылка);
	//	Если Чек = Неопределено Тогда 
	//		Объект.СостояниеЗаказа = СтароеСостояние;	
	//	Иначе	
	//		ПробитиеЧека(Чек);
	//	КонецЕсли;
	//конецесли;
	//Если Строка(Объект.СостояниеЗаказа) = "Отменён" и ПроверитьСменаОткрытаНаКассе() тогда
	//	Чек = mona_СозданиеЧеков(Объект.Ссылка);
	//	Если Чек = Неопределено Тогда 
	//		Объект.СостояниеЗаказа = СтароеСостояние;	
	//	Иначе	
	//		ПробитиеЧека(Чек);
	//	КонецЕсли;
	//конецесли;
	ЭтаФорма.ОбновитьОтображениеДанных();       
	СтароеСостояние = Объект.СостояниеЗаказа;
КонецПроцедуры

&НаСервере
Процедура mona_СостояниеЗаказаНаСервер(СтароеСостояние)
	Если СтароеСостояние = mona_СтатусыЗаказов.ВСборке() И Объект.СостояниеЗаказа <> mona_СтатусыЗаказов.Отменен() Тогда
		
		Отказ = Ложь;
		
		//ЕстьЧек = mona_ОбработкаИнтернетЗаказа.ЕстьЧекВозврат(Объект.Ссылка);
		
		//Если Объект.ОтмененныеЗапасы.Количество()>0 и не ЕстьЧек тогда 
		//	ТекстОшибки = "Нельзя изменить состояние заказа, не сформирован возрат на отмененые позиции";
		//	Отказ = Истина;
		ЧастиЗаказа = mona_ОбработкаИнтернетЗаказа.ОпределитьЧастиЗаказа(Объект);
		Собрано = ЭтаФорма["СухаяЧастьСобрана"];
		ХолодноеСобрано = ЭтаФорма["ХолоднаяЧастьСобрана"];
		ЧастичнаяСборка = ЭтаФорма["ПризнакЧастичнойСборки"];
	//	Добавил
		РешениеПринято   = ЭтаФорма["РешениеОператораПринято"];

		Если ЧастичнаяСборка И НЕ РешениеПринято Тогда
		    ТекстОшибки = "Нельзя изменить состояние заказа: зафиксирована недостача, " +
                  "требуется решение оператора по недостающим позициям.";
		    Отказ = Истина;
		КонецЕсли;
    /////////////////////////////////////////////////
		Если ЧастиЗаказа.ЕстьСухаяЧасть И НЕ Собрано Тогда
			ТекстОшибки = "Нельзя изменить состояние заказа, пока не собрана сухая часть.";
			Отказ = Истина;
		КонецЕсли;
		
		Если ЧастиЗаказа.ЕстьХолоднаяЧасть И НЕ ХолодноеСобрано Тогда
			ТекстОшибки = "Нельзя изменить состояние заказа: в заказе есть скоропортящийся товар, холодная часть не собрана.";
			Отказ = Истина;
		КонецЕсли;  
		
//		РезультатПроверки = mona_ОбработкаИнтернетЗаказа.ПроверкаВесаБезЧеков(Объект.Ссылка);
//		Если РезультатПроверки <> Неопределено Тогда
//			ТекстОшибки = СтрШаблон("Нельзя изменить состояние заказа, по номенклатуре:"+Символы .ПС+" %1"+ Символы.ПС+"вес превышает допустимое значение",РезультатПроверки.Номенклатура);
//			Отказ = Истина;
//		КонецЕсли;
		Если Отказ Тогда 
			Сообщить(ТекстОшибки);
			Объект.СостояниеЗаказа = СтароеСостояние; 		
			Элементы.ВидЗаказа.Доступность = Истина;  
			Возврат;
		КонецЕсли;    
		
	КонецЕсли;    
	Если (Объект.СостояниеЗаказа = mona_СтатусыЗаказов.Доставлен() или Объект.СостояниеЗаказа = mona_СтатусыЗаказов.Выдан()) 
		и mona_ОбработкаИнтернетЗаказа.ПроверкаКассовойСмены(Объект.КассаККМ,Объект.Организация) тогда 
		Чек = mona_ОбработкаИнтернетЗаказа.СоздатьРезультирующийЧекНаСервере(Объект.Ссылка);  
		Если Чек = Неопределено Тогда 
			Объект.СостояниеЗаказа = СтароеСостояние;
		Иначе
			ЭтаФорма["НовыйЧек"] = Чек;
		КонецЕсли;
	ИначеЕсли  Объект.СостояниеЗаказа = mona_СтатусыЗаказов.Собран() 
		и Объект.ОтмененныеЗапасы.Количество()>0 тогда  
		mona_ОбработкаИнтернетЗаказа.ФормированиеВозврата(Объект.Ссылка); 
	ИначеЕсли  Объект.СостояниеЗаказа = mona_СтатусыЗаказов.Отменен() Тогда 
		Если Не ЭтаФорма["ЗаказОтменен"]  Тогда 
			ЭтоОтменаДоОтгрузки = mona_СтатусыЗаказов.ЭтоОтменаДоОтгрузки(СтароеСостояние);
			Если  ЭтоОтменаДоОтгрузки Тогда
				ЭтаФорма["ОтменаДоОтгрузки"] = Истина;
				ЭтаФорма["ЗаказОтменен"] 	 = Истина;
				Если Не ЗначениеЗаполнено(ЭтаФорма["МоментОтмены"]) Тогда
					ЭтаФорма["МоментОтмены"] = ТекущаяДата();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
