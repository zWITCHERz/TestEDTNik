&НаКлиенте
Процедура ПризнакЧастичнойСборкиПриИзменении(Элемент)   
	СтароеЗначение = ФлагЧастичнойСборкиВРегистре(Объект.Ссылка);
    НовоеЗначение  = ЭтаФорма["ПризнакЧастичнойСборки"];

    // Нельзя снять, если в регистре уже стоит Истина
    Если СтароеЗначение = Истина И НовоеЗначение = Ложь Тогда
        ЭтаФорма["ПризнакЧастичнойСборки"] = Истина;
        Сообщить("Флаг частичной сборки нельзя снять: он фиксирует факт недостачи.");
        Возврат;
    КонецЕсли;

    // Первая установка — фиксируем дату
    Если СтароеЗначение = Ложь И НовоеЗначение = Истина Тогда
        ЭтаФорма["ВремяУстановкиЧастичнойСборки"] = ТекущаяДата();
    КонецЕсли;

    ЗаписатьЧастичнуюСборкуНаСервере(Объект.Ссылка, НовоеЗначение);	
КонецПроцедуры    

&НаСервереБезКонтекста
Функция ФлагЧастичнойСборкиВРегистре(Заказ)
    Запись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
    Запись.Заказ = Заказ;
    Запись.Прочитать();
    Если Запись.Выбран() Тогда
        Возврат Запись.ПризнакЧастичнойСборки = Истина;
    КонецЕсли;
    Возврат Ложь;
КонецФункции

