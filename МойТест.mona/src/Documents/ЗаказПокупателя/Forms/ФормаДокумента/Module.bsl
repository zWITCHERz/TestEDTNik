&НаКлиенте
Функция ПроверкаСобранности()
	//	Если РежимСборки Тогда 
	ВСборке = ВСборке();
	СухаяЧастьСобрана = Истина;
	ХолоднаяЧастьСобрана = Истина; 
	ЕстьСкоропорт = Ложь;
	Для Каждого стр из Объект.Запасы Цикл
		Если стр.Отменен =1  Тогда 
			Продолжить;
		КонецЕсли;	
		Если ЕстьРазница(стр) Тогда 
			ЕстьСкоропорт = стр.Холодный;
			Если Не ЕстьСкоропорт Тогда
				СухаяЧастьСобрана = Ложь;
			КонецЕсли;	
			Если ЕстьСкоропорт Тогда
				ХолоднаяЧастьСобрана = Ложь;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	ЭтаФорма["СухаяЧастьСобрана"] = СухаяЧастьСобрана;
	ЭтаФорма["ХолоднаяЧастьСобрана"] = ХолоднаяЧастьСобрана;
	Элементы.mona_Поле_СухаяЧастьСобрана.Доступность = ВСборке;
	Элементы.mona_Поле_ХолоднаяЧастьСобрана.Доступность = ВСборке;
	Элементы.mona_Поле_ПризнакЧастичнойСборки.Доступность = ВСборке;  
	Элементы.mona_Поле_ХолоднаяЧастьСобрана.Видимость = ЕстьСкоропорт;	
	//	КонецЕсли;
	Возврат СухаяЧастьСобрана и ХолоднаяЧастьСобрана;
КонецФункции
&НаКлиенте
Функция ЕстьРазница(СтрокаТабличнойЧасти)
	Разница = СтрокаТабличнойЧасти.Количество - СтрокаТабличнойЧасти.КоличествоСобрано;
	Возврат Разница <> 0;
	// добавить разрешенное отклонение для весового
КонецФункции

