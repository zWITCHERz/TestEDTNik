&НаСервере
Процедура mona_ЗафиксироватьРешениеОператораНаСервере()
    Если НЕ ЭтаФорма["ПризнакЧастичнойСборки"] Тогда
        Сообщить("Нет активной недостачи - решение не требуется.");
        Возврат;
    КонецЕсли;
   
	Если НЕ ДатаРешенияОператораЗаполненаВРегистре(Объект.Ссылка) Тогда       
		ЭтаФорма["РешениеОператораПринято"]  = Истина;
        ЭтаФорма["ДатаРешенияОператора"] = ТекущаяДата();
        ЗаписатьРешениеОператораВРегистр(Объект.Ссылка,
            ЭтаФорма["РешениеОператораПринято"],
            ЭтаФорма["ДатаРешенияОператора"]);
	КонецЕсли;
КонецПроцедуры   
	
&НаСервереБезКонтекста
Процедура ЗаписатьРешениеОператораВРегистр(Заказ, Решение, Дата)
    Запись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
    Запись.Заказ = Заказ;
    Запись.Прочитать();
    Если Запись.Выбран() Тогда
        Запись.РешениеОператораПринято = Решение;
        Запись.ДатаРешенияОператора    = Дата;
        Запись.Записать();
    КонецЕсли;
КонецПроцедуры   

&НаСервереБезКонтекста
Функция ДатаРешенияОператораЗаполненаВРегистре(Заказ)
    Запись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
    Запись.Заказ = Заказ;
    Запись.Прочитать();
    Если Запись.Выбран() Тогда
        Возврат ЗначениеЗаполнено(Запись.ДатаРешенияОператора);
    КонецЕсли;
    Возврат Ложь;
КонецФункции
