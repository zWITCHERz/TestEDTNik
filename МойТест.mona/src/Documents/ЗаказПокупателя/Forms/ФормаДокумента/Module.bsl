&После("ПередЗаписью")
Процедура mona_ПередЗаписью(Отказ, ПараметрыЗаписи)
	//Если РежимСборки = истина тогда 
	Если Объект.СостояниеЗаказа = mona_СтатусыЗаказов.Собран() тогда 
		Точность = 5;
		Для каждого Строка из Объект.ЗАпасы цикл 
			//и Строка.Номенклатура.Весовой = Истина	
			Если   Строка.Расхождение <> 0 тогда
				Разница = Строка.Количество - Строка.КоличествоСобрано;
				Если Разница <= 0  тогда
					Если -Разница >  Строка.Количество*(Точность/100) тогда
						Ошибка = "Вес превышает установленную точность 5% "+Строка.Номенклатура;
						Сообщить(Ошибка); 
						конецесли;
					Продолжить;
				Иначе 
					ЭтотОбъект.ПризнакЧастичнойСборки = Истина;    
									
					конецесли;
			конецесли;
		конеццикла;
				
	//конецесли;   
			РезультатПроверки = mona_ОбработкаИнтернетЗаказа.ПроверкаВесаБезЧеков(Объект.Ссылка,Отказ);
		
		конецесли;   
		
		//Добавил
	Если НЕ Отказ Тогда
        mona_ЗафиксироватьРешениеОператораНаСервере();
    КонецЕсли;
	// Вставить содержимое метода.
КонецПроцедуры

