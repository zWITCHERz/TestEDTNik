&НаСервере
Процедура mona_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	
	мШтрих = ЭтаФорма["Штрихкод"] ;
	Если НайтиДубльШтрихкода(мШтрих,Объект.Ссылка) = Неопределено и не ПустаяСтрока(мШтрих) тогда
	МенеджерЗаписи = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Штрихкод = мШтрих;
	МенеджерЗаписи.Номенклатура = Объект.Ссылка;
	МенеджерЗаписи.ЕдиницаИзмерения = Объект.Ссылка.ЕдиницаИзмерения;
	МенеджерЗаписи.Записать();
	Добавляемые = новый массив;
	Добавляемые.Добавить("Штрихкод");
	ИзменитьРеквизиты(,Добавляемые);
	конецЕсли;
    
КонецПроцедуры
