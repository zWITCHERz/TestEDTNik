&НаСервере
Процедура Mona_ДобавитьПолеФормы(ИмяРеквизита, Группа, Заголовок = "") 
	Поле = Элементы.Добавить("mona_Поле_" + ИмяРеквизита, Тип("ПолеФормы"), Группа);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ИмяРеквизита;     
	Поле.РастягиватьПоГоризонтали = Ложь;    
	Поле.Ширина = 15;
	Если ЗначениеЗаполнено(Заголовок) Тогда
		Поле.Заголовок = Заголовок;
	Иначе
		Поле.Заголовок =  Mona_РазбитьПоЗаглавным(ИмяРеквизита);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция Mona_РазбитьПоЗаглавным(Стр)
	Результат = "";
	Для Сч = 1 По СтрДлина(Стр) Цикл
		Симв = Сред(Стр, Сч, 1);
		Если Сч > 1 И Симв = ВРег(Симв) И Симв <> НРег(Симв) Тогда
			Результат = Результат + " " + НРег(Симв);
		Иначе
			Результат = Результат + Симв;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции


&НаСервере
Функция НайтиДубльШтрихкода(Штрихкод, ТекущийЭлемент) Экспорт
	
	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат Неопределено;   
	   КонецЕсли;	
	   Запрос = Новый Запрос;
	   Запрос.Текст = "ВЫБРАТЬ
	                  |	ШтрихкодыНоменклатуры.Номенклатура КАК Ссылка,
	                  |	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
	                  |ИЗ
	                  |	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	                  |ГДЕ
	                  |	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	//Запрос.УстановитьПараметр("ТекущийЭлемент", ТекущийЭлемент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	         
КонецФункции

&НаКлиенте
Процедура mona_ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.Ссылка.Пустая() тогда
	 мШтрих =ЭтаФорма["Штрихкод"] ;
	Если ПустаяСтрока(мШтрих) Тогда
		Сообщить("Внесите штрихкод товара!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	НайденнаяНоменклатура = НайтиДубльШтрихкода(мШтрих, Объект.Ссылка);
	
	Если НайденнаяНоменклатура <> Неопределено Тогда
		
		Отказ = Истина; 
		Оповещение = новый ОписаниеОповещения("ПослеОтветаНаВопрос",ЭтотОбъект,НайденнаяНоменклатура);
		ПоказатьВопрос( Оповещение,
		"Номенклатура со штрихкодом '" + мШтрих + "' уже существует. Открыть карточку?",
		РежимДиалогаВопрос.ДаНет);	
	Иначе
			
	КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Ответ,ДопПараметры) Экспорт
	ПараметрыФормы = Новый Структура("Ключ",ДопПараметры);
	Если Ответ = КодВозвратаДиалога.Да Тогда
			Форма=ПолучитьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента",ПараметрыФормы);
			Форма.Открыть();
	Иначе
			Сообщить("Создание номенклатуры с дублирующим штрихкодом запрещено!");
	КонецЕсли;
конецпроцедуры
	
