&НаСервере
Процедура mona_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка) 
		Добавляемые = новый массив;
	Добавляемые.Добавить(Новый РеквизитФормы("Штрихкод", Новый ОписаниеТипов("Строка")));
	ИзменитьРеквизиты(Добавляемые);  
	Если Объект.Ссылка.Пустая() тогда
	Группа = Элементы.Найти("ОсновныеРеквизиты");	
	Mona_ДобавитьПолеФормы("Штрихкод",Группа);
	конецесли;
КонецПроцедуры


&НаСервере
&После("ЗаполнитьАктуальныеЦены")
Процедура mona_ЗаполнитьАктуальныеЦены(Данные)
	Если РольДоступна("mona_ОператорЗаказов") тогда 
	Для Каждого Элемент Из Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ДекорацияФормы") 
			И СтрНайти(Элемент.Имя, "АктуальнаяЦенаВидЦен") > 0 Тогда
			
			ТекстЦены = Элемент.Заголовок;
			Если СтрНайти(ТекстЦены, "Учетная") > 0 Тогда
				// Получаем родительскую группу и скрываем её
				Группа = Элемент.Родитель;
				Если Группа <> Неопределено Тогда
					Группа.Видимость = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	КонецЕсли;
КонецПроцедуры 

&НаСервере
Функция Mona_ПолучитьСледующийПосле(ИмяЭлемента)                                                  
	Элем = Элементы.Найти(ИмяЭлемента);
	Если Элем = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Родитель = Элем.Родитель;
	Индекс = Родитель.ПодчиненныеЭлементы.Индекс(Элем);
	Если Индекс +1< Родитель.ПодчиненныеЭлементы.Количество() Тогда
		Возврат Родитель.ПодчиненныеЭлементы.Получить(Индекс +1);
	КонецЕсли;
	Возврат Неопределено;		
КонецФункции

