&НаСервере
Процедура УстановитьТипХраненияНаСервере()
	
	ТекущаяГруппа = Объект.Родитель;
	
	Пока ЗначениеЗаполнено(Объект.КатегорияНоменклатуры) Цикл
		Если Объект.КатегорияНоменклатуры.Наименование = "Охлажденное" ИЛИ Объект.КатегорияНоменклатуры.Родитель.Наименование = "Охлажденное" Тогда    			
			ТипХранения = "Охлажденный";
			Прервать;  		
		ИначеЕсли Объект.КатегорияНоменклатуры.Наименование = "Замороженное" ИЛИ Объект.КатегорияНоменклатуры.Родитель.Наименование = "Замороженное" Тогда
			ТипХранения = "Замороженный";
			Прервать;
		Иначе
			ТипХранения = "Обычный";   
			Прервать  ;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры   

