
Функция ШаблонСтатусовPOST(Запрос)
	
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	ЗаписьЖурналаРегистрации("Яндекс.Webhook", УровеньЖурналаРегистрации.Информация,,, ТелоЗапроса);
	
	claim_id = Неопределено;
	updated_ts = Неопределено;
	СыройСтатус = Неопределено;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЯндекса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ДанныеЯндекса.Свойство("claim_id") Тогда
			claim_id = ДанныеЯндекса.claim_id;         
		КонецЕсли;
		Если ДанныеЯндекса.Свойство("updated_ts") Тогда
			updated_ts = ДанныеЯндекса.updated_ts;
		КонецЕсли;
		Если ДанныеЯндекса.Свойство("status") Тогда
			СыройСтатус = ДанныеЯндекса.status;
		ИначеЕсли ДанныеЯндекса.Свойство("статус") Тогда
			СыройСтатус = ДанныеЯндекса["статус"];
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Яндекс.Webhook", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не удалось разобрать тело как JSON: " + ОписаниеОшибки());
	КонецПопытки;

	Если ЗначениеЗаполнено(claim_id) И ЗначениеЗаполнено(СыройСтатус) Тогда
		НовыйСтатус = РусскийСтатусВАнглийский(СыройСтатус);
		ОбработатьСтатусОтЯндекса(claim_id, НовыйСтатус);
	ИначеЕсли ЗначениеЗаполнено(claim_id) Тогда
			Попытка
			Инфо = mona_ЯндексДоставка.ИнфоЗаявкиНаДоставку(claim_id);
			Если Инфо <> Неопределено И Инфо.Свойство("status") И ЗначениеЗаполнено(Инфо.status) Тогда
				ОбработатьСтатусОтЯндекса(claim_id, Инфо.status);
			Иначе
				ЗаписьЖурналаРегистрации("Яндекс.Webhook", УровеньЖурналаРегистрации.Предупреждение,,,
					"Ни в теле, ни через claims/info не нашёлся статус для claim_id=" + claim_id);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("Яндекс.Webhook", УровеньЖурналаРегистрации.Предупреждение,,,
				"Ошибка запроса claims/info для claim_id=" + claim_id + ": " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		ЗаписьЖурналаРегистрации("Яндекс.Webhook", УровеньЖурналаРегистрации.Предупреждение,,,
			"В запросе нет claim_id.");
	КонецЕсли;
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json");
	Ответ.УстановитьТелоИзСтроки("{""status"": ""ok""}", КодировкаТекста.UTF8);
	
	Возврат Ответ;

КонецФункции

Функция РусскийСтатусВАнглийский(Статус)
	Сопоставление = Новый Соответствие;
	Сопоставление.Вставить("поиск исполнителя", "performer_lookup");
	Сопоставление.Вставить("отменено", "cancelled");
	
	Найдено = Сопоставление.Получить(НРег(СокрЛП(Статус)));
	Если Найдено <> Неопределено Тогда
		Возврат Найдено;
	КонецЕсли;
	
	Возврат Статус;
КонецФункции

Процедура ОбработатьСтатусОтЯндекса(claim_id, НовыйСтатус)
	
	Заказ = НайтиЗаказПоClaimID(claim_id);
	
	Если Заказ = Неопределено Тогда
		ЗаписьЖурналаРегистрации("Яндекс.Webhook", УровеньЖурналаРегистрации.Предупреждение,,,
			"Заказ с claim_id=" + claim_id + " не найден в ЗаказыОнлайн.");
		Возврат;
	КонецЕсли;
	
	Если ПоследнийОбработанныйСтатус(Заказ) = НовыйСтатус Тогда
		Возврат;
	КонецЕсли;
	
	Статусы = mona_ЯндексДоставка.СтатусыЯндекДоставки();
	СтруктураСтатуса = Статусы.Получить(НовыйСтатус);
	
	Если СтруктураСтатуса = Неопределено Тогда
		ЗаписьЖурналаРегистрации("Яндекс.Webhook", УровеньЖурналаРегистрации.Предупреждение,,,
			"Неизвестный статус от Яндекса: " + НовыйСтатус + " (claim_id=" + claim_id + ")");
		Возврат;
	КонецЕсли;
	
	mona_ЖурналОбмена.ЗаписатьСобытие(
		Перечисления.mona_ТипСобытийОбмена.ОбновлениеСтатусаЯндекс,
		Перечисления.mona_НаправлениеОбмена.Входящее,
		Перечисления.mona_Источник.ЯндексДоставка,
		Перечисления.mona_Источник.Система,
		Перечисления.mona_Инициатор.АвтоматическийПроцесс,
		Перечисления.mona_Статус.Успех,
		НовыйСтатус, 
		Заказ,
		1,
		0,
		"", "", claim_id);
	
	Если ЗначениеЗаполнено(СтруктураСтатуса.Статус1С) Тогда
		ПрименитьСтатусЗаказа(Заказ, СтруктураСтатуса.Статус1С);
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиЗаказПоClaimID(claim_id) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	З.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.ЗаказыОнлайн КАК З
	|ГДЕ
	|	З.claim_id = &claim_id
	|	ИЛИ З.claim_id = &claim_idОтменена";
	Запрос.УстановитьПараметр("claim_id", claim_id);
	Запрос.УстановитьПараметр("claim_idОтменена", "ОТМЕНЕНА:" + claim_id);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заказ;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПоследнийОбработанныйСтатус(Заказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ж.ТекстОшибки КАК Статус
	|ИЗ
	|	РегистрСведений.mona_ЖурналОбмена КАК Ж
	|ГДЕ
	|	Ж.ИсходныйДокумент = &Заказ
	|	И Ж.ТипСобытия = ЗНАЧЕНИЕ(Перечисление.mona_ТипСобытийОбмена.ОбновлениеСтатусаЯндекс)
	|УПОРЯДОЧИТЬ ПО
	|	Ж.Период УБЫВ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Статус;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ПрименитьСтатусЗаказа(Заказ, ТекстСтатуса)
	СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.НайтиПоНаименованию(ТекстСтатуса, Истина);
	Если СостояниеЗаказа.Пустая() Тогда
		ЗаписьЖурналаРегистрации("Яндекс.Webhook", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не найден элемент справочника СостоянияЗаказовПокупателей с наименованием """ + ТекстСтатуса + """.");
		Возврат;
	КонецЕсли;
	
	ОбъектЗаказа = Заказ.ПолучитьОбъект();
	ОбъектЗаказа.СостояниеЗаказа = СостояниеЗаказа;
	ОбъектЗаказа.Записать();
КонецПроцедуры
