&НаКлиенте
Асинх Процедура СоздатьЗаявкиЯндексДляНовыхЗаказов()
    ТекстПроблем = "";
    СозданоЗаявок = 0;
	Для Каждого Заказ из mona_ЯндексДоставкаСервер.ПолучитьЗаказыДляДоставки() Цикл
	    Результат = СтруктураРезультата();
	    ДанныеЗаказа =ДанныеЗаказа(Заказ);
		Попытка 
			ОтветСтруктура = Ждать mona_ЯндексДоставка.claims_create(ДанныеЗаказа,Результат);
		Исключение
			// Необработанное исключение (например, обрыв сети) считаем временной
			// ошибкой — тоже копим и повторяем по расписанию.
			Результат.Успех = Ложь;
			Результат.Сообщение = ОписаниеОшибки();
		КонецПопытки;        
			Если ОтветСтруктура = Неопределено Тогда 
				ТекстПроблем = ТекстПроблем + "Заказ №" + ДанныеЗаказа.Номер + ": не удалось создать заявку" + Символы.ПС;
			ИначеЕсли Результат.Успех Тогда 
				Если ОтветСтруктура.Свойство("id") Тогда
					ЗаписатьClaimIDЗаказ(Заказ, ОтветСтруктура.id);
					СозданоЗаявок = СозданоЗаявок + 1;
					Продолжить;
				ИначеЕсли Результат.Свойство("ВременнаяОшибка") И Результат.ВременнаяОшибка Тогда
				// Временная недоступность API (сеть/5xx) — копим попытку молча,
				// сообщаем оператору только когда исчерпан общий тайм-аут 4 ч,
				// а не на каждый промежуточный сбой.
				ИначеЕсли Результат.Свойство("Причина") Тогда
				// Постоянная (бизнес-) причина — повторять бессмысленно,
				// сообщаем оператору сразу же, без ожидания тайм-аута, и в журнал
				// не пишем как "ОшибкаОбменаСЯндекс" (это не про недоступность API).
					ТекстПроблем = ТекстПроблем + "Заказ №" + ДанныеЗаказа.Номер + ": " + Результат.Причина + Символы.ПС;
				КонецЕсли;
				Результат.Успех = Ложь;
		        Результат.Сообщение =  ТекстПроблем;
			Иначе
				
			КонецЕсли;
		ЗафиксироватьВМонитор(Заказ,Результат.Сообщение);
		mona_ЯндексДоставкаСервер.ЗафиксироватьОшибкуОтправки(Заказ, Результат);

		
	КонецЦикла;
	
	// Одно оповещение на весь цикл вместо Сообщить() на каждый заказ.
	Если СозданоЗаявок > 0 ИЛИ ЗначениеЗаполнено(ТекстПроблем) Тогда
		ТекстИтог = "";
		Если СозданоЗаявок > 0 Тогда
			ТекстИтог = "Создано заявок Яндекс.Доставки: " + СозданоЗаявок + Символы.ПС;
		КонецЕсли;
		ТекстИтог = ТекстИтог + ТекстПроблем;
		
		Если ЗначениеЗаполнено(ТекстПроблем) Тогда
			ПоказатьОповещениеПользователя("Яндекс.Доставка", , ТекстИтог, БиблиотекаКартинок.Предупреждение);
		Иначе
			ПоказатьОповещениеПользователя("Яндекс.Доставка", , ТекстИтог, БиблиотекаКартинок.Информация);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Опрос статусов раз в 5 секунд (см. ПодключитьОбработчикОжидания в
// ПриОткрытии) — простым циклом по заказам с активной заявкой, без курсора
// и без новой константы: по каждому claim_id дёргаем claims/info (та же
// функция, что уже используется при ручном обновлении статуса/отмене).
// Логика целиком внутри этой формы, без обращения к mona_ЯндексДоставкаСервер —
// чтобы не зависеть от того, почему конкретно эти методы там не резолвятся.
&НаСервереБезКонтекста
Функция  ПолучитьЗаказыСАктивнойЗаявкой()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	claim_id
	|ИЗ
	|	РегистрСведений.ЗаказыОнлайн
	|ГДЕ
	|	claim_id <> """"
	|	И ПОДСТРОКА(claim_id, 1, 1) <> ""x""";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("claim_id");
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьСтатусЗаявки(claim_id, НовыйСтатус)
    НечегоЗаписывать = Истина;
	Выборка = РегистрыСведений.ЗаказыОнлайн.Выбрать(Новый Структура("claim_id", СокрЛП(claim_id)));
	Если Выборка.Следующий() Тогда 
		Если НовыйСтатус = "cancelled" Тогда 
			Запись = Выборка.ПолучитьМенеджерЗаписи();
			Запись.Yandex_status = "cancelled";
			Запись.claim_id = "x" + claim_id;   
			Запись.Записать();
		ИначеЕсли Выборка.Yandex_status <> НовыйСтатус Тогда 	
			Запись = Выборка.ПолучитьМенеджерЗаписи();
			Запись.Yandex_status = НовыйСтатус;
			Запись.Записать();
		Иначе
			Возврат;
		КонецЕсли;
 	КонецЕсли;


	
	mona_ЖурналОбмена.ЗаписатьСобытие(
		Перечисления.mona_ТипСобытийОбмена.ОбновлениеСтатусаЯндекс,
		Перечисления.mona_НаправлениеОбмена.Входящее,
		Перечисления.mona_Источник.ЯндексДоставка,
		Перечисления.mona_Источник.Система,
		Перечисления.mona_Инициатор.АвтоматическийПроцесс,
		Перечисления.mona_Статус.Успех,
		НовыйСтатус,
		Выборка.Заказ,
		1,
		0,
		"", "", claim_id);
	
	// Актуальный статус — сразу в сам регистр ЗаказыОнлайн (реквизит
	// Yandex_status), чтобы не поднимать mona_ЖурналОбмена каждый раз, когда
	// просто нужно посмотреть текущий статус заказа.
	Запись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
	Запись.Заказ = Выборка.Заказ;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Запись.Yandex_status = НовыйСтатус;
		Если НовыйСтатус = "cancelled" Тогда 	
			Запись.claim_id = "x" + claim_id;
		КонецЕсли;
		Запись.Записать();
	КонецЕсли;
	
	// Переключаем статус самого заказа, если для этого статуса Яндекса есть
	// однозначное соответствие — иначе (заявка ещё в пути/ищет курьера и т.п.)
	// заказ не трогаем, только пишем в журнал выше.
	СостояниеЗаказаПоСтатусуЯндекса(Выборка.Заказ,НовыйСтатус);
КонецПроцедуры

// Соответствие статусов Яндекс.Доставки → статус заказа 1С (mona_СтатусыЗаказов).
// ПРОВЕРИТЬ семантику "Доставлен" vs "Выдан" — если "Выдан" на самом деле
// означает "вручено покупателю" (а не "передано курьеру"), поправить тут. ?? к чему это тут - это про самовывоз
// Остальные статусы Яндекса (поиск курьера, в пути и т.п.) сознательно не
// сопоставлены ни с чем — под них нет однозначного статуса заказа в списке  а Отружен и ВПути реальные тригеры
// mona_СтатусыЗаказов (Отменен/Собран/ВСборке/Оплачен/Доставлен/Выдан).
&НаСервереБезКонтекста
Процедура СостояниеЗаказаПоСтатусуЯндекса(Заказ,СтатусЯндекса)
	//Если СтатусЯндекса = "delivered" ИЛИ СтатусЯндекса = "delivered_finish" Тогда
	//	Возврат mona_СтатусыЗаказов.Доставлен();
	//ИначеЕсли СтатусЯндекса = "cancelled" ИЛИ СтатусЯндекса = "cancelled_with_payment"
	//	ИЛИ СтатусЯндекса = "cancelled_by_taxi" ИЛИ СтатусЯндекса = "cancelled_with_items_on_hands"
	//	ИЛИ СтатусЯндекса = "failed" Тогда
	//	Возврат mona_СтатусыЗаказов.Отменен();
	//КонецЕсли;
	//Возврат Неопределено; 
	// пока убрал - отмена доставки точно не отменяет сам заказ;
	
	
	Статусы = mona_СтатусыЗаказов.СтатусыЯндекДоставки();
    НовоеСостояние = Статусы[СтатусЯндекса].Статус1С; 
	Если Заказ = Неопределено и НовоеСостояние = Неопределено или НовоеСостояние = "" Тогда
		Возврат
	КонецЕсли;
	УстановитьСтатус(Заказ, НовоеСостояние);
                    
КонецПроцедуры



&НаКлиенте
Асинх Процедура ОпроситьЖурналИзмененийЗаявок(ЗаказыСАктивнойЗаявкой)
	
	Для Каждого claim_id Из ЗаказыСАктивнойЗаявкой Цикл
		Попытка
			Инфо = Ждать mona_ЯндексДоставка.ИнфоЗаявкиНаДоставку(claim_id);
			Если Инфо <> Неопределено И Инфо.Свойство("status") И ЗначениеЗаполнено(Инфо.status) Тогда
				ЗаписатьСтатусЗаявки(claim_id, Инфо.status);
			КонецЕсли;
		Исключение
			// сеть/API — пропускаем этот заказ, попробуем на следующем тике
		КонецПопытки;
	КонецЦикла;
	ОбновлениеЯндексДоставкиВПроцессе = Ложь;
КонецПроцедуры

&НаКлиенте
Функция ЕстьПревышениеЛимитовЗаказа(Заказ) Экспорт
	// Дёргает только расчёт (items/вес/габариты), без сетевых обращений к
	// Яндексу — безопасно вызывать на каждую активизацию строки списка.
	ДанныеЗаказа = ДанныеЗаказа(Заказ);
	Если ДанныеЗаказа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Тариф = "same_day";
	Если ДанныеЗаказа.Свойство("Тариф") И ЗначениеЗаполнено(ДанныеЗаказа.Тариф) Тогда
		Тариф = ДанныеЗаказа.Тариф;
	КонецЕсли;
	
	Превышения = mona_ЯндексДоставка.ПревышенияЗаказа(ДанныеЗаказа, Тариф);
	Возврат Превышения.Количество() > 0;
КонецФункции

&НаКлиенте
Асинх Процедура ОформитьГрузовуюДоставку(Команда)
	ОчиститьСообщения();
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Заказ) Тогда
		Возврат;
	КонецЕсли;
	
	ClaimID = ПолучитьClaimЗаказа(ТекДанные.Заказ);
	Если ЗначениеЗаполнено(ClaimID) Тогда
		Сообщить("У заказа уже есть заявка Яндекс.Доставки (" + ClaimID + "). Сначала отмените её, если нужно пересоздать тарифом «Грузовой».");
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьПревышениеЛимитовЗаказа(ТекДанные.Заказ) Тогда
		// Кнопка и так должна быть неактивна в этом случае (см.
		// СписокПриАктивизацииСтроки), но проверяем ещё раз на случай устаревшего
		// состояния формы — тариф "Грузовой" только для заказов, которые
		// действительно не влезают в обычные лимиты.
		Сообщить("У этого заказа нет превышения лимитов — тариф «Грузовой» не требуется.");
		Возврат;
	КонецЕсли;
	
	ДанныеЗаказа = ДанныеЗаказа(ТекДанные.Заказ);
	Если ДанныеЗаказа = Неопределено Тогда          // тут бы где-то проверить статус
		Сообщить("Не удалось получить данные заказа.");
		Возврат;
	КонецЕсли;
	ДанныеЗаказа.Тариф = "cargo"; // принудительно, независимо от автоопределения same_day/express
	
	Результат = СтруктураРезультата();
	Попытка
		ОтветСтруктура = Ждать mona_ЯндексДоставка.claims_create(ДанныеЗаказа, Результат);
		Если ОтветСтруктура <> Неопределено И ОтветСтруктура.Свойство("id") Тогда
			ЗаписатьClaimIDЗаказ(ТекДанные.Заказ, ОтветСтруктура.id);
			Элементы.Список.Обновить();
			ПоказатьОповещениеПользователя("Заявка (тариф «Грузовой») создана: " + ОтветСтруктура.id);
		ИначеЕсли Результат.Свойство("Причина") И ЗначениеЗаполнено(Результат.Причина) Тогда
			ПоказатьОповещениеПользователя("Яндекс.Доставка", , "Заказ №" + ДанныеЗаказа.Номер + ": " + Результат.Причина, БиблиотекаКартинок.Предупреждение);
		Иначе
			ПоказатьОповещениеПользователя("Яндекс.Доставка", , "Заказ №" + ДанныеЗаказа.Номер + ": " + Результат.Сообщение, БиблиотекаКартинок.Предупреждение);
		КонецЕсли;
	Исключение
		ПоказатьОповещениеПользователя("Яндекс.Доставка", , "Заказ №" + ДанныеЗаказа.Номер + ": " + ОписаниеОшибки(), БиблиотекаКартинок.Предупреждение);
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
функция ПолучитьClaimЗаказа(Заказ) Экспорт
	Запись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
	Запись.Заказ = Заказ;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Значение = СокрЛП(Запись.claim_id);
		// Заявка отменена ранее (см. ЗаписатьОтмененныйClaimIDЗаказ) —
		// для интерфейса это равносильно отсутствию активной заявки.
		Если НЕ СтрНачинаетсяС(Значение, "x") Тогда
			Возврат Значение; 
		КонецЕсли;
	КонецЕсли;                 
	Возврат "";
КонецФункции

&НаКлиенте
Асинх Процедура mona_ОбновитьСтатусЗаявкиЯндекс(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Заказ) Тогда
		Возврат;
	КонецЕсли;
	
	ClaimID = ПолучитьClaimЗаказа(ТекДанные.Заказ);
	Если Не ЗначениеЗаполнено(ClaimID) Тогда
		Сообщить("У заказа нет заявки Яндекс.Доставки.");
		Возврат;
	КонецЕсли;
	
	Попытка
		info =  ждать mona_ЯндексДоставка.claims("info", ТекДанные.claim_id);
		Статусы = mona_ЯндексДоставка.СтатусыЯндекДоставки();
		НазваниеСтатуса = ?(Статусы[info.status] <> Неопределено, Статусы[info.status].Название, info.status);
		
		ПоказатьОповещениеПользователя("Статус заявки " + ClaimID + ": " + НазваниеСтатуса);
	Исключение
		Сообщить("Ошибка получения статуса: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры



