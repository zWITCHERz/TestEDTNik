&НаКлиенте
Процедура ПриОткрытии(Отказ)  
	Авторизован = Ложь;        
	
	ПоказанныеКрасные   = Новый Соответствие;
	ПоказанныеЖёлтые    = Новый Соответствие;
	ПоказанныеЧастичные = Новый Соответствие;  
	ПоказанныеSLA       = Новый Соответствие;
	СтруктураОбновления = ОбновитьСписокНаСервере(КонтрольныеСтатусыЗаказов,Самовывоз,СостояниеОтменен);
	УстановитьСортировку();   
	УстановитьПересчетВремениПрибытияКурьера(СтруктураОбновления.СмещениеПрибытия);
	НастроитьПодсветку(СтруктураОбновления.ГраницыСухая,СтруктураОбновления.ГраницыХолодная);
	Элементы.Список.Обновить();
	
	Текст =   "";
	Текст = Текст + ТекстНовыхКрасных(СтруктураОбновления.КрасныеЗаказы);
	Текст = Текст + ТекстНовыхЖёлтых(СтруктураОбновления.ЖёлтыеЗаказы);
	Текст = Текст + ТекстНовыхЧастичных(СтруктураОбновления.ЧастичныеЗаказы); 
	Если ЗначениеЗаполнено(Текст) Тогда
		ПоказатьПредупреждение(,Текст, ,"Внимание, заказы требуют действий.");
	КонецЕсли;
	ЗафиксироватьВМониторе(СтруктураОбновления);	
	СоответствиеПользователяИПароля = ПараметрыПриложения["1СWebKassa.СоответствиеПользователяИПароля"];
	Если ТипЗнч(СоответствиеПользователяИПароля) = Тип("ФиксированноеСоответствие") Тогда
		ЛогинПарольТокен = СоответствиеПользователяИПароля.Получить(Организация);
	КонецЕсли;	
	Если ЛогинПарольТокен = Неопределено Тогда  
		Login = "webkassa@naturalia.kz";
		Password ="Webkassa2026@@";     
		
		WebКассаАвторизована = Ложь;
		Элементы.Login.Видимость = Истина;
		Элементы.Password.Видимость = Истина; 
		Элементы.Авторизация.Видимость = Истина;
	Иначе	
		Элементы.Login.Видимость = Ложь;
		Элементы.Password.Видимость = Ложь; 
		Элементы.Авторизация.Видимость = Ложь;
		
		WebКассаАвторизована = Истина;
		Элементы.ГруппаWebКассаАвторизация.ЦветТекстаЗаголовка = Новый Цвет(0, 150, 0);
		
		
	КонецЕсли;	
   	ВключенОтбор2 = mona_ПереключитьОтборЧастичнойСборки();
	ВключенОтбор1 = mona_ПереключитьОтборОплаченВСборке();
	ПодключитьОбработчикОжидания("ОбновитьСписок", 10);	
//	ПодключитьОбработчикОжидания("ОпроситьЖурналИзмененийЗаявок", 5);	
	
КонецПроцедуры

&НаКлиенте
Процедура Авторизация(Команда)
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Login",    Login);
	ПараметрыЗапроса.Вставить("Password", Password);
	ЗапросJSON = ИнтеграцияWebKassaКлиент.НовыйЗапросJSON(ПараметрыЗапроса);
	АдресСервиса = ИнтеграцияWebKassaВызовСервера.АдресСервиса(Организация);
	РезультатЗапроса = ИнтеграцияWebKassaКлиент.ОтправитьЗапросНаСервисWebkassa(АдресСервиса,"/api/v2/Authorize", ЗапросJSON);	
	Если РезультатЗапроса = Неопределено Тогда
		РезультатВыполнения = Ложь;
	Иначе
		Попытка
			ОбъектыJSON = ИнтеграцияWebKassaКлиент.ПрочитатьОтветJSON(РезультатЗапроса);
			Для Каждого ОбъектJSON Из ОбъектыJSON Цикл
				Если ОбъектJSON.Ключ = "Data" И Не ТипЗнч(ОбъектJSON.Значение) = Тип("Булево") И ОбъектJSON.Значение <> Неопределено И
					Тип(ОбъектJSON.Значение) = Тип("Структура") И ОбъектJSON.Значение.Свойство("Token") Тогда
					ТокенАвторизации = ОбъектJSON.Значение.Token;
					СохраняемоеЗначение = Новый Структура("Пользователь,ПарольПользователя,Токен", Login, Password,ТокенАвторизации);
					ДобавитьПарольВГлобальнуюПеременную(Организация, СохраняемоеЗначение);  
					Элементы.Login.Видимость = Ложь ;
					Элементы.Password.Видимость = Ложь; 
					Элементы.Авторизация.Видимость = Ложь;      
					
					WebКассаАвторизована = Истина;
					Элементы.ГруппаWebКассаАвторизация.ЦветТекстаЗаголовка = Новый Цвет(0, 150, 0);
					Элементы.ФормаСменитьВидЗаказа.Доступность = Истина;   
					Элементы.ФормаСменитьВидЗаказа.Видимость = Истина;
					Элементы.СписокПереключитьСтатус.Доступность = Истина;   
					Элементы.СписокПереключитьСтатус.Видимость = Истина;
					Элементы.ФормаПереключитьСмена.Доступность = Истина; 
					Элементы.ФормаПереключитьСмена.Видимость = Истина; 	
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;	
	КонецЕсли;	
КонецПроцедуры    

&НаКлиенте
Процедура ДобавитьПарольВГлобальнуюПеременную(СохраняемыйКлюч, СохраняемоеЗначение)
	//СохраняемоеЗначение-структура СохраняемыйКлюч-идентификатор
	Соответствие = Новый Соответствие;
	СоответствиеПользователяИПароля = ПараметрыПриложения["1СWebKassa.СоответствиеПользователяИПароля"];
	Если ТипЗнч(СоответствиеПользователяИПароля) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого Элемент Из СоответствиеПользователяИПароля Цикл
			Соответствие.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Соответствие.Вставить(СохраняемыйКлюч, СохраняемоеЗначение);
	
	ПараметрыПриложения.Вставить("1СWebKassa.СоответствиеПользователяИПароля",
		Новый ФиксированноеСоответствие(Соответствие));
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Самовывоз = mona_ОбработкаИнтернетЗаказа.ВидЗаказаПВЗ();	
	ПользовательЯвляетсяАдминистратором = ПользовательЯвляетсяАдминистратором(); 
	ОбновлениеЯндексДоставкиВПроцессе = Ложь;
	ОбычноеСоответствие = mona_СтатусыЗаказов.ПроверкаСтатусов();
	СостоянияЗаказов = Новый ФиксированноеСоответствие(ОбычноеСоответствие); 
	//
	//КонтрольныеСтатусыЗаказов = Новый ФиксированныйМассив(mona_ДедлайныЗаказов.КонтрольныеСтатусыЗаказов()); 
	
	СостояниеОтменен 	= mona_СтатусыЗаказов.Отменен();
	СостояниеСобран  	= mona_СтатусыЗаказов.Собран();
	СостояниеВСборке 	= mona_СтатусыЗаказов.ВСборке();
	СостояниеОплачен 	= mona_СтатусыЗаказов.Оплачен();  
	СостояниеДоставлен 	= mona_СтатусыЗаказов.Доставлен();  
	СостояниеВыдан 		= mona_СтатусыЗаказов.Выдан();  
	ПрочееПредупреждение = Перечисления.mona_ВидыПредупреждений.Другое;	
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить(СостояниеОплачен);
	СписокСтатусов.Добавить(СостояниеВСборке);
	
	КонтрольныеСтатусыЗаказов = СписокСтатусов;    	
	
	ИдетПечатьЧека = Ложь;
	КассаККМ = Справочники.КассыККМ.НайтиПоНаименованию("Касса Интернет-заказы (Naturalia)",Истина);
	Организация = КассаККМ.Владелец;
	ПроверкаКассовойСмены();  
КонецПроцедуры               

&НаСервере
Процедура ПроверкаКассовойСмены()
	//|	КассоваяСмена.Ссылка КАК КассоваяСмена,
	//|	КассоваяСмена.ФискальноеУстройство КАК ФискальноеУстройство,
	//|	КассоваяСмена.НачалоКассовойСмены КАК НачалоКассовойСмены,
	//|	КассоваяСмена.ОкончаниеКассовойСмены КАК ОкончаниеКассовойСмены,
	//|	ДОБАВИТЬКДАТЕ(КассоваяСмена.НачалоКассовойСмены, ДЕНЬ, 1) КАК ДатаИстеченияСрокаДействия,
	//|	КассоваяСмена.Статус КАК Статус
	СтруктураСмены = Новый Структура("НачалоКассовойСмены,ОкончаниеКассовойСмены");
	СменаОткрыта = mona_ОбработкаИнтернетЗаказа.ПроверкаКассовойСмены(КассаККМ,Организация,СтруктураСмены);
	
	Если СменаОткрыта Тогда
		Элементы.ФормаПереключитьСмена.Заголовок = "Закрыть смену";  
		Элементы.ОтображениеСмены.Заголовок    = "● Смена открыта "+ СтруктураСмены.НачалоКассовойСмены; 
		Элементы.ФормаПереключитьСмена.Картинка = БиблиотекаКартинок.ЗакрытыйКлюч;           //ЗакрытьСмену
		Элементы.ОтображениеСмены.ЦветТекста  = Новый Цвет(0, 150, 0); // зелёный
	Иначе
		Элементы.ФормаПереключитьСмена.Заголовок = "Открыть смену";  
		Элементы.ОтображениеСмены.Заголовок = "● Смена закрыта " + СтруктураСмены.ОкончаниеКассовойСмены;;    
		Элементы.ФормаПереключитьСмена.Картинка = БиблиотекаКартинок.СформироватьОтчет;
		Элементы.ОтображениеСмены.ЦветТекста   = Новый Цвет(180, 0, 0); // красный
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура УстановитьПересчетВремениПрибытияКурьера(СмещениеПрибытия)
	Список.Параметры.УстановитьЗначениеПараметра("СмещениеПрибытия",СмещениеПрибытия); 
	Список.Параметры.УстановитьЗначениеПараметра("Самовывоз",Самовывоз); 
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПользовательЯвляетсяАдминистратором()
	Возврат РольДоступна("АдминистраторСистемы");
КонецФункции

&НаКлиенте
Процедура ОбновитьСписок()               
	ВремяНачала = ТекущаяДата();
	СтруктураОбновления = ОбновитьСписокНаСервере(КонтрольныеСтатусыЗаказов,Самовывоз,СостояниеОтменен);
	УстановитьПересчетВремениПрибытияКурьера(СтруктураОбновления.СмещениеПрибытия);
	НастроитьПодсветку(СтруктураОбновления.ГраницыСухая,СтруктураОбновления.ГраницыХолодная);
	
	Элементы.Список.Обновить();           
	
	Текст =   "";
	Текст = Текст + ТекстНовыхКрасных(СтруктураОбновления.КрасныеЗаказы);
	Текст = Текст + ТекстНовыхЖёлтых(СтруктураОбновления.ЖёлтыеЗаказы);
	Текст = Текст + ТекстНовыхЧастичных(СтруктураОбновления.ЧастичныеЗаказы); 
	Если ЗначениеЗаполнено(Текст) Тогда
		ПоказатьПредупреждение(,Текст, ,"Внимание, заказы требуют действий.");
	КонецЕсли;                            
	
	Если ПользовательЯвляетсяАдминистратором Тогда
		ТекстSLA = ТекстНовыхSLA(СтруктураОбновления.НарушившиеSLA);
		Если ЗначениеЗаполнено(ТекстSLA) Тогда
			ПоказатьПредупреждение(, ТекстSLA, ,"Превышен SLA частичной сборки!");
		КонецЕсли;   
	КонецЕсли; 
	Если СтруктураОбновления.ЗаказыСАктивнойЗаявкой.Количество() > 0 И НЕ ОбновлениеЯндексДоставкиВПроцессе Тогда
        ОбновлениеЯндексДоставкиВПроцессе = Истина;
        ОпроситьЖурналИзмененийЗаявок(СтруктураОбновления.ЗаказыСАктивнойЗаявкой);
    КонецЕсли;
	
	ЗафиксироватьВМониторе(СтруктураОбновления);	
	Если Не Элементы.Login.Видимость и СменаОткрыта и СтруктураОбновления.КФискализации.Количество() > 0 Тогда 
		ПробитьЧеки(СтруктураОбновления.КФискализации);
	КонецЕсли; 
	Продолжительность = ТекущаяДата()-ВремяНачала;
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ОбновитьСписокНаСервере(Статусы,Самовывоз,СостояниеОтменен) 
	СинхронизироватьОтмененные(СостояниеОтменен);
	//НастроитьПодсветкуНаСервере(); 
	Сейчас = ТекущаяДата();
	ГраницыСухая = mona_ДедлайныЗаказов.ГраницыДедлайнаСухая(Сейчас);
	ГраницыХолодная = mona_ДедлайныЗаказов.ГраницыДедлайнаХолодная(Сейчас);
	СтруктураОбновления = новый Структура("ГраницыСухая,ГраницыХолодная,КФискализации,СмещениеПрибытия,КрасныеЗаказы,ЖёлтыеЗаказы,ЧастичныеЗаказы",
	ГраницыСухая,ГраницыХолодная);
	СтруктураОбновления.КФискализации =  ПолучитьКФискализации(); 
	СтруктураОбновления.СмещениеПрибытия = mona_ДедлайныЗаказов.ПересчетВремениПрибытияКурьера();
	СтруктураОбновления.КрасныеЗаказы = ПолучитьКрасныеЗаказы(ГраницыСухая,ГраницыХолодная,Статусы);
	СтруктураОбновления.ЖёлтыеЗаказы = ПолучитьЖёлтыеЗаказы(ГраницыХолодная,Статусы,Самовывоз);
	СтруктураОбновления.ЧастичныеЗаказы = ПолучитьЧастичныеЗаказы();
    СтруктураОбновления.Вставить("НарушившиеSLA",ПолучитьНарушившиеSLA());  
	СтруктураОбновления.Вставить("ЗаказыСАктивнойЗаявкой",ПолучитьЗаказыСАктивнойЗаявкой());
	Возврат СтруктураОбновления;	
КонецФункции

#КонецОбласти

#Область МониторингДедлайнов  
&НаКлиенте
Функция ТекстНовыхКрасных(Заказы)
	//Заказы = ПолучитьКрасныеЗаказы();
	Новые = Новый Соответствие;
	Текст = "";
	Для Каждого Стр Из Заказы Цикл
		Ключ = Строка(Стр.Заказ.УникальныйИдентификатор()) + " | " + Стр.ЧтоПросрочено;
		Если ПоказанныеКрасные[Ключ] = Неопределено Тогда
			Текст = Текст + "Просрочен дедлайн: " + Стр.Представление + " - " + Стр.ЧтоПросрочено + Символы.ПС;
		КонецЕсли;
		Новые.Вставить(Ключ, Истина);
	КонецЦикла;
	ПоказанныеКрасные = Новые;
	Возврат Текст;
КонецФункции

&НаКлиенте
Функция ТекстНовыхЖёлтых(Заказы)
	//Заказы = ПолучитьЖёлтыеЗаказы();
	Новые = Новый Соответствие;
	Текст = "";
	Для Каждого Стр Из Заказы Цикл
		Ключ = Строка(Стр.Заказ.УникальныйИдентификатор());
		Если ПоказанныеЖёлтые[Ключ] = Неопределено Тогда
			Текст = Текст + "Скоро паковать холодное: " + Стр.Представление + Символы.ПС;
		КонецЕсли;
		Новые.Вставить(Ключ, Истина);
	КонецЦикла;
	ПоказанныеЖёлтые = Новые;
	Возврат Текст;
КонецФункции

&НаКлиенте
Функция ТекстНовыхЧастичных(Заказы)
	//Заказы = ПолучитьЧастичныеЗаказы();
	Новые = Новый Соответствие;
	Текст = "";
	Для Каждого Стр Из Заказы Цикл
		Ключ = Строка(Стр.Заказ.УникальныйИдентификатор());
		Если ПоказанныеЧастичные[Ключ] = Неопределено Тогда
