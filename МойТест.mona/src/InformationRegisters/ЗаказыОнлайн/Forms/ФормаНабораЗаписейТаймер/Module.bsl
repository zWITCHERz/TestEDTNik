Функция ПолучитьНарушившиеSLA()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| З.Заказ КАК Заказ,
	| ПРЕДСТАВЛЕНИЕ(З.Заказ) КАК Представление,
	| З.ВремяУстановкиЧастичнойСборки КАК ВремяУстановки
	|ИЗ
	| РегистрСведений.ЗаказыОнлайн КАК З
	|ГДЕ
	| З.ПризнакЧастичнойСборки = ИСТИНА
	| И З.Заказ.СостояниеЗаказа = &СтатусВСборке
	| И З.ВремяУстановкиЧастичнойСборки > ДАТАВРЕМЯ(1,1,1)";
	
	Запрос.УстановитьПараметр("СтатусВСборке",Справочники.СостоянияЗаказовПокупателей.НайтиПоНаименованию("В сборке"));
	Сейчас = ТекущаяДата();
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РабСек = mona_ДедлайныЗаказов.РабочихСекундМежду(Выборка.ВремяУстановки, Сейчас);
		Порог = mona_ДедлайныЗаказов.ПорогSLA();
		Если mona_ДедлайныЗаказов.ПревышенSLAЧастичнойСборки(Выборка.ВремяУстановки, Сейчас) Тогда
			Стр = Новый Структура;
			Стр.Вставить("Заказ", Выборка.Заказ);
			Стр.Вставить("Представление", Выборка.Представление);
			Стр.Вставить("ВидПредупреждения", Перечисления.mona_ВидыПредупреждений.SLA);
			Результат.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции           

