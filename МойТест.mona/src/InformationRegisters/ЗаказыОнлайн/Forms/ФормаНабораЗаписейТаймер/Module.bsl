Функция ПолучитьЖёлтыеЗаказы(ГраницыХолодная,Статусы,Самовывоз)
//	Границы = mona_ДедлайныЗаказов.ГраницыДедлайнаХолодная(Сейчас);
	
	ДостМин = ГраницыХолодная.ГраницаКраснаяДоставка;
	ДостМакс = ГраницыХолодная.ГраницаЖелтаяДоставка;
	СВМин = ГраницыХолодная.ГраницаКраснаяСамовывоз;
	СВМакс = ГраницыХолодная.ГраницаЖелтаяСамовывоз;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| З.Заказ КАК Заказ,
	| ПРЕДСТАВЛЕНИЕ(З.Заказ) КАК Представление,
	| З.НачалоВременногоИнтервалаДоставки КАК Слот,
	| З.ХолоднаяЧастьСобрана КАК ХолоднаяЧастьСобрана,
	| З.Заказ.ВидЗаказа КАК ВидЗаказа,
	| З.ЕстьСкоропорт КАК ЕстьСкоропорт
	|ИЗ
	| РегистрСведений.ЗаказыОнлайн КАК З
	|ГДЕ
	| З.НачалоВременногоИнтервалаДоставки > ДАТАВРЕМЯ(1, 1, 1)
	| И З.Заказ.СостояниеЗаказа В (&Статусы)
	| И З.ХолоднаяЧастьСобрана <> ИСТИНА
	| И З.ЕстьСкоропорт = ИСТИНА";
	
	Запрос.УстановитьПараметр("Статусы", Статусы);
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ВидЗаказа = Самовывоз Тогда
			ПопадаетВЖёлтую = (Выборка.Слот > СВМин И Выборка.Слот <= СВМакс);
		Иначе
			ПопадаетВЖёлтую = (Выборка.Слот > ДостМин И Выборка.Слот <= ДостМакс);
		КонецЕсли;
		
		Если Не ПопадаетВЖёлтую Тогда
			Продолжить;
		КонецЕсли;
		
		Стр = Новый Структура;
		Стр.Вставить("Заказ", Выборка.Заказ);
		Стр.Вставить("Представление", Выборка.Представление);
		Стр.Вставить("ВидПредупреждения", Перечисления.mona_ВидыПредупреждений.ЖелтыйДедлайн);
		Результат.Добавить(Стр);
	КонецЦикла;
	Возврат Результат;
КонецФункции  

