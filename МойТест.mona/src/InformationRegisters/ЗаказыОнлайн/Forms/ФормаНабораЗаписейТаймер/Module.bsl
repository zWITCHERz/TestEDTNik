&НаКлиенте
Функция ЗафиксироватьВМониторе(СтруктураОбновления)
	Для Каждого стр из СтруктураОбновления.КрасныеЗаказы Цикл
		ЗафиксироватьВМонитор(стр,
			"Просрочен дедлайн: " + Стр.Представление + " - " + Стр.ЧтоПросрочено);
	КонецЦикла;	
	Для Каждого стр из СтруктураОбновления.ЖёлтыеЗаказы Цикл
		ЗафиксироватьВМонитор(стр,
			"Скоро паковать холодное: " + Стр.Представление );
	КонецЦикла;	
	Для Каждого стр из СтруктураОбновления.ЧастичныеЗаказы Цикл
		ЗафиксироватьВМонитор(стр,
			"Частичная сборка: " + Стр.Представление );
	КонецЦикла;	
	Для Каждого стр из СтруктураОбновления.НарушившиеSLA Цикл
		ЗафиксироватьВМонитор(стр,
			"Превышен SLA частичной сборки " + Стр.Представление);
	КонецЦикла;	
КонецФункции

&НаКлиенте
Процедура ЗафиксироватьВМонитор(обн,Сообщение)
	Если ПустаяСтрока(Сообщение) Тогда 
		Возврат;
	КонецЕсли;	
	
	Найдено = СообщенияМонитора.НайтиСтроки(Новый Структура("Заказ",обн.Заказ));
        Если Найдено.Количество() = 0 Тогда 
			НовоеВМонитор(обн,Сообщение);
		Иначе
			
			Для Каждого стр из Найдено Цикл 
				Если стр.ВидПредупреждения = ?(обн.Свойство("ВидПредупреждения"),обн.ВидПредупреждения,Неопределено) Тогда 
					Продолжить;
				КонецЕсли;
				Если стр.Сообщение = Сообщение Тогда 
					Продолжить;
				КонецЕсли;
				НовоеВМонитор(обн,Сообщение);
				Прервать;
			КонецЦикла;	
		КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НовоеВМонитор(обн,Сообщение)
			НовСтр = СообщенияМонитора.Вставить(0);
			НовСтр.Заказ = обн.Заказ;
			Если обн.Свойство("ВидПредупреждения") Тогда 
				НовСтр.ВидПредупреждения = обн.ВидПредупреждения; 
			Иначе 
				НовСтр.ВидПредупреждения = ПрочееПредупреждение;
			КонецЕсли;
			
			НовСтр.Сообщение = Сообщение;
			НовСтр.ВремяФиксации = ТекущаяДата();
КонецПроцедуры
