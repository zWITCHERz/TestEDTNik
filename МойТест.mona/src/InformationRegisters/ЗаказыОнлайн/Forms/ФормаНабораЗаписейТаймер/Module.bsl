&НаКлиенте
Процедура СменитьВидЗаказа(Команда)
	ОчиститьСообщения();
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Заказ) Тогда
		Сообщить ("Выберите заказ в списке.");
		Возврат;
	КонецЕсли;
	
	Если СменаВидаЗаблокирована(ТекДанные) Тогда
		Сообщить("Нельзя сменить вид заказа: статус """+ТекДанные.СостояниеЗаказа+""" не позволяет менять вид доставки.");
		Возврат;
	КонецЕсли;
	Результат = СтруктураРезультата();
	mona_СменитьВидЗаказаНаСервере(ТекДанные.Заказ,Результат);
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("Вид заказа " + ТекДанные.Заказ + " изменен на """ + Результат.ИмяВида + """");
		Элементы.Список.Обновить();
		ОбработатьИзменениеСтатуса(ТекДанные,ТекДанные.СостояниеЗаказа,Результат.НовыйВид) 
	Иначе 
		Сообщить("Не удалось изменить вид заказа");     
	КонецЕсли; 
	Если не ПустаяСтрока(Результат.Сообщение) Тогда  
		ЗафиксироватьВМонитор(ТекДанные,Результат.Сообщение);	
	КонецЕсли; 
	
КонецПроцедуры  

&НаСервереБезКонтекста
Процедура 	mona_СменитьВидЗаказаНаСервере(СсылкаЗаказа,Результат)
	Результат.Вставить("НовыйВид");
	ДокОбъект = СсылкаЗаказа.ПолучитьОбъект();  	      
	ВидИнтернетЗаказ = mona_ОбработкаИнтернетЗаказа.ВидЗаказаИнтернет();
	ВидПВЗ = mona_ОбработкаИнтернетЗаказа.ВидЗаказаПВЗ();   
	Если ДокОбъект.ВидЗаказа = ВидИнтернетЗаказ Тогда
		ДокОбъект.ВидЗаказа = ВидПВЗ;     
		Результат.НовыйВид = ВидПВЗ;
	ИначеЕсли ДокОбъект.ВидЗаказа = ВидПВЗ Тогда   
		ДокОбъект.ВидЗаказа = ВидИнтернетЗаказ;
		Результат.НовыйВид = ВидИнтернетЗаказ;  
	КонецЕсли; 
	//ЗаполнитьДоставку(ДокОбъект,Самовывоз = Ложь) 
	mona_ОбработкаИнтернетЗаказа.ЗаполнитьДоставку(ДокОбъект,ДокОбъект.ВидЗаказа <> ВидИнтернетЗаказ,Результат);
	Результат.Вставить("ИмяВида",ДокОбъект.ВидЗаказа.Наименование);
	Попытка 
		ДокОбъект.Записать();
	Исключение 
		Результат.Успех = Ложь;
	КонецПопытки;  
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьСтатус(Команда)
	ТекДанные = Элементы.Список.ТекущиеДанные; 
	ОчиститьСообщения();
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Заказ) Тогда
		Сообщить("Выберите заказ в списке.");
		Возврат;
	КонецЕсли;
	Результат = mona_ПереключитьСтатусНа(ТекДанные);
	
	Если Результат.Успех Тогда   
		
		Если Результат.Свойство("ЧекККМ") Тогда 
			ПробитиеЧека(Результат.ЧекККМ);
		КонецЕсли; 
		
		ПоказатьОповещениеПользователя("Статус заказа " + ТекДанные.Заказ + " изменен на """ + Строка(Результат.НовыйСтатус) + """");
		Элементы.Список.Обновить();    
		ОбработатьИзменениеСтатуса(ТекДанные,Результат.НовыйСтатус); 
	Иначе
		Сообщить(Результат.Сообщение);
		ЗафиксироватьВМонитор(ТекДанные,Результат.Сообщение);
	КонецЕсли;
	
	
КонецПроцедуры
&НаКлиенте
Асинх Функция ПробитьЧеки(КФискализации) 

	Для Каждого стр из КФискализации Цикл 
		Если ПустаяСтрока(стр.ФискальныйПризнак) Тогда  
			Если ИдетПечатьЧека Тогда 
		    	Возврат Ложь;
			КонецЕсли;	
//			ПроверкаЧека(стр.ЧекККМ);    //Временно
			Ждать ПробитиеЧека(стр.ЧекККМ);
			ИдетПечатьЧека = Истина;
		Иначе
			ИдетПечатьЧека = Ложь;
			ЗафиксироватьПробитие(стр);
		КонецЕсли;
	КонецЦикла;
КонецФункции

&НаКлиенте
Асинх Функция ПробитиеЧека(Чек)
	ПараметрыФормы = Новый Структура("Ключ", Чек);
	ФормаДокумента = ПолучитьФорму("Документ.ЧекККМ.Форма.ФормаДокумента", ПараметрыФормы);
	ФормаДокумента.Открыть(); 
	ФормаДокумента.прс_ПробитьЧекПрограммно();
	ФормаДокумента.Закрыть();
КонецФункции 

&НаСервереБезКонтекста
Процедура ЗафиксироватьПробитие(стр)
	Запись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
	Запись.Заказ = стр.Заказ;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда 
		Запись.ПробитьЧек = Ложь;		
	КонецЕсли;
	Запись.Записать();
КонецПроцедуры


