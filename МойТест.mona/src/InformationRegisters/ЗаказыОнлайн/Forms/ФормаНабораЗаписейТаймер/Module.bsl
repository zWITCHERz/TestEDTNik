&НаСервереБезКонтекста
Процедура СинхронизироватьОтмененные(СостояниеОтменен)
	Запрос = Новый Запрос;
	Запрос.Текст =               
	"ВЫБРАТЬ
	|	З.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.ЗаказыОнлайн КАК З
	|ГДЕ
	|	З.ЗаказОтменен = ИСТИНА
	|	И З.Заказ.СостояниеЗаказа <> &СостояниеОтмены";   
	Запрос.УстановитьПараметр("СостояниеОтмены",СостояниеОтменен);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УстановитьСтатус(Выборка.Заказ,СостояниеОтменен);
	КонецЦикла; 
КонецПроцедуры 

