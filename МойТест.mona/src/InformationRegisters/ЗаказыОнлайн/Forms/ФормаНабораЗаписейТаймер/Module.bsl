&НаКлиенте
Процедура ПроверитьКрасныеДедлайны(КрасныеЗаказы)
	НовыеПоказанные = Новый Соответствие;
	Для Каждого Стр Из КрасныеЗаказы Цикл
		Ключ = Строка(Стр.Заказ.УникальныйИдентификатор()) + " | " + Стр.ЧтоПросрочено;
		Если ПоказанныеКрасные[Ключ] = Неопределено Тогда
			ПоказатьОповещениеПользователя(
			"Просрочен дедлайн сборки!",
			,
			"Заказ: " + Стр.Представление + ", " + Стр.ЧтоПросрочено,
			БиблиотекаКартинок.Предупреждение);
		КонецЕсли;
		НовыеПоказанные.Вставить(Ключ, Истина);
	КонецЦикла;
	ПоказанныеКрасные = НовыеПоказанные;
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьКрасныеЗаказы(ГраницыСухая,ГраницыХолодная,Статусы)
	ГраницаN = ГраницыСухая.ГраницаКрасная;
	ГраницаM = ГраницыХолодная.ГраницаКраснаяДоставка;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| З.Заказ КАК Заказ,
	| ПРЕДСТАВЛЕНИЕ(З.Заказ) КАК Представление,
	| З.НачалоВременногоИнтервалаДоставки КАК Слот,
	| З.СухаяЧастьСобрана КАК СухаяЧастьСобрана,
	| З.ХолоднаяЧастьСобрана КАК ХолоднаяЧастьСобрана,
	| З.ЕстьСкоропорт КАК ЕстьСкоропорт
	|ИЗ
	| РегистрСведений.ЗаказыОнлайн КАК З
	|ГДЕ
	| З.НачалоВременногоИнтервалаДоставки > ДАТАВРЕМЯ(1, 1, 1)
	| И З.Заказ.СостояниеЗаказа В (&Статусы)";
	
	Запрос.УстановитьПараметр("Статусы",Статусы);
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПросроченаСухая = (Выборка.Слот <= ГраницаN И Выборка.СухаяЧастьСобрана <> Истина);
		ПросроченаХолодная = (Выборка.Слот <= ГраницаM И Выборка.ХолоднаяЧастьСобрана <> Истина И Выборка.ЕстьСкоропорт);
		
		Если Не ПросроченаСухая И Не ПросроченаХолодная Тогда
			Продолжить;
		КонецЕсли;
		
		ЧтоПросрочено = "";
		Если ПросроченаСухая Тогда
			ЧтоПросрочено = "сухая часть";
		КонецЕсли;
		Если ПросроченаХолодная Тогда
			Если ЗначениеЗаполнено(ЧтоПросрочено) Тогда
				ЧтоПросрочено = ЧтоПросрочено + ", холодная часть";
			Иначе
				ЧтоПросрочено = "холодная часть";
			КонецЕсли;
		КонецЕсли;
		
		Стр = Новый Структура;
		Стр.Вставить("Заказ", Выборка.Заказ);
		Стр.Вставить("Представление", Выборка.Представление);
		Стр.Вставить("ЧтоПросрочено", ЧтоПросрочено);
		Стр.Вставить("ВидПредупреждения", Перечисления.mona_ВидыПредупреждений.КрасныйДедлайн);
		Результат.Добавить(Стр);
	КонецЦикла;
	Возврат Результат;
КонецФункции

