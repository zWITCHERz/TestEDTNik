&НаКлиенте
Функция mona_ПереключитьОтборЧастичнойСборки(Включен = Ложь)
	Отбор = Список.Отбор;
	Найден = Неопределено;
	Для Каждого Эл Из Отбор.Элементы Цикл
		Если ТипЗнч(Эл) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПризнакЧастичнойСборки") Тогда
			Найден = Эл;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Найден = Неопределено Тогда
		Эл = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПризнакЧастичнойСборки");
		Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Эл.ПравоеЗначение = Истина;
		Эл.Использование = Включен;
	Иначе
		Найден.Использование = Не Найден.Использование; 
		Включен = Найден.Использование;
	КонецЕсли;
	Если Включен Тогда
		Элементы.ФормаТолькоЧастичнаяСборка.Заголовок =  "Снять отбор по частичной сборке";
		Элементы.ФормаТолькоЧастичнаяСборка.Пометка = Включен;
	Иначе
		Элементы.ФормаТолькоЧастичнаяСборка.Заголовок =  "Только частичная сборка";  
		Элементы.ФормаТолькоЧастичнаяСборка.Пометка = Включен;
	КонецЕсли;	
	Возврат Включен;

КонецФункции

