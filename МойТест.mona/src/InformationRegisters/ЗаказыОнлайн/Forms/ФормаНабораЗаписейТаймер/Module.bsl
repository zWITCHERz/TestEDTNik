	Эл.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ТемноСиний);
	ДобавитьУсловие(Эл.Отбор, "ЕстьСкоропорт", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ПолеОф = Эл.Поля.Элементы.Добавить();
