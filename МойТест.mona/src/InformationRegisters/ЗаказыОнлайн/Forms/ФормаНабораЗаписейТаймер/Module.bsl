&НаКлиенте
Функция mona_ПереключитьСтатусНа(ТекДанные)
	Результат = СтруктураРезультата();
	Результат.Вставить("НовыйСтатус",mona_СтатусыЗаказов.СледующийСтатусПоПорядку(ТекДанные.СостояниеЗаказа,ТекДанные.ВидЗаказа));
	
	Если Результат.НовыйСтатус = СостояниеДоставлен 
		или Результат.НовыйСтатус = СостояниеВыдан 
		и СменаОткрыта тогда 
			Чек = mona_ОбработкаИнтернетЗаказа.СоздатьРезультирующийЧекНаСервере(ТекДанные.Заказ);  
		 	Попытка
				ПробитиеЧека(Чек);
			исключение
			конецпопытки;
		конецесли; 

	Если Результат.НовыйСтатус = Неопределено Тогда
		Результат.Сообщение = "Для статуса """ + Строка(ТекДанные.СостояниеЗаказа)
		+ """ нет автоматического следующего шага, переход возможен только вручную";
	//ИначеЕсли Результат.НовыйСтатус = СостояниеОплачен тогда 
		Результат.Успех = Ложь;
	ИначеЕсли Результат.НовыйСтатус = СостояниеСобран Тогда
		Собрано = Истина;
		ЧастиЗаказа = mona_ОбработкаИнтернетЗаказа.ОпределитьЧастиЗаказа(ТекДанные.Заказ);
		
		Если ЧастиЗаказа.ЕстьСухаяЧасть И Не ТекДанные.СухаяЧастьСобрана Тогда
			Результат.Сообщение = "Нельзя перевести в «Собран»: сухая часть ещё не собрана.";
			Собрано = Ложь;
		КонецЕсли;
		
        		
		Если ЧастиЗаказа.ЕстьХолоднаяЧасть И Не ТекДанные.ХолоднаяЧастьСобрана Тогда
			Результат.Сообщение = "Нельзя перевести в «Собран»: в заказе есть скоропортящийся товар, холодная часть ещё не собрана.";
			Собрано = Ложь;
		КонецЕсли;	
		
		Если ТекДанные.ПризнакЧастичнойСборки Тогда
			Результат.Сообщение = "Нельзя перевести в «Собран»: у заказа активна частичная сборка, требуется решение оператора по недостающей позиции.";
			Собрано = Ложь;
		КонецЕсли;
		Результат.Успех = Собрано;
	КонецЕсли;
	
	Если Результат.Успех Тогда 
		Попытка
			УстановитьСтатус(ТекДанные.Заказ,Результат.НовыйСтатус);
		Исключение
			Результат.Сообщение = "Ошибка при смене статуса: " + ОписаниеОшибки();
			Результат.Успех = Ложь;
		КонецПопытки;
	КонецЕсли;	
	Возврат Результат;
КонецФункции

&НаКлиенте
асинх Процедура ОбработатьИзменениеСтатуса(ТекДанные,НовыйСтатус = Неопределено,ВидЗаказа = Неопределено,ЕстьЯндексДоставка = Истина) 
	Если НовыйСтатус = Неопределено Тогда 
		НовыйСтатус = ТекДанные.СостояниеЗаказа;	
	КонецЕсли;
	Если ВидЗаказа = Неопределено Тогда 
		ВидЗаказа = ТекДанные.ВидЗаказа;	
	КонецЕсли;
	Если НовыйСтатус = СостояниеСобран и ЕстьЯндексДоставка и ВидЗаказа <> Самовывоз Тогда 
		ДанныеДокумента = ДанныеЗаказа(ТекДанные.Заказ); 
		
	Результат = СтруктураРезультата();
	Попытка
		Данные = AWAIT mona_ЯндексДоставка.claims_create(ДанныеДокумента,Результат); 
		Если Результат.Успех Тогда 
				ЗаписатьClaimIDЗаказ(ТекДанные.Заказ, Данные.id);
				Возврат ;
		    КонецЕсли;
	Исключение
	КонецПопытки;
	mona_ЯндексДоставкаСервер.ЗафиксироватьОшибкуОтправки(ТекДанные.Заказ, Результат);
	ЗафиксироватьВМонитор(ТекДанные,Результат.Сообщение);
		
	КонецЕсли;	
КонецПроцедуры
