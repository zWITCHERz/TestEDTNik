&НаКлиенте
Функция mona_ПереключитьОтборОплаченВСборке(Включен = Ложь)
	Отбор = Список.Отбор;
	Найден = Неопределено;
	Для Каждого Эл Из Отбор.Элементы Цикл
		Если ТипЗнч(Эл) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СостояниеЗаказа") Тогда
			Найден = Эл;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Найден = Неопределено Тогда
		Эл = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СостояниеЗаказа");
		Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		СписокСтатусов = Новый СписокЗначений;
		СписокСтатусов.Добавить(СостояниеОплачен);
		СписокСтатусов.Добавить(СостояниеВСборке);
		Эл.ПравоеЗначение = СписокСтатусов;
		Эл.Использование = Включен;
	Иначе
		Найден.Использование = Не Найден.Использование; 
		Включен = Найден.Использование;
	КонецЕсли;
		Если Включен Тогда
		Элементы.ФормаОтборТЧСборкаОплата.Заголовок = "оплачен/в сборке"; 
		Элементы.ФормаОтборТЧСборкаОплата.Пометка = Истина;
	Иначе
		Элементы.ФормаОтборТЧСборкаОплата.Заголовок = "оплачен/в сборке";
		Элементы.ФормаОтборТЧСборкаОплата.Пометка = Ложь;
	КонецЕсли;
	Возврат Включен;

	
	
КонецФункции
