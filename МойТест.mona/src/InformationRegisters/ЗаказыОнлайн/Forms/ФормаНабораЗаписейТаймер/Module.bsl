&НаКлиенте
Процедура ДобавитьПодсветкуСтатусов()
	ИмяПоля = "СостояниеЗаказа";
	Для Каждого Пара Из СостоянияЗаказов Цикл
		Эл = Список.УсловноеОформление.Элементы.Добавить();
		Эл.Оформление.УстановитьЗначениеПараметра("ЦветФона", Пара.Значение.Цвет);
		ДобавитьУсловие(Эл.Отбор, ИмяПоля, ВидСравненияКомпоновкиДанных.Равно, Пара.Ключ);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПодсветкуДедлайнаN(Границы)
	ИмяПоля = "СостояниеЗаказа";
	ИмяСлота = "НачалоВременногоИнтервалаДоставки";
	ПустаяДата = '00010101000000';
	
	ЭлЖ = Список.УсловноеОформление.Элементы.Добавить();
	ЭлЖ.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Желтый);
	ДобавитьУсловие(ЭлЖ.Отбор, ИмяСлота, ВидСравненияКомпоновкиДанных.Больше, ПустаяДата);
	ДобавитьУсловие(ЭлЖ.Отбор, ИмяСлота, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, Границы.ГраницаЖелтая);
	ДобавитьУсловие(ЭлЖ.Отбор, ИмяПоля, ВидСравненияКомпоновкиДанных.ВСписке, КонтрольныеСтатусыЗаказов);
	ДобавитьУсловие(ЭлЖ.Отбор, "СухаяЧастьСобрана", ВидСравненияКомпоновкиДанных.НеРавно, Истина);
	
	ЭлКр = Список.УсловноеОформление.Элементы.Добавить();
	ЭлКр.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Коралловый);
	ДобавитьУсловие(ЭлКр.Отбор, ИмяСлота, ВидСравненияКомпоновкиДанных.Больше, ПустаяДата);
