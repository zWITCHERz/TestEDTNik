&НаКлиенте
Процедура ОтборДоставка(Команда)
	Отбор = Список.Отбор;
	Найден = Неопределено;
	Включен = Истина;
	Для Каждого Эл Из Отбор.Элементы Цикл
		Если ТипЗнч(Эл) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидЗаказа") Тогда
			Найден = Эл;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Найден = Неопределено Тогда
		Эл = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидЗаказа");
		Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		Эл.ПравоеЗначение = Самовывоз;
		Эл.Использование = Включен;
	Иначе
		Найден.Использование = Не Найден.Использование; 
		Включен = Найден.Использование;
	КонецЕсли;
	Элементы.ФормаОтборДоставка.Пометка = Включен;
	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//ЗаполнитьКонтактыЗаказа(ТекДанные.Заказ);  
	Если Включен Тогда 
		Элементы.ГруппаДоставка.Показать(); 
	Иначе 
		Элементы.ГруппаДоставка.Скрыть(); 
	КонецЕсли;

	
	
	
	
//	Если Включен Тогда
//		Элементы.ФормаТолькоЧастичнаяСборка.Заголовок =  "Только доставка";
//	Иначе
//		Элементы.ФормаТолькоЧастичнаяСборка.Заголовок =  "Только частичная сборка";  
//	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Асинх Процедура ДоставкаПолучитьЦену(Команда)
    ТекДанные = Элементы.Список.ТекущиеДанные;
    Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Заказ) Тогда
        Возврат;
    КонецЕсли;
    
    ДанныеДокумента = ДанныеЗаказа(ТекДанные.Заказ);
 	Результат = СтруктураРезультата();
	Попытка
	check_price = Await mona_ЯндексДоставка.check_price(ДанныеДокумента,Результат);
	
	// Названия полей в ответе check-price не подтверждены (в исходном коде
	// были закомментированные догадки Результат.Цена/Результат.Валюта) —
	// пробуем несколько вероятных вариантов через Свойство(), чтобы не упасть,
	// если угадали неверно; в любом случае оператор увидит хоть что-то.
	
	Если Результат.Успех Тогда 
		Если check_price = Неопределено Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Не удалось получить стоимость доставки.";
		Иначе
			Текст = "Ответ Яндекса (check-price) получен.";
			Если check_price.Свойство("price") Тогда
				Текст = "Стоимость доставки: " + check_price.price;
				Если check_price.Свойство("currency") Тогда
					Текст = Текст + " " + check_price.currency;
				КонецЕсли;
			КонецЕсли;
			Элементы.СтрокаЯндекс.ЦветТекста = Новый Цвет(0, 150, 0);
			СтрокаЯндекс = Текст;
			Возврат;
		КонецЕсли; 
    КонецЕсли
	Исключение
	КонецПопытки;	
	mona_ЯндексДоставкаСервер.ЗафиксироватьОшибкуОтправки(ТекДанные.Заказ, Результат);
	ЗафиксироватьВМонитор(ТекДанные,Результат.Сообщение); 
	Элементы.СтрокаЯндекс.ЦветТекста = Новый Цвет(180, 0, 0);
	СтрокаЯндекс = Результат.Сообщение;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДоставкаПодтвердить(Команда)
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Заказ) Тогда
		Возврат;
	КонецЕсли;
	
	//ClaimID = ПолучитьClaimЗаказа(ТекДанные.Заказ);
	//Если Не ЗначениеЗаполнено(ClaimID) Тогда
	//	Сообщить("У заказа нет заявки Яндекс.Доставки");
	//	Возврат;
	//КонецЕсли;
	
   Попытка
		Инфо =  ждать mona_ЯндексДоставка.claims("info", ТекДанные.claim_id);
		Статус = Инфо.status;

		////Подтверждение = ждать mona_ЯндексДоставка.claims("accept", claim_id,new structure("version",info.version));
		Подтверждение = Неопределено;
		Если Подтверждение = Неопределено Тогда
			Сообщить("Подтверждение невозможно при текущем статусе доставки: " + Статус);
			Возврат;
		КонецЕсли;
		
		ЗаписатьClaimIDЗаказ(ТекДанные.Заказ, "");
		Элементы.Список.Обновить();
		ПоказатьОповещениеПользователя("Заявка " + ТекДанные.claim_id + " подтверждена");
	Исключение
		Сообщить("Ошибка подтверждения заявки: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДоставкаОтменить(Команда)
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Заказ) Тогда
		Возврат;
	КонецЕсли;
 	Результат = СтруктураРезультата();
	Если Не ЗначениеЗаполнено(ТекДанные.claim_id) Тогда
		Сообщить("У заказа нет заявки Яндекс.Доставки — нечего отменять.");
		Возврат;
	КонецЕсли;
	
	// ТЗ: 1С должна фиксировать инициатора, причину, время отмены и удержанную
	// сумму. Диалог для ввода причины оператором убран — в этом режиме
	// приложения модальные окна запрещены полностью, и даже асинхронный
	// Ждать ВвестиСтроку(...) падает с "Использование модальных окон в данном
	// режиме запрещено". Пока пишем причину по умолчанию; если нужен реальный
	// ввод текста — потребуется отдельная НЕмодальная форма (открывается через
	// ОткрытьФорму, не через системный диалог), это отдельная задача.
	Причина = "отмена оператором (диалог ввода недоступен в этом режиме)";
	
	Попытка
		РезультатОтмены = ЖДАТЬ mona_ЯндексДоставка.ОтменаДоставки(ТекДанные.claim_id,Результат);
		Если РезультатОтмены = Неопределено Тогда
	//		Сообщить("Отмена недоступна при текущем статусе доставки: " + Статус);
	//		ЗафиксироватьОшибкуОтменыЗаявки(ТекДанные.Заказ, ТекДанные.claim_id,
	//			"отмена недоступна при статусе: " + Статус);
			Возврат;
		КонецЕсли;
		
		// СуммаУдержания: в ответе claims/cancel нет отдельного поля с точной
		// суммой (только флаг free/paid в cancel_state) — если Яндекс её
		// всё же вернёт под другим именем, сюда можно подставить реальное
		// значение вместо 0.
		ЗафиксироватьУспешнуюОтменуЗаявки(ТекДанные.Заказ, ТекДанные.claim_id, Причина, 0);
		
		// Подтверждение статуса ОТ ЯНДЕКСА (не наше намерение отменить, а то,
		// что сам Яндекс вернул в ответ) — тем же способом, что и обычный
		// опрос раз в 5 сек, чтобы в mona_ЖурналОбмена была симметрия:
		// ОтменаЗаявкиЯндекс — наше действие, ОбновлениеСтатусаЯндекс —
		// подтверждение от Яндекса.
		Если РезультатОтмены.Свойство("status") И ЗначениеЗаполнено(РезультатОтмены.status) Тогда
			ЗаписатьСтатусЗаявки(ТекДанные.claim_id, РезультатОтмены.status);
		Иначе
			ЗаписатьСтатусЗаявки(ТекДанные.claim_id, "cancelled");
		КонецЕсли;
		Элементы.Список.Обновить();
		ПоказатьОповещениеПользователя("Заявка " + ТекДанные.claim_id + " отменена");
	Исключение
		Сообщить("Ошибка отмены заявки: " + ОписаниеОшибки());
		ЗафиксироватьОшибкуОтменыЗаявки(ТекДанные.Заказ, ТекДанные.claim_id, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Тонкие серверные обёртки этой же формы — mona_ЯндексДоставкаСервер по
// какой-то причине не резолвится при прямом вызове с клиента (та же история,
// что раньше была с ПолучитьЗаказыСАктивнойЗаявкой), поэтому логика продублирована
// прямо здесь, без обращения к этому общему модулю.
&НаСервереБезКонтекста
Процедура ЗафиксироватьОшибкуОтменыЗаявки(Заказ, claim_id, ТекстОшибки)
	mona_ЖурналОбмена.ЗаписатьСобытие(
		Перечисления.mona_ТипСобытийОбмена.ОтменаЗаявкиЯндекс,
		Перечисления.mona_НаправлениеОбмена.Исходящее,
		Перечисления.mona_Источник.Система,
		Перечисления.mona_Источник.ЯндексДоставка,
		Перечисления.mona_Инициатор.Оператор,
		Перечисления.mona_Статус.Ошибка,
		ТекстОшибки,
		Заказ,
		1,
		0,
		"", "", claim_id);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗафиксироватьУспешнуюОтменуЗаявки(Заказ, claim_id, Причина, СуммаУдержания = 0)
	ТекстСобытия = Причина;
	Если ЗначениеЗаполнено(СуммаУдержания) И СуммаУдержания > 0 Тогда
		ТекстСобытия = ТекстСобытия + " (удержано: " + СуммаУдержания + ")";
	КонецЕсли;
	Запись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
	Запись.Заказ = Заказ;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Запись.claim_id = "x" + claim_id;
		Запись.Записать();
	КонецЕсли;
	
	mona_ЖурналОбмена.ЗаписатьСобытие(
		Перечисления.mona_ТипСобытийОбмена.ОтменаЗаявкиЯндекс,
		Перечисления.mona_НаправлениеОбмена.Исходящее,
		Перечисления.mona_Источник.Система,
		Перечисления.mona_Источник.ЯндексДоставка,
		Перечисления.mona_Инициатор.Оператор,
		Перечисления.mona_Статус.Успех,
		ТекстСобытия,
		Заказ,
		1,
		СуммаУдержания,
		"", "", claim_id);
КонецПроцедуры

// Маркер отмены вместо очистки claim_id — чтобы фоновый опрос/автосоздание
// не подхватили этот заказ заново как "без заявки" (см. ту же логику в
// mona_ЯндексДоставкаСервер.ЗаписатьОтмененныйClaimIDЗаказ — дублируем здесь
// по той же причине резолвинга).

&НаКлиенте
Асинх Процедура ДоставкаСоздать(Команда)
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Заказ) Тогда
		Возврат;
	КонецЕсли;
	Результат = СтруктураРезультата();
	Попытка
		ДанныеДокумента = ДанныеЗаказа(ТекДанные.Заказ); 
		Если Не ПустаяСтрока(ТекДанные.claim_id) Тогда 
			ДанныеДокумента.Вставить("claim_id",СокрЛП(ТекДанные.claim_id));	
		КонецЕсли;	
		Данные = AWAIT mona_ЯндексДоставка.claims_create(ДанныеДокумента,Результат); 
		Если Результат.Успех Тогда 
			ЗаписатьClaimIDЗаказ(ТекДанные.Заказ, Данные.id);
			Возврат;
	    КонецЕсли;
	Исключение
	КонецПопытки;
	mona_ЯндексДоставкаСервер.ЗафиксироватьОшибкуОтправки(ТекДанные.Заказ, Результат);
	ЗафиксироватьВМонитор(ТекДанные,Результат.Сообщение);
КонецПроцедуры


#КонецОбласти