    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	РегистрСведенийЗаказыОнлайн.Заказ КАК Заказ,
	РегистрСведенийЗаказыОнлайн.ХолоднаяЧастьСобрана КАК ХолоднаяЧастьСобрана,
	РегистрСведенийЗаказыОнлайн.СухаяЧастьСобрана КАК СухаяЧастьСобрана,
	РегистрСведенийЗаказыОнлайн.ИсточникЗаказа КАК ИсточникЗаказа,
	РегистрСведенийЗаказыОнлайн.МоментОтмены КАК МоментОтмены,
	РегистрСведенийЗаказыОнлайн.НачалоВременногоИнтервалаДоставки КАК НачалоВременногоИнтервалаДоставки,
	РегистрСведенийЗаказыОнлайн.ПричинаОтмены КАК ПричинаОтмены,
	РегистрСведенийЗаказыОнлайн.ПризнакОтложенногоВозврата КАК ПризнакОтложенногоВозврата,
	РегистрСведенийЗаказыОнлайн.ПризнакЧастичнойСборки КАК ПризнакЧастичнойСборки,
	РегистрСведенийЗаказыОнлайн.СостояниеЗаказа КАК СостояниеЗаказа,
	РегистрСведенийЗаказыОнлайн.ДатаОкончанияПриема КАК ДатаОкончанияПриема,
	РегистрСведенийЗаказыОнлайн.ЕстьСкоропорт КАК ЕстьСкоропорт,
	РегистрСведенийЗаказыОнлайн.ВидЗаказа КАК ВидЗаказа,
	ВЫБОР
		КОГДА РегистрСведенийЗаказыОнлайн.ВидЗаказа = &amp;Самовывоз
			ТОГДА ВЫРАЗИТЬ(NULL КАК ДАТА)
		КОГДА РегистрСведенийЗаказыОнлайн.ВремяПрибытияКурьераККлиенту = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ДОБАВИТЬКДАТЕ(РегистрСведенийЗаказыОнлайн.НачалоВременногоИнтервалаДоставки, СЕКУНДА, &amp;СмещениеПрибытия)
		ИНАЧЕ РегистрСведенийЗаказыОнлайн.ВремяПрибытияКурьераККлиенту
	КОНЕЦ КАК ВремяПрибытияКурьераРасч,
	РегистрСведенийЗаказыОнлайн.Телефон КАК Телефон,
	РегистрСведенийЗаказыОнлайн.ПробитьЧек КАК ПробитьЧек,
	РегистрСведенийЗаказыОнлайн.tiptoppay_id КАК tiptoppay_id,
	РегистрСведенийЗаказыОнлайн.order_number КАК order_number,
	РегистрСведенийЗаказыОнлайн.КоординатыШирота КАК КоординатыШирота,
	РегистрСведенийЗаказыОнлайн.КоординатыДолгота КАК КоординатыДолгота,
	РегистрСведенийЗаказыОнлайн.Адрес КАК Адрес,
	РегистрСведенийЗаказыОнлайн.claim_id КАК claim_id,
	РегистрСведенийЗаказыОнлайн.yandex_status КАК yandex_status,
	РегистрСведенийЗаказыОнлайн.order_id КАК order_id,
	РегистрСведенийЗаказыОнлайн.Idempotency_Key КАК Idempotency_Key,
	РегистрСведенийЗаказыОнлайн.ДатаРешенияОператора КАК ДатаРешенияОператора,
	РегистрСведенийЗаказыОнлайн.РешениеОператораПринято КАК РешениеОператораПринято
ИЗ
	РегистрСведений.ЗаказыОнлайн КАК РегистрСведенийЗаказыОнлайн</queryText>
      <mainTable>InformationRegister.ЗаказыОнлайн</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ПричинаОтмены</dataPath>
        <field>ПричинаОтмены</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Заказ</dataPath>
        <field>Заказ</field>
        <presentationExpression>Заказ.Номер</presentationExpression>
