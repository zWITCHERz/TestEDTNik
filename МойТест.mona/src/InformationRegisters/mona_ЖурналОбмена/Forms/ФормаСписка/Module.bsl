&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если РольДоступна("mona_Бухгалтер") Тогда
		УстановитьОтборПоТипамСобытий(ФинансовыеТипы());
	ИначеЕсли РольДоступна("mona_ОператорЗаказов") Тогда
		УстановитьОтборПоТипамСобытий(ТипыОператора());
	КонецЕсли;   
КонецПроцедуры

&НаСервере
Функция ФинансовыеТипы()
	Типы = Новый Массив;
	Типы.Добавить(Перечисления.mona_ТипСобытийОбмена.СозданиеПлатежнойСессии);
	Типы.Добавить(Перечисления.mona_ТипСобытийОбмена.УспешнаяОплата);
	Типы.Добавить(Перечисления.mona_ТипСобытийОбмена.ОшибкаОплаты);
	Типы.Добавить(Перечисления.mona_ТипСобытийОбмена.АвтоОтмена);
	Типы.Добавить(Перечисления.mona_ТипСобытийОбмена.ВыгрузкаРеализации);
	Типы.Добавить(Перечисления.mona_ТипСобытийОбмена.ФискальныйЧекПродажи);
	Типы.Добавить(Перечисления.mona_ТипСобытийОбмена.ОшибкаОбменаСБухгалтерией);
	Возврат Типы;
КонецФункции

&НаСервере
Функция ТипыОператора()
	Типы = Новый Массив;
	Типы.Добавить(Перечисления.mona_ТипСобытийОбмена.ОшибкаОбменаСПриложением);
	// плюс события возвратов — если появятся отдельные типы под возвраты, добавить сюда
	Возврат Типы;
КонецФункции

&НаСервере
Процедура УстановитьОтборПоТипамСобытий(МассивТипов)
	Отбор = Список.Отбор;
	Эл = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипСобытия");
	Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	СписокЗнач = Новый СписокЗначений;
	Для Каждого Т Из МассивТипов Цикл
		СписокЗнач.Добавить(Т);
	КонецЦикла;
	Эл.ПравоеЗначение = СписокЗнач;
	Эл.Использование = Истина;
КонецПроцедуры
