#Область РабочеВеремя
Функция НачалоРабочегоДняЧасы() Экспорт
	Значение = Константы.mona_НачалоРабочегоДня.Получить();
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 10*3600;
	КонецЕсли;
	Возврат Час(Значение)*3600 + Минута(Значение)*60;
КонецФункции

Функция КонецРабочегоДняЧасы() Экспорт
	Значение = Константы.mona_КонецРабочегоДня.Получить();
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 22*3600;
	КонецЕсли;
	Возврат Час(Значение)*3600 + Минута(Значение)*60;
КонецФункции

Функция РабочихСекундМежду(Старт, Финиш) Экспорт
	Если Старт >= Финиш Тогда
		Возврат 0;
	КонецЕсли;
	
	НачалоРабДня = НачалоРабочегоДняЧасы();
	КонецРабДня = КонецРабочегоДняЧасы();
	
	//Сообщить("НачалоРабДня=" + НачалоРабДня + " КонецРабДня=" + КонецРабДня);
	
	Всего = 0;
	Текущий = Старт;
	Итерация = 0;
	
	Пока Текущий < Финиш И Итерация < 5 Цикл
		Итерация = Итерация + 1;
		ТекущийДень = НачалоДня(Текущий);
		НачалоОкна = ТекущийДень + НачалоРабДня;
		КонецОкна = ТекущийДень + КонецРабДня;
		
		Лево = Макс(Текущий, НачалоОкна);
		Право = Мин(Финиш, КонецОкна);
		
		//Сообщить("Итерация " + Итерация + ": Текущий=" + Текущий + " ТекущийДень=" + ТекущийДень 
		//+ " НачалоОкна=" + НачалоОкна + " КонецОкна=" + КонецОкна 
		//+ " Лево=" + Лево + " Право=" + Право + " Право>Лево?" + (Право > Лево));
		
		Если Право > Лево Тогда
			Всего = Всего + (Право - Лево);
		КонецЕсли;
		
		Текущий = ТекущийДень + 86400;
	КонецЦикла;
	Возврат Всего;
КонецФункции
#КонецОбласти

#Область SLA 
Функция ПорогSLA() Экспорт
	Значение = Константы.mona_SLAЧастичнойСборки.Получить();
	Если Не ЗначениеЗаполнено(Значение) Или Значение = 0 Тогда
		Значение = 30;
	КонецЕсли;
	Возврат Значение*60;
КонецФункции

Функция ПревышенSLAЧастичнойСборки(ВремяУстановки, Сейчас = Неопределено) Экспорт
	Если Сейчас = Неопределено Тогда
		Сейчас = ТекущаяДата();
	КонецЕсли;
	Возврат РабочихСекундМежду(ВремяУстановки, Сейчас) > ПорогSLA();
КонецФункции
#КонецОбласти      

