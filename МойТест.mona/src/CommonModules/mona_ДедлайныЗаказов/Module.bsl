Функция КонтрольныеСтатусыЗаказов() Экспорт
	Статусы = Новый Массив;
	Статусы.Добавить(Справочники.СостоянияЗаказовПокупателей.НайтиПоНаименованию("Оплачен"));
	Статусы.Добавить(Справочники.СостоянияЗаказовПокупателей.НайтиПоНаименованию("В сборке"));
	Возврат Статусы;
КонецФункции  


#Область Сухая
Функция ПорогКраснойЗоныСухая() Экспорт
	Значение = Константы.mona_ДедлайнКраснойЗоныСухая.Получить();
	Если Не ЗначениеЗаполнено(Значение) Или Значение = 0 Тогда
		Значение = 0; // 0 час по умолчанию
	КонецЕсли;
	Возврат Значение * 60;
КонецФункции

Функция ОкноЖёлтойЗоныСухая() Экспорт
	Значение = Константы.mona_ОкноЖёлтойЗоныСухая.Получить();
	Если Не ЗначениеЗаполнено(Значение) Или Значение = 0 Тогда
		Значение = 60; // 60 минут по умолчанию
	КонецЕсли;
	Возврат Значение * 60;
КонецФункции

Функция ГраницыДедлайнаСухая(Сейчас) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ГраницаКрасная", Сейчас + ПорогКраснойЗоныСухая());
	Результат.Вставить("ГраницаЖелтая",  Сейчас + ПорогКраснойЗоныСухая() + ОкноЖёлтойЗоныСухая());
	Возврат Результат;
КонецФункции     
#КонецОбласти

