
&Вместо("ПолучитьПарольИзГлобальнойПеременной")
Функция mona_ПолучитьПарольИзГлобальнойПеременной(Ключ)
	// Вставить содержимое метода.
	Результат = ПродолжитьВызов(Ключ); 
	Если Результат = Неопределено Тогда 
		Результат = mona_ОбработкаИнтернетЗаказа.ИзХран(Ключ,"1СWebKassa_СоответствиеПользователяИПароля"); 
	КонецЕсли;
	Возврат Результат;
КонецФункции
