&НаСервереБезКонтекста
Процедура ЗаписатьОтмененныйClaimIDЗаказ(Заказ, ClaimID) Экспорт
	Запись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
	Запись.Заказ = Заказ;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Запись.claim_id = "x"+ClaimID;
		Запись.Записать();
	КонецЕсли;
КонецПроцедуры 
&НаСервере
Функция НайтиЗаказПоClaimID(claim_id) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ
	|ИЗ
	|	РегистрСведений.ЗаказыОнлайн
	|ГДЕ
	|	claim_id = &claim_id
	|	ИЛИ claim_id = &claim_idОтменена";
	Запрос.УстановитьПараметр("claim_id", claim_id);
	Запрос.УстановитьПараметр("claim_idОтменена", "x" + claim_id);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заказ;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Расписание повторов сценарий 5
Функция ИнтервалСледующейПопытки(КоличествоПопыток)
	Расписание = Новый Соответствие;
	Расписание.Вставить(1,30);
	Расписание.Вставить(2,60);
	Расписание.Вставить(3,300);
	Расписание.Вставить(4,1800);
	Возврат Расписание[КоличествоПопыток];
КонецФункции
&НаСервереБезКонтекста
Функция ПолучитьЗаказыБезЗаявкиЯндекс() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Заказ ИЗ РегистрСведений.ЗаказыОнлайн 
	|ГДЕ
	|	claim_id <> """"
	|	И Заказ.СпособДоставки <> ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.Самовывоз)"; 
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции        

&НаСервере
Процедура ЗафиксироватьУспехЯндекс(ТипСобытия, Заказ, Текст = "", ЧислоПопыток = 1, СуммаОперации = 0, claim_id = "", Инициатор = Неопределено) Экспорт
	Если Инициатор = Неопределено Тогда
		Инициатор = Перечисления.mona_Инициатор.АвтоматическийПроцесс;
	КонецЕсли;
	
	mona_ЖурналОбмена.ЗаписатьСобытие(
		ТипСобытия,
		Перечисления.mona_НаправлениеОбмена.Исходящее,
		Перечисления.mona_Источник.Система,
		Перечисления.mona_Источник.ЯндексДоставка,
		Инициатор,
		Перечисления.mona_Статус.Успех,
		Текст,
		Заказ,
		ЧислоПопыток,
		СуммаОперации,
		"", "", claim_id);
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьОшибкуЯндекс(ТипСобытия, Заказ, Текст, ЧислоПопыток = 1, ЭтоЭскалация = Ложь, claim_id = "", Инициатор = Неопределено) Экспорт
	Если Инициатор = Неопределено Тогда
		Инициатор = Перечисления.mona_Инициатор.АвтоматическийПроцесс;
	КонецЕсли;
	
	Если ЭтоЭскалация Тогда
		Статус = Перечисления.mona_Статус.Ожидание;
	Иначе
		Статус = Перечисления.mona_Статус.Ошибка;
	КонецЕсли;
	
	mona_ЖурналОбмена.ЗаписатьСобытие(
		ТипСобытия,
		Перечисления.mona_НаправлениеОбмена.Исходящее,
		Перечисления.mona_Источник.Система,
		Перечисления.mona_Источник.ЯндексДоставка,
		Инициатор,
		Статус,
		Текст,
		Заказ,
		ЧислоПопыток,
		0,
		"", "", claim_id);
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьУспешноеСозданиеЗаявки(Заказ, ЧислоПопыток = 1) Экспорт
	ЗафиксироватьУспехЯндекс(Перечисления.mona_ТипСобытийОбмена.СозданиеЗаявкиЯндекс, Заказ, "", ЧислоПопыток);
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьОшибкуОтправки(Заказ, Результат, ЧислоПопыток =1, ЭтоЭскалация = Ложь) Экспорт
	ЗафиксироватьОшибкуЯндекс(Перечисления.mona_ТипСобытийОбмена.ОшибкаОбменаСЯндекс, Заказ, Результат.Сообщение, ЧислоПопыток, ЭтоЭскалация);
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьОтменуЗаявки(Заказ, claim_id, Причина, Инициатор = "Оператор", СуммаУдержания = 0) Экспорт
	ИнициаторЗначение = Перечисления.mona_Инициатор.Оператор;
	Если ВРег(Инициатор) = "КЛИЕНТ" Тогда
		ИнициаторЗначение = Перечисления.mona_Инициатор.Клиент;
	ИначеЕсли ВРег(Инициатор) = "АВТОМАТИЧЕСКИЙ ПРОЦЕСС" Тогда
		ИнициаторЗначение = Перечисления.mona_Инициатор.АвтоматическийПроцесс;
	КонецЕсли;
	
	ТекстСобытия = Причина;
	Если ЗначениеЗаполнено(СуммаУдержания) И СуммаУдержания > 0 Тогда
		ТекстСобытия = ТекстСобытия + " (удержано: " + СуммаУдержания + ")";
	КонецЕсли;
	
	ЗафиксироватьУспехЯндекс(Перечисления.mona_ТипСобытийОбмена.ОтменаЗаявкиЯндекс, Заказ, ТекстСобытия, 1, СуммаУдержания, claim_id, ИнициаторЗначение);
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьОшибкуОтмены(Заказ, claim_id, ТекстОшибки) Экспорт
	ЗафиксироватьОшибкуЯндекс(Перечисления.mona_ТипСобытийОбмена.ОтменаЗаявкиЯндекс, Заказ, ТекстОшибки, 1, Ложь, claim_id);
КонецПроцедуры

&НаСервере
Функция ПолучитьЗаказыДляДоставки()	
Запрос = Новый Запрос;
Запрос.Текст = 
"ВЫБРАТЬ
|	РегЗаказы.Заказ КАК Заказ
|ПОМЕСТИТЬ ВТ_ВыбранныеЗаказы
|ИЗ
|	РегистрСведений.ЗаказыОнлайн КАК РегЗаказы
|ГДЕ
|	РегЗаказы.claim_id <> """"
|	И РегЗаказы.Заказ.СпособДоставки <> ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.Самовывоз)
|ИНДЕКСИРОВАТЬ ПО
|	Заказ
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	Ж.ИсходныйДокумент КАК Заказ,
|	ЕСТЬNULL(МАКСИМУМ(Ж.Период), ДАТАВРЕМЯ(1, 1, 1)) КАК ГраницаУспеха
|ПОМЕСТИТЬ ВТ_ГраницыУспеха
|ИЗ
|	РегистрСведений.mona_ЖурналОбмена КАК Ж
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВыбранныеЗаказы КАК ВыбранныеЗаказы
|		ПО Ж.ИсходныйДокумент = ВыбранныеЗаказы.Заказ
|ГДЕ
|	Ж.ТипСобытия = ЗНАЧЕНИЕ(Перечисление.mona_ТипСобытийОбмена.СозданиеЗаявкиЯндекс)
|	И Ж.Статус = ЗНАЧЕНИЕ(Перечисление.mona_Статус.Успех)
|ГРУППИРОВАТЬ ПО
|	Ж.ИсходныйДокумент
|ИНДЕКСИРОВАТЬ ПО
|	Заказ
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	Ж.ИсходныйДокумент КАК Заказ,
|	МИНИМУМ(Ж.Период) КАК ПерваяПопытка,
|	МАКСИМУМ(Ж.Период) КАК ПоследняяПопытка,
|	КОЛИЧЕСТВО(*) КАК КоличествоПопыток
|ПОМЕСТИТЬ ВТ_Ошибки
|ИЗ
|	РегистрСведений.mona_ЖурналОбмена КАК Ж
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВыбранныеЗаказы КАК ВыбранныеЗаказы
|		ПО Ж.ИсходныйДокумент = ВыбранныеЗаказы.Заказ
|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГраницыУспеха КАК Границы
|		ПО Ж.ИсходныйДокумент = Границы.Заказ
|ГДЕ
|	Ж.ТипСобытия = ЗНАЧЕНИЕ(Перечисление.mona_ТипСобытийОбмена.ОшибкаОбменаСЯндекс)
|	И Ж.Статус = ЗНАЧЕНИЕ(Перечисление.mona_Статус.Ошибка)
|	И Ж.Период > ЕСТЬNULL(Границы.ГраницаУспеха, ДАТАВРЕМЯ(1, 1, 1))
|ГРУППИРОВАТЬ ПО
|	Ж.ИсходныйДокумент
|ИНДЕКСИРОВАТЬ ПО
|	Заказ
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ РАЗЛИЧНЫЕ
|	Ж.ИсходныйДокумент КАК Заказ,
|	ИСТИНА КАК УжеУведомлён
|ПОМЕСТИТЬ ВТ_Маркеры
|ИЗ
|	РегистрСведений.mona_ЖурналОбмена КАК Ж
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВыбранныеЗаказы КАК ВыбранныеЗаказы
|		ПО Ж.ИсходныйДокумент = ВыбранныеЗаказы.Заказ
|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГраницыУспеха КАК Границы
|		ПО Ж.ИсходныйДокумент = Границы.Заказ
|ГДЕ
|	Ж.ТипСобытия = ЗНАЧЕНИЕ(Перечисление.mona_ТипСобытийОбмена.ОшибкаОбменаСЯндекс)
|	И Ж.Статус = ЗНАЧЕНИЕ(Перечисление.mona_Статус.Ожидание)
|	И Ж.Период > ЕСТЬNULL(Границы.ГраницаУспеха, ДАТАВРЕМЯ(1, 1, 1))
|ИНДЕКСИРОВАТЬ ПО
|	Заказ
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	ВыбранныеЗаказы.Заказ КАК Заказ,
|	ЕСТЬNULL(ВТ_Ошибки.КоличествоПопыток, 0) КАК КоличествоПопыток,
|	ЕСТЬNULL(ВТ_Ошибки.ПерваяПопытка, ДАТАВРЕМЯ(1, 1, 1)) КАК ПерваяПопытка,
|	ЕСТЬNULL(ВТ_Ошибки.ПоследняяПопытка, ДАТАВРЕМЯ(1, 1, 1)) КАК ПоследняяПопытка,
|	ЕСТЬNULL(ВТ_Маркеры.УжеУведомлён, ЛОЖЬ) КАК УжеУведомлён
|ИЗ
|	ВТ_ВыбранныеЗаказы КАК ВыбранныеЗаказы
|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Ошибки КАК ВТ_Ошибки
|			ПО ВыбранныеЗаказы.Заказ = ВТ_Ошибки.Заказ
|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Маркеры КАК ВТ_Маркеры
|			ПО ВыбранныеЗаказы.Заказ = ВТ_Маркеры.Заказ";

ТЗ_Результат = Запрос.Выполнить().Выгрузить();
МассивЗаказов = Новый Массив;
ТекущееВремя = ТекущаяДата();
Для Каждого Строка Из ТЗ_Результат Цикл
	
	ТребуетсяВниманиеОператора = ЗначениеЗаполнено(Строка.ПерваяПопытка) 
		И (ТекущееВремя - Строка.ПерваяПопытка) >= 4 * 60 * 60;
		
	Если ТребуетсяВниманиеОператора Тогда
        Продолжить;
	Иначе	
		Строка.УжеУведомлён = Ложь;
	КонецЕсли;
	Если Строка.КоличествоПопыток > 0 Тогда
			Если (ТекущаяДата() - Строка.ПоследняяПопытка) < ИнтервалСледующейПопытки(Строка.КоличествоПопыток) Тогда
				Продолжить; 
			КонецЕсли;
	КонецЕсли;
    МассивЗаказов.Добавить(Строка.Заказ);
КонецЦикла;
		
Возврат МассивЗаказов;
КонецФункции

