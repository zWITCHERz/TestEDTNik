&НаСервере
Функция ДанныеЗаказа(Заказ) Экспорт
	ТочкаОтгрузки = Справочники.mona_ТочкиОтгрузки.ПоУмолчанию();
	МетаданныеДокумента = Заказ.Метаданные();
	ДанныеДокумента = Новый Структура;
	
	ДанныеДокумента.Вставить("Ссылка", Строка(Заказ.Ссылка));
	ДанныеДокумента.Вставить("Номер",  Заказ.Номер);
	ДанныеДокумента.Вставить("order_id",  Строка(Заказ.УникальныйИдентификатор()));
	ДанныеДокумента.Вставить("ТочкаОтгрузкиДолгота",  ТочкаОтгрузки.КоординатыДолгота);
	ДанныеДокумента.Вставить("ТочкаОтгрузкиШирота",  ТочкаОтгрузки.КоординатыШирота);
	ДанныеДокумента.Вставить("ТочкаОтгрузкиАдрес",  ТочкаОтгрузки.Адрес);
	ДанныеДокумента.Вставить("ТочкаОтгрузкиКонтакт",  "Контакт не заполнен");
	ДанныеДокумента.Вставить("ТочкаОтгрузкиТелефон",  ТочкаОтгрузки.Телефон);
	ДанныеДокумента.Вставить("Тариф",  "same_day");
	ДанныеДокумента.Вставить("ТаксиКласс", "courier"); 
	ДанныеДокумента.Вставить("ExtUUID", Новый УникальныйИдентификатор()); 

	ДанныеДокумента.Вставить("Дата", Заказ.Дата); 
	
	Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		ИмяРеквизита = Реквизит.Имя;
		Значение = Заказ[ИмяРеквизита];
		//Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
		//	ДанныеДокумента.Вставить(ИмяРеквизита+"Наименование", Значение.Наименование);
		//КонецЕсли;
		ДанныеДокумента.Вставить(ИмяРеквизита, Значение);
	КонецЦикла;
	
	Для Каждого ТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		ИмяТЧ = ТЧ.Имя;
		МассивСтрокТЧ = Новый Массив;
		
		Для Каждого СтрокаТЧ Из Заказ[ИмяТЧ] Цикл
			СтруктураСтроки = Новый Структура;
			
			Для Каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл
				ИмяРеквизитаТЧ = РеквизитТЧ.Имя;
				ЗначениеРеквизитаТЧ = СтрокаТЧ[ИмяРеквизитаТЧ];
				
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеРеквизитаТЧ)) Тогда
			СтруктураСтроки.Вставить(ИмяРеквизитаТЧ+"Наименование", ЗначениеРеквизитаТЧ.Наименование);
		КонецЕсли;
					СтруктураСтроки.Вставить(ИмяРеквизитаТЧ, ЗначениеРеквизитаТЧ);
			КонецЦикла;
			
			МассивСтрокТЧ.Добавить(СтруктураСтроки);
		КонецЦикла;
		
		ДанныеДокумента.Вставить(ИмяТЧ, МассивСтрокТЧ);
	КонецЦикла;
	Если ПустаяСтрока(ДанныеДокумента.АдресЭП) Тогда 
	    ДанныеДокумента.АдресЭП = "wein@shp.su";  // заглушка
	КонецЕсли;
	Возврат ДанныеДокумента;
КонецФункции
&НаСервере
Функция ДанныеЗаказаЗапасы(Заказ) Экспорт
	МетаданныеДокумента = Заказ.Метаданные();
	ДанныеДокумента = Новый Структура;
	ИмяТЧ = "Запасы";
	ТЧ = МетаданныеДокумента.ТабличныеЧасти[ИмяТЧ];
	МассивСтрокТЧ = Новый Массив;
	Для Каждого СтрокаТЧ Из Заказ[ИмяТЧ] Цикл
		СтруктураСтроки = Новый Структура;
		Для Каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл
			ИмяРеквизитаТЧ = РеквизитТЧ.Имя;
			ЗначениеРеквизитаТЧ = СтрокаТЧ[ИмяРеквизитаТЧ];
			Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеРеквизитаТЧ)) Тогда
				СтруктураСтроки.Вставить(ИмяРеквизитаТЧ+"Наименование", ЗначениеРеквизитаТЧ.Наименование);
			КонецЕсли;
			СтруктураСтроки.Вставить(ИмяРеквизитаТЧ, ЗначениеРеквизитаТЧ);
		КонецЦикла;
			
		МассивСтрокТЧ.Добавить(СтруктураСтроки);
	КонецЦикла;
	ДанныеДокумента.Вставить(ИмяТЧ, МассивСтрокТЧ);
	Возврат ДанныеДокумента;
КонецФункции

