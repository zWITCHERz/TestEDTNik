&НаСервере
Функция СтатусыЯндекДоставки() Экспорт 
	СтатусыЯндекДоставки = Новый Соответствие;
	СтатусыЯндекДоставки.Вставить("new",				СтрЯД("заявка создана, ожидает подтверждения",Собран(),Истина,Истина));
	СтатусыЯндекДоставки.Вставить("ready_for_approval",	СтрЯД("заявка создана, ожидает подтверждения",Собран(),Истина,Истина));
	СтатусыЯндекДоставки.Вставить("estimating_failed", СтрЯД("оценка не удалась",Истина,Истина));
	
	
	СтатусыЯндекДоставки.Вставить("accepted",			СтрЯД("заявка подтверждена 1С через /claims/accept",Собран(),Истина,Истина)); 
	СтатусыЯндекДоставки.Вставить("performer_lookup",	СтрЯД("Яндекс.Доставка ищет курьера",Собран(),Истина)); //Промежуточное событие, фиксируются в журнале обмена, но не меняют основной статус заказа.
	СтатусыЯндекДоставки.Вставить("performer_not_found",СтрЯД("не удалось найти курьера в течение установленного времени",Собран(),Истина,Истина)); 
	СтатусыЯндекДоставки.Вставить("performer_draft",	СтрЯД("",,,Истина)); //Промежуточное событие, фиксируются в журнале обмена, но не меняют основной статус заказа
	//После назначения курьера и до прибытия на точку отгрузки
	СтатусыЯндекДоставки.Вставить("performer_found",	СтрЯД("курьер назначен",Собран(),Истина,Истина,Новый структура ("ИмяКурьера,ТелефонКурьера,СсылкаОтслеживания"))); 
	СтатусыЯндекДоставки.Вставить("pickup_arrived",		СтрЯД("курьер прибыл на точку отгрузки",Собран(),,Истина)); 
	// После забора посылки курьером (статус pickup и далее) стандартная отмена через API не поддерживается; 
	//	требуется обращение в поддержку Яндекс.Доставки. 
	
	СтатусыЯндекДоставки.Вставить("pickup",				СтрЯД("курьер забрал посылку", Отгружен())); // (бухгалтерское событие реализации, см. 4.2.1); 
	СтатусыЯндекДоставки.Вставить("delivery_arrived",	СтрЯД("курьер прибыл к получателю",ВПути())); //Промежуточное событие, фиксируются в журнале обмена, но не меняют основной статус заказа
	СтатусыЯндекДоставки.Вставить("delivered_finish",	СтрЯД("доставка завершена",	Доставлен()));
	СтатусыЯндекДоставки.Вставить("delivered",			СтрЯД("доставка завершена успешно",	Доставлен())); 
	
	СтатусыЯндекДоставки.Вставить("cancelled",			СтрЯД("заявка отменена"));  //статус «Отменён» с указанием инициатора 
	СтатусыЯндекДоставки.Вставить("failed",				СтрЯД("доставка не выполнена"));    //  статус «Доставка не выполнена» с уведомлением оператора для ручного разбора. 
	Возврат  СтатусыЯндекДоставки;
КонецФункции
&НаСервере
Функция СтрЯД(Название,Статус1С = "",БесплатнаяОтмена = Ложь,ВозможнаОтмена = Ложь,ДопПараметры = Неопределено)
	Возврат Новый Структура("Название,Статус1С,БесплатнаяОтмена,ВозможнаОтмена,ДопПараметры"
	,Название,Статус1С,БесплатнаяОтмена,ВозможнаОтмена,ДопПараметры);
КонецФункции

&НаСервере
Функция ПроверкаСтатусов() Экспорт
	Статусы = Новый Соответствие;
    //									БлокСменаВида ОтменаДоОтгрузки Доставка ПВЗ 	Цвет  
	Статусы.Вставить(Создан(),			Структ(	Ложь,		Истина,		Истина,	Истина,	WebЦвета.Белый));
	Статусы.Вставить(ОжидаетОплаты(),	Структ(	Ложь,		Истина,		Истина,	Истина,	WebЦвета.СветлоЗолотистый));
	Статусы.Вставить(ОшибкаОплаты(),	Структ(	Ложь,		Истина,		Истина,	Истина,	WebЦвета.СветлоРозовый));
	Статусы.Вставить(Оплачен(),			Структ(	Ложь,		Истина,		Истина,	Истина,	WebЦвета.ЗеленоЖелтый));
	Статусы.Вставить(ВСборке(),			Структ(	Ложь,		Истина,		Истина,	Истина,	WebЦвета.БледноБирюзовый)); 
	Статусы.Вставить(Собран(),			Структ(	Ложь,		Истина,		Истина,	Истина,	WebЦвета.БледноЗеленый)); 
	Статусы.Вставить(Отгружен(),		Структ(	Истина,		Ложь,		Истина,	Ложь,	WebЦвета.Васильковый));
	Статусы.Вставить(ВПути(),			Структ(	Истина,		Ложь,		Истина,	Ложь,	WebЦвета.ТемноОранжевый));
	Статусы.Вставить(Доставлен(),		Структ(	Истина,		Ложь,		Истина,	Ложь,	WebЦвета.СветлоЗолотистый));
	Статусы.Вставить(Готов(),			Структ(	Истина,		Ложь,		Ложь,	Истина,	WebЦвета.ЗеленаяЛужайка));
	Статусы.Вставить(Выдан(),			Структ(	Истина,		Ложь,		Ложь,	Истина,	WebЦвета.СветлоЗолотистый));
	Статусы.Вставить(Отменен(),			Структ(	Истина,		Ложь,		Ложь,	Ложь,	WebЦвета.ТемноБордовый));
	Статусы.Вставить(Завершен(),		Структ(	Истина,		Ложь,		Ложь,	Ложь,	WebЦвета.Серый));
	Возврат Статусы;
КонецФункции     

&НаСервере
Функция ДляПриложения() Экспорт
	Статусы = Новый Соответствие;
	Статусы.Вставить(Создан(),			"created");
	Статусы.Вставить(ОжидаетОплаты(),	"created");
	Статусы.Вставить(ОшибкаОплаты(),	"created"); // ??
	Статусы.Вставить(Оплачен(),			"confirmed");
	Статусы.Вставить(ВСборке(),			"assembling"); 
	Статусы.Вставить(Собран(),			"assembled"); 
	Статусы.Вставить(Отгружен(),		"shipped");
	Статусы.Вставить(ВПути(),			"shipped");
	Статусы.Вставить(Доставлен(),		"delivered");
	Статусы.Вставить(Готов(),			"assembled");
	Статусы.Вставить(Выдан(),			"issued");
	Статусы.Вставить(Отменен(),			"cancelled");
	Статусы.Вставить(Завершен(),		"termin"); // ??
	Возврат Статусы;
КонецФункции     



