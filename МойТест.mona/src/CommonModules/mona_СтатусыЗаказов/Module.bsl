&НаКлиенте
Функция СменаВидаЗаблокирована(СостояниеЗаказа) Экспорт
	ПроверкаСтатусов = ПроверкаСтатусов();
	Возврат ПроверкаСтатусов()[СостояниеЗаказа].БлокСменыВида;
КонецФункции
&НаСервере
функция СостояниеЗаказа(Заказ) экспорт
	Если Заказ.СостояниеЗаказа = Неопределено или Заказ.СостояниеЗаказа.Пустая() Тогда 
		Возврат Создан();
	КонецЕсли;
	возврат Заказ.СостояниеЗаказа;
КонецФункции




Функция ПоследовательностьДоставка() 
	Посл = Новый Массив;
	Посл.Добавить("Создан");
	Посл.Добавить("Ожидает оплаты");
	Посл.Добавить("Оплачен");
	Посл.Добавить("В сборке");
	Посл.Добавить("Собран");
	Посл.Добавить("Отгружен");
	Посл.Добавить("В пути");
	Посл.Добавить("Доставлен");
	Возврат Посл;
КонецФункции

Функция ПоследовательностьСамовывоз() 
	Посл = Новый Массив;
	Посл.Добавить("Создан");
	Посл.Добавить("Ожидает оплаты");
	Посл.Добавить("Оплачен");
