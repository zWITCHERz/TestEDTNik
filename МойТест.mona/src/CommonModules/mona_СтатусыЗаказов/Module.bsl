// ==== Карта состояний заказа и переходов между ними ====

Функция ДанныеСостояний() Экспорт
	ДанныеСостояний = Новый Соответствие;
	СоответствиеСостояния(ДанныеСостояний, "Создан",         "Ожидает оплаты|Отменён",                  "created");
	СоответствиеСостояния(ДанныеСостояний, "Ожидает оплаты", "Ошибка оплаты|Оплачен|Отменён",           "awaiting-payment");
	СоответствиеСостояния(ДанныеСостояний, "Ошибка оплаты",  "Ожидает оплаты|Отменён",                  "payment-failed");
	СоответствиеСостояния(ДанныеСостояний, "Оплачен",        "В сборке|Отменён|Возврат",                "paid");
	СоответствиеСостояния(ДанныеСостояний, "В сборке",       "Собран|Отменён|Возврат",                  "packing");
	СоответствиеСостояния(ДанныеСостояний, "Собран",         "Отгружен|Готов к выдаче|Отменён|Возврат", "packed");
	СоответствиеСостояния(ДанныеСостояний, "Отгружен",       "В пути|Доставлен|Отменён|Возврат",        "shipped");
	СоответствиеСостояния(ДанныеСостояний, "В пути",         "Доставлен|Отменён|Возврат",               "delivering");
	СоответствиеСостояния(ДанныеСостояний, "Доставлен",      "Возврат",                                 "delivered");
	СоответствиеСостояния(ДанныеСостояний, "Готов к выдаче", "Выдан|Отменён|Возврат",                   "ready-for-pickup");
	СоответствиеСостояния(ДанныеСостояний, "Выдан",          "Возврат",                                 "completed");
	СоответствиеСостояния(ДанныеСостояний, "Отменён",        "",                                        "cancelled");
	СоответствиеСостояния(ДанныеСостояний, "Возврат",        "",                                        "refunded");
	Возврат ДанныеСостояний; 
КонецФункции

Функция ВозможныеСостояния(СостояниеЗаказа) Экспорт
	Данные = ДанныеСостояний();
	ИмяТекущегоСостояния = Строка(СостояниеЗаказа);
	Если Данные[ИмяТекущегоСостояния] = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат Данные[ИмяТекущегоСостояния].ВозможныеСостояния;
КонецФункции

Процедура СоответствиеСостояния(ДанныеСостояний, СтрокаКлюча, СтрокаВозможныхСостояний = "", Статус = "created")
	Если ПустаяСтрока(СтрокаВозможныхСостояний) Тогда
		МассивСтрок = Новый Массив;
	Иначе
		МассивСтрок = СтрРазделить(СтрокаВозможныхСостояний, "|", Ложь);
	КонецЕсли;
	СоответствиеСостояния = Новый Структура("ВозможныеСостояния,status", МассивСтрок, Статус);
	ДанныеСостояний.Вставить(СтрокаКлюча, СоответствиеСостояния);
КонецПроцедуры

