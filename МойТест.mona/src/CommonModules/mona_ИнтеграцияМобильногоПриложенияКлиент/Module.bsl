//Для   4.3 POST /api/v1/webhooks/order-status — Webhook обновления cтатуса
//1С вызывает этот метод при каждом изменении статуса заказа на своей стороне. Laravel находит
//заказ по полю external_order_id и обновляет статус. Метод дополняет polling из п. 4.2 — позволяет
//получать обновления без запроса со стороны клиента.
//Заголовки
//Заголовок Значение
//Authorization Bearer <token> — тот же токен, что используется для запросов
//Laravel → 1С
//Content-Type application/json
//Тело запроса (от 1С)
//Поле Тип Описание
//id string ID заказа в 1С: обязательно
//status string Новый статус заказа: обязательно
//Пример тела запроса
//{
// "id": "1C-ORDER-456",
// "status": "shipped"
//}
//Ответ 200 OK
//Laravel возвращает пустой ответ с кодом 200. При ошибке (заказ не найден, невалидный статус) —
//соответствующий код из раздела 2.5.
//HTTP 200 OK
//{}
//{
// "id": "1C-ORDER-456",
// "external_id": "ORDER-00123",
// "status": "shipped",
// "updated_at": "2024-03-22T09:00:00Z",
// "tracking_number": "TRACK123456"
//   webhook
Функция ЭтоТест()
	//Возврат Истина;
	Возврат Ложь ;
КонецФункции 

Функция СерверМобильногоПриложения(Тест=Ложь)
	Если Тест Тогда 
		Возврат "test";
	КонецЕсли;
	Возврат "prod";
КонецФункции	

Функция АдресИнтеграции(Версия = "v1",Тест=Ложь)
	Возврат "/api/"+Версия+"/webhooks/";
КонецФункции	

Функция ТаймАут()
	Возврат 10;
КонецФункции 
Функция МаксПопыток()
	Возврат 3;
КонецФункции 


//Авторизация в API Яндекс.Доставки выполняется заголовком Authorization с OAuth-токеном корпоративного аккаунта, 
//выданным заказчику после регистрации в кабинете dostavka.yandex.kz. 
Функция ТокенИнтеграции(Тест=Ложь)
	Если Тест Тогда 
		Возврат "Bearer <token>";
	КонецЕсли;
	
	Возврат "Bearer <token>";
КонецФункции

Асинх Функция  ЗапросВМобильноеПриложение(Версия ="v1",ИмяМетода,СтруктураЗапроса)
     
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    // Настройка HTTP-запроса
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Authorization", "Bearer " +  ТокенИнтеграции(ЭтоТест()));
    Заголовки.Вставить("Content-Type", "application/json");
    Заголовки.Вставить("Accept-Language", "ru-RU"); 
    Таймаут = ТаймАут();
	HTTPСоединение = Новый HTTPСоединение(СерверМобильногоПриложения(), 443, , , , Таймаут, Новый ЗащищенноеСоединениеOpenSSL);
	МаксПопыток = МаксПопыток();
    Для НомерПопытки = 1 По МаксПопыток Цикл
        Попытка
		    HTTPЗапрос = Новый HTTPЗапрос(АдресИнтеграции(Версия,ЭтоТест()) + ИмяМетода, Заголовки);
		    HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
            Обещание = HTTPСоединение.ОтправитьДляОбработкиАсинх(HTTPЗапрос);
            HTTPОтвет = Ждать Обещание;

            Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
                Возврат HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
            ИначеЕсли HTTPОтвет.КодСостояния >= 500 Тогда
              // Серверная ошибка — можно повторить
                Если НомерПопытки < МаксПопыток Тогда
                    Ждать Таймаут; // пауза
                    Продолжить;
                КонецЕсли;
            Иначе
              // Бизнес‑ошибка (4xx) — не повторяем
                ВызватьИсключение "Ошибка API: " + HTTPОтвет.КодСостояния + ". Ответ: " + HTTPОтвет.ПолучитьТелоКакСтроку();
            КонецЕсли;
        Исключение
  	          // Сетевая ошибка (таймаут, разрыв) — можно повторить
            Если НомерПопытки < МаксПопыток Тогда
                Ждать 3;
                Продолжить;
            КонецЕсли;
        КонецПопытки;
    КонецЦикла;
    //ВызватьИсключение "Превышено число попыток.";    
	Сообщить("Превышено число попыток.");
КонецФункции



