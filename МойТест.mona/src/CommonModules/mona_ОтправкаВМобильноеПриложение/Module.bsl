
&НаСервере
Процедура ОтправитьСтатусЗаказа(Заказ) Экспорт
	
	Запись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
	Запись.Заказ = Заказ;
	Запись.Прочитать(); 
	
	Данные = Новый Структура;
	Данные.Вставить("id",              Строка(Запись.order_id));              // ID заказа в 1С ?? можно сравнить с uuid
	Данные.Вставить("external_id",     Строка(Запись.order_number));         // ID заказа в Laravel
	Данные.Вставить("status",          ПолучитьСтатусДляПриложения(Строка(Заказ.СостояниеЗаказа)));                // Текущий статус
	//Данные.Вставить("status",          СтатусыДляПриложения[Заказ.СостояниеЗаказа]);                // Текущий статус
	СтрокаДаты = Формат(ТекущаяДатаСеанса(), "ДФ=ГГГГ-ММ-ДД") + "T" + Формат(ТекущаяДатаСеанса(), "ДФ=ЧЧ:ММ:СС")+"Z";// Текущий статус
	Данные.Вставить("updated_at",    СтрокаДаты  ); // Момент смены статуса
	Данные.Вставить("tracking_number", Запись.claim_id); // Номер отслеживания 
	Данные.Вставить("reason",          Запись.ПричинаОтмены); // Причина отмены
	
	JSONСтрока = СформироватьJSON(Данные);
	
	АдресСервера = Константы.URL_МП.Получить(); 
		
	Токен = Константы.ТокенДляВебхука.Получить();
		
	Если Не ЗначениеЗаполнено(АдресСервера) Или Не ЗначениеЗаполнено(Токен) Тогда
		ЗаписьЖурналаРегистрации("Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
			"Не заполнены настройки вебхука (URL или токен)");
		Возврат;
	КонецЕсли;
	
	
	Результат = ОтправитьPOSTЗапрос(АдресСервера, "/api/v1/webhooks/order-status", JSONСтрока, Токен);
	
	
	Если Результат.Успех Тогда
		ЗаписьЖурналаРегистрации("Успех", УровеньЖурналаРегистрации.Информация, , , 
			СтрШаблон("Статус заказа %1 отправлен. Код ответа: %2", 
				Заказ.Номер, Результат.КодСостояния));
	Иначе
		ЗаписьЖурналаРегистрации("Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
			СтрШаблон("Ошибка отправки статуса заказа %1. Код: %2. Текст: %3", 
				Заказ.Номер, Результат.КодСостояния, Результат.ТекстОшибки));
		
				
			Если Результат.КодСостояния = 404 Тогда
			
			ЗаписьЖурналаРегистрации("Критично", УровеньЖурналаРегистрации.Ошибка, , , 
				"Заказ не найден на сервере. Возможно, не синхронизирован.");
		
		ИначеЕсли Результат.КодСостояния = 400 Тогда
			// Ошибка валидации — нужно проверить данные
			ЗаписьЖурналаРегистрации("Критично", УровеньЖурналаРегистрации.Ошибка, , , 
				"Ошибка валидации: " + Результат.ТекстОшибки);
		
		ИначеЕсли Результат.КодСостояния >= 500 Тогда
			// Ошибка на сервере — можно попробовать повторно через некоторое время
			ЗаписьЖурналаРегистрации("Предупреждение", УровеньЖурналаРегистрации.Предупреждение, , , 
				"Ошибка сервера (5xx). Нужно повторить позже.");
		КонецЕсли;
	КонецЕсли;
	
	Сообщить("Смена статуса отправлена в МП" + JSONСтрока);
	
КонецПроцедуры

&НаСервере
