			СтрШаблон("Ошибка отправки статуса заказа %1. Код: %2. Текст: %3", 
				Заказ.Номер, Результат.КодСостояния, Результат.ТекстОшибки));
		
				
			Если Результат.КодСостояния = 404 Тогда
			
			ЗаписьЖурналаРегистрации("Критично", УровеньЖурналаРегистрации.Ошибка, , , 
				"Заказ не найден на сервере. Возможно, не синхронизирован.");
		
		ИначеЕсли Результат.КодСостояния = 400 Тогда
			// Ошибка валидации — нужно проверить данные
			ЗаписьЖурналаРегистрации("Критично", УровеньЖурналаРегистрации.Ошибка, , , 
