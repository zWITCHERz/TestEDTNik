	ЗаписьЗаказа.Заказ = Заказ;
	ЗаписьЗаказа.Прочитать(); 

 
	ДанныеЗаказа = mona_ОбработкаИнтернетЗаказа.ПрочитатьJSONизХранилища(Запись.КодJSON);
		
	Данные = Новый Структура;
	Данные.Вставить("id",              Строка(ЗаписьЗаказа.order_id));              // ID заказа в 1С ?? наш uuid
	Данные.Вставить("external_id",     Строка(ЗаписьЗаказа.order_number));         // ID заказа в Laravel

	refund = новый структура;
