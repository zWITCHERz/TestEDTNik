Функция СформироватьJSON(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();        
	ЗаписатьJSON(ЗаписьJSON, Данные);   
	СтрокаJSON = ЗаписьJSON.Закрыть();    
	
	Возврат СтрокаJSON;	
КонецФункции 
&НаСервере
Функция ПолучитьСтатусДляПриложения(Статус) Экспорт
		
	СтатусВерхнийРегистр = ВРег(Статус);
	
	Если СтатусВерхнийРегистр = "СОЗДАН" или СтатусВерхнийРегистр = "ОЖИДАЕТ ОПЛАТЫ" Тогда
		Возврат "pending";
		
	ИначеЕсли СтатусВерхнийРегистр = "ОПЛАЧЕН" Тогда
		Возврат "confirmed";
		
	ИначеЕсли СтатусВерхнийРегистр = "СБОРКА" Тогда
		Возврат "assembling";
		
	ИначеЕсли СтатусВерхнийРегистр = "СОБРАН" Тогда
		Возврат "assembled";
		
	ИначеЕсли СтатусВерхнийРегистр = "СОБРАН" Тогда
		Возврат "ready_for_pickup";
		
	ИначеЕсли СтатусВерхнийРегистр = "ОТГРУЖЕН" Или 
	          СтатусВерхнийРегистр = "В ПУТИ" Тогда
		Возврат "shipped";
		
	ИначеЕсли СтатусВерхнийРегистр = "ВЫДАН" Тогда
		Возврат "issued";
		
	ИначеЕсли СтатусВерхнийРегистр = "ДОСТАВЛЕН" Тогда
		Возврат "delivered";
		
	ИначеЕсли СтатусВерхнийРегистр = "ОТМЕНЁН" Или 
	          СтатусВерхнийРегистр = "ОТМЕНЕН" Тогда
		Возврат "cancelled";
		
	Иначе
		ЗаписьЖурналаРегистрации("Ошибка маппинга", УровеньЖурналаРегистрации.Ошибка, , , 
			"Неизвестный статус заказа: " + Статус);
		Возврат НЕОПРЕДЕЛЕНО;
	КонецЕсли;
	
КонецФункции

Функция ОтправитьPOSTЗапрос(АдресСервера, ПутьРесурса, ТелоJSON, Токен)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТелоОтвета", "");
	
	Попытка
		
		HTTPСоединение = Новый HTTPСоединение(АдресСервера, 443, , , , , Истина);
		
		
		HTTPЗапрос = Новый HTTPЗапрос(ПутьРесурса);
		HTTPЗапрос.Метод = "POST";
		
		HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
				
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);
		
		HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод(HTTPЗапрос);
		
		Результат.КодСостояния = HTTPОтвет.КодСостояния;
		
		Если HTTPОтвет.ПолучитьТелоКакДвоичныеДанные() <> Неопределено Тогда
			Результат.ТелоОтвета = ПолучитьСтрокуИзДвоичныхДанных(
				HTTPОтвет.ПолучитьТелоКакДвоичныеДанные(), 
				КодировкаТекста.UTF8
			);
		КонецЕсли;
		
		Результат.Успех = (HTTPОтвет.КодСостояния = 200);
		
		Если Не Результат.Успех Тогда
			Результат.ТекстОшибки = СтрШаблон("Код %1. Ответ: %2", 
				HTTPОтвет.КодСостояния, Результат.ТелоОтвета);
		КонецЕсли;
		
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.КодСостояния = 0;
		Результат.Успех = Ложь;
		
		ЗаписьЖурналаРегистрации("Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
			"Сетевая ошибка при отправке: " + Результат.ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

