Функция ПроверкаВеса(Заказ)Экспорт 
	Точность =  Константы["mona_ТочностьОбщая"].Получить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЧекККМ.Заказ КАК Заказ,
	|	ЧекККМ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.Заказ = &Заказ
	|	И ЧекККМ.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("Заказ",Заказ);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПервичныйЧек = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	Попытка  
		ТЧПервичныйЧек = ПервичныйЧек.запасы;
		
		ТЧТекущийЗаказ = Заказ.Запасы; 
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ПервичныйЧек = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;
		
		ТаблицаСравнения = Новый ТаблицаЗначений;
		ТаблицаСравнения.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаСравнения.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		
		Для каждого СтрокаЧека Из ТЧПервичныйЧек Цикл
			НоваяСтрока = ТаблицаСравнения.Добавить();
			НоваяСтрока.Номенклатура = СтрокаЧека.Номенклатура;
			НоваяСтрока.Количество = СтрокаЧека.Количество;
		КонецЦикла;
		
		Для каждого СтрокаЗаказа Из ТЧТекущийЗаказ Цикл
			НоваяСтрока = ТаблицаСравнения.Добавить();
			НоваяСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
			НоваяСтрока.Количество = -СтрокаЗаказа.КоличествоСобрано;
		КонецЦикла;
		
		ТаблицаСравнения.Свернуть("Номенклатура", "Количество");
		Результат = новый структура;
		ТаблицаТоваров = Новый ТаблицаЗначений;
		ТаблицаТоваров.Колонки.Добавить("Номенклатура");
		ТаблицаТоваров.Колонки.Добавить("Количество");
		ПустаяСтуктура =  новый структура;
		
		Для каждого стр из ТаблицаСравнения цикл
			Если стр.Количество < 0 тогда
				Отбор = Новый Структура("Номенклатура", стр.Номенклатура);
				//Точность = стр.Номенклатура.mona_Точность/100;
				СтрПЧ = ТЧПервичныйЧек.НайтиСтроки(Отбор); 
				Если СтрПЧ.Количество() = 0 Тогда
					Сообщить("Отсутствует в чеке: "+стр.Номенклатура); 
					Продолжить;
				КонецЕсли;	 
				Если -стр.Количество > СтрПЧ[0].Количество*Точность/100 тогда
					Результат.Вставить("Действие","Блокировка")  ;
					Результат.Вставить("Номенклатура",стр.Номенклатура) ;			 
					Возврат Результат
				иначе
					Результат.Вставить("Действие","Списание");
					НоваяСтрока = ТаблицаТоваров.Добавить();
					НоваяСтрока.Номенклатура = стр.Номенклатура;
					НоваяСтрока.Количество = стр.Количество;
							Возврат Неопределено;
					конецесли;     
			конецесли;
		конеццикла;
		Результат.Вставить("Товары", ТаблицаТоваров);
		СоздатьСписание(Результат,Заказ) ;
	исключение
	конецпопытки;
конецфункции 

