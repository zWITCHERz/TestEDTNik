Функция СоздатьЧекНаВозвратНаСервере(Заказ,ПервичныйЧек=Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЧекККМ.Заказ КАК Заказ,
	|	ЧекККМ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.Заказ = &Заказ
	|	И ЧекККМ.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("Заказ",Заказ);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПервичныйЧек = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЧекККМВозврат.Ссылка КАК Ссылка,
	|	ЧекККМВозврат.Заказ КАК Заказ
	|ИЗ
	|	Документ.ЧекККМВозврат КАК ЧекККМВозврат
	|ГДЕ
	|	ЧекККМВозврат.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ",Заказ);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СуществуетЧекВозврата = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	
	
	Попытка
		Если ПервичныйЧек <> Неопределено и СуществуетЧекВозврата = Неопределено тогда
			ЧекККМВозврат = Документы.ЧекККМВозврат.СоздатьДокумент();
			ЧекККМВозврат.Дата= текущаядата();
			ЧекККМВозврат.Заполнить(ПервичныйЧек);  
			ЧекККМВозврат.ЕстьЗаказы = Истина;
			
			ТЧПервичныйЧек = ПервичныйЧек.запасы;
			
			ТЧТекущийЗаказ = Заказ.Запасы; 
			
			ЧекККМВозврат.Заказ = ПервичныйЧек.Заказ;
			ЧекККМВозврат.Контрагент =Заказ.Контрагент;
			ЧекККМВозврат.ЧекККМ = ПервичныйЧек.Ссылка;
			ЧекККМВозврат.Договор = ПервичныйЧек.Договор; 
			ЧекККМВозврат.ОперацияСДенежнымиСредствами = истина;
			ЧекККМВозврат.СуммаДокумента = ПервичныйЧек.СуммаДокумента;
			ЧекККМВозврат.ДвиженияПоЗапасамУдалять = ПервичныйЧек.ДвиженияПоЗапасамУдалять;
			
			ТЧВозврата = ЧекККМВозврат.Запасы;  
			
			ТаблицаСравнения = Новый ТаблицаЗначений;
			ТаблицаСравнения.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
			ТаблицаСравнения.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
			ТаблицаСравнения.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
			ТаблицаСравнения.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
			ТаблицаСравнения.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
			
			Для каждого СтрокаЧека Из ТЧПервичныйЧек Цикл
				НоваяСтрока = ТаблицаСравнения.Добавить();
				НоваяСтрока.Номенклатура = СтрокаЧека.Номенклатура;
				НоваяСтрока.Количество = СтрокаЧека.Количество;
				НоваяСтрока.СтавкаНДС = СтрокаЧека.СтавкаНДС;
				НоваяСтрока.СуммаНДС = СтрокаЧека.СуммаНДС;
				НоваяСтрока.Цена = СтрокаЧека.Цена;
			КонецЦикла;
			
			Для каждого СтрокаЗаказа Из ТЧТекущийЗаказ Цикл
				НоваяСтрока = ТаблицаСравнения.Добавить();
				НоваяСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
				НоваяСтрока.Количество = -СтрокаЗаказа.Количество;
				НоваяСтрока.СтавкаНДС = СтрокаЗаказа.СтавкаНДС;
				НоваяСтрока.СуммаНДС = -СтрокаЗаказа.СуммаНДС;
				НоваяСтрока.Цена = 0;
			КонецЦикла;
			
			ТаблицаСравнения.Свернуть("Номенклатура,СтавкаНДС", "Количество,Цена,СуммаНДС");
			
			ТЧВозврата.Очистить();
			СуммаДокумента = 0;
			Для каждого СтрокаИтог Из ТаблицаСравнения Цикл
				Если СтрокаИтог.Количество > 0 Тогда
					НоваяСтрокаВозврата = ТЧВозврата.Добавить();
					НоваяСтрокаВозврата.Номенклатура = СтрокаИтог.Номенклатура;
					НоваяСтрокаВозврата.Количество = СтрокаИтог.Количество;
					
					СтрокаЧека = ТЧПервичныйЧек.Найти(СтрокаИтог.Номенклатура, "Номенклатура");
					Если СтрокаЧека <> Неопределено Тогда
						НоваяСтрокаВозврата.Цена = СтрокаЧека.Цена;
						НоваяСтрокаВозврата.Сумма = СтрокаИтог.Количество * СтрокаЧека.Цена;
						НоваяСтрокаВозврата.Цена = СтрокаИтог.Цена;
						НоваяСтрокаВозврата.СтавкаНДС = СтрокаИтог.СтавкаНДС;
						НоваяСтрокаВозврата.СуммаНДС = СтрокаИтог.СуммаНДС;
						НоваяСтрокаВозврата.Сумма = Окр((СтрокаИтог.Количество * СтрокаИтог.Цена),0,1);
						НоваяСтрокаВозврата.Всего = НоваяСтрокаВозврата.Сумма;
						СуммаДокумента = СуммаДокумента + НоваяСтрокаВозврата.Сумма;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			ЧекККМВозврат.СуммаДокумента = СуммаДокумента; 
			ВыгруженныеДанные = ПервичныйЧек["БезналичнаяОплата"].Выгрузить();
			ЧекККМВозврат["БезналичнаяОплата"].Загрузить(ВыгруженныеДанные);
			для каждого стр из ЧекККМВозврат.БезналичнаяОплата цикл
				стр.Сумма = СуммаДокумента;
			конеццикла;   
			
			Если ЧекККМВозврат.Запасы.Количество() >0 тогда
				ЧекККМВозврат.Записать(РежимЗаписиДокумента.Проведение);
