&НаСервере
Процедура ФормированиеВозврата(Заказ) Экспорт
		 ПервичныеДанныеЗаказа = mona_ОбработкаИнтернетЗаказа.ПолучитьТоварыИзJSON(Заказ);
        	 
    	 ТЧПервичныйЧек = ПервичныеДанныеЗаказа;
    	 
    	 ТЧТекущийЗаказ = Заказ.Запасы;  
		 
    	 ТаблицаСравнения = Новый ТаблицаЗначений;
    	 ТаблицаСравнения.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    	 ТаблицаСравнения.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
    	 ТаблицаСравнения.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
    	 ТаблицаСравнения.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
    	 
    	 Для каждого СтрокаЧека Из ТЧПервичныйЧек Цикл
    		 НоваяСтрока = ТаблицаСравнения.Добавить();
    		 НоваяСтрока.Номенклатура = СтрокаЧека.Номенклатура;
    		 НоваяСтрока.Количество = СтрокаЧека.Количество; 
    		 НоваяСтрока.СуммаНДС = СтрокаЧека.СуммаНДС;
    		 НоваяСтрока.Цена = СтрокаЧека.Цена;
    	 КонецЦикла;
    	 
    	 Для каждого СтрокаЗаказа Из ТЧТекущийЗаказ Цикл
    		 НоваяСтрока = ТаблицаСравнения.Добавить();
    		 НоваяСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
    		 НоваяСтрока.Количество = -СтрокаЗаказа.Количество;
    		 НоваяСтрока.СуммаНДС = -СтрокаЗаказа.СуммаНДС;
    		 НоваяСтрока.Цена = 0;
    	 КонецЦикла;
    	 
    	 ТаблицаСравнения.Свернуть("Номенклатура", "Количество,Цена,СуммаНДС");
    	 
       	СуммаВозврата = 0; 
		МенеджерЗаписи = РегистрыСведений.mona_Возвраты.СоздатьМенеджерЗаписи(); 
		
		ТипВозврата = "";
		
		Запрос = Новый Запрос;
	 		Запрос.Текст = "ВЫБРАТЬ
	                |	ЗаказыОнлайн.ПричинаОтмены КАК ПричинаОтмены,
	                |	ЗаказыОнлайн.ПризнакОтложенногоВозврата КАК ПризнакОтложенногоВозврата,
	                |	ЗаказыОнлайн.tiptoppay_id КАК tiptoppay_id
	                |ИЗ
	                |	РегистрСведений.ЗаказыОнлайн КАК ЗаказыОнлайн
	                |ГДЕ
	                |	ЗаказыОнлайн.Заказ = &Заказ";  
	 		Запрос.УстановитьПараметр("Заказ", Заказ); 
	 		
	 		для каждого стр из Заказ.ОтмененныеЗапасы цикл
	 		     ТипВозврата = ТипВозврата +стр.mona_ТипВозврата.Наименование+"; "; 
	 		конеццикла;
	 		МенеджерЗаписи.ТипВозврата   =  ТипВозврата; 
	 Выборка = Запрос.Выполнить().Выбрать();
	 Если Выборка.Следующий() Тогда
		 	МенеджерЗаписи.ПризнакОтложенногоВозврата		   =  Выборка.ПризнакОтложенногоВозврата; 
		 	МенеджерЗаписи.tiptoppay_id   		   =  Выборка.tiptoppay_id;
	 КонецЕсли;
	 
		   Для каждого стр из ТаблицаСравнения цикл
		    СуммаВозврата = СуммаВозврата+(стр.Цена*стр.Количество);   
		   конеццикла;
		  	МенеджерЗаписи.Заказ = Заказ; 
			МенеджерЗаписи.СоставВозвратаJSON = ТаблицаСравнения;
			МенеджерЗаписи.СуммаВозврата = СуммаВозврата; 
			МенеджерЗаписи.Записать(Ложь);
	КонецПроцедуры


&НаСервере
Процедура ЧекКФискализации(СсылкаЗаказа,Чек = Неопределено) Экспорт
	МенеджерЧтения = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
	МенеджерЧтения.Заказ = СсылкаЗаказа;
	МенеджерЧтения.Прочитать();     
	МенеджерЧтения.ПробитьЧек = Истина;     
	МенеджерЧтения.Записать();
КонецПроцедуры

&НаСервере	
Функция НайтиСерииНоменклатуры(Номенклатура,Количество);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СерииНоменклатурыОстатки.Серия КАК Серия,
	|	СерииНоменклатурыОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	СерииНоменклатурыОстатки.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.СерииНоменклатуры.Остатки КАК СерииНоменклатурыОстатки
	|ГДЕ
	|	СерииНоменклатурыОстатки.Серия.Продан = &Ложь
	|
	|УПОРЯДОЧИТЬ ПО
	|	СерииНоменклатурыОстатки.Серия.ГоденДо";
	
	
	запрос.УстановитьПараметр("Ложь",ложь);
	Результат = Запрос.Выполнить().Выбрать();
	
	НужноеКоличество = Количество;
	НабранныеСерии = Новый Массив;
	
	Пока Результат.Следующий() И НужноеКоличество > 0 Цикл
		КоличествоВСерии = Результат.КоличествоОстаток;
		Если КоличествоВСерии >= НужноеКоличество Тогда
			СтруктураСерии = Новый Структура("Серия, Количество", Результат.Серия, НужноеКоличество);
			НабранныеСерии.Добавить(СтруктураСерии);
			НужноеКоличество = 0;
		Иначе
			СтруктураСерии = Новый Структура("Серия, Количество", Результат.Серия, КоличествоВСерии);
			НабранныеСерии.Добавить(СтруктураСерии);
			НужноеКоличество = НужноеКоличество - КоличествоВСерии;
		КонецЕсли;
	КонецЦикла;
	
	Если НужноеКоличество > 0 Тогда
		Сообщить("НехватилоСерии!"); 
	КонецЕсли;
	Возврат НабранныеСерии;
конецфункции

&НаСервере
Функция НайтиИлиСоздатьКонтрагента(ДанныеКонтрагента)
	
	Результат = Новый Структура("Контрагент,Телефон,Email,ФИО");
	Результат.Телефон = ДанныеКонтрагента.phone;
	Результат.Email = ДанныеКонтрагента.email;
	Результат.ФИО = ДанныеКонтрагента.last_name + "" +ДанныеКонтрагента.first_name;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Ссылка 
	|ИЗ
	|	Справочник.Контрагенты 
	|ГДЕ " + ?(ПустаяСтрока(Результат.Телефон),
