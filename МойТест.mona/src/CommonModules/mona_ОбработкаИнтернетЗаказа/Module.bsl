&НаСервере
Процедура СоздатьСписание(Структура,Заказ) Экспорт 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПеремещениеЗапасов.ДокументОснование КАК ДокументОснование,
		|	ПеремещениеЗапасов.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПеремещениеЗапасов КАК ПеремещениеЗапасов
		|ГДЕ
		|	ПеремещениеЗапасов.ДокументОснование = &Заказ
		|	И ПеремещениеЗапасов.Проведен = &ИСТИНА";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ИСТИНА", ИСТИНА);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() тогда
		
		СозданоСписание = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
      Если СозданоСписание = Неопределено тогда
	Списание= Документы.ПеремещениеЗапасов.СоздатьДокумент();
	Списание.ЗаполнитьПоЗаказуПокупателя(Заказ);
	Списание.СтруктурнаяЕдиница =  заказ.СтруктурнаяЕдиницаРезерв;
	Списание.ХозяйственнаяОперация=Справочники.ХозяйственныеОперации.СписаниеНаРасходы;
	Списание.Дата = ТекущаяДата();
	Списание.ВидОперации = Перечисления.ВидыОперацийПеремещениеЗапасов.СписаниеНаРасходы;
	
	Списание.СчетЗатрат = ПланыСчетов.Управленческий.РасходыПоРеализацииПродукцииИОказаниюУслуг;
	Списание.Запасы.Очистить(); 
	
	Для каждого Стр из Структура.Товары цикл
		СтрЗапасы = Списание.Запасы.Добавить();
		СтрЗапасы.Номенклатура = Стр.Номенклатура;
		СтрЗапасы.Количество = -Стр.Количество;
		СтрЗапасы.ЗаказПокупателя = заказ;
		СтруктураДанные = Новый Структура();
		СтруктураДанные.Вставить("ВидОперации", Заказ.ВидОперации);
		СтруктураДанные.Вставить("Организация", Заказ.Организация);
		СтруктураДанные.Вставить("Номенклатура", СтрЗапасы.Номенклатура);
		
		СерииНоменклатурыУНФКлиентСервер.ДополнитьСтруктуруДаннымиДляПолученияСерийНоменклатуры(Заказ, СтруктураДанные);
		СтруктураДанные = ПолучитьДанныеНоменклатураПриИзменении(СтруктураДанные);
	
		СтрЗапасы.ЕдиницаИзмерения = СтруктураДанные.ЕдиницаИзмерения;
		СтрЗапасы.СтранаПроисхождения = СтруктураДанные.СтранаПроисхождения;
		СтрЗапасы.НомерГТД = Неопределено;
		СтрЗапасы.Вес = СтруктураДанные.ВесЕдиницыТовара * СтрЗапасы.Количество;
		СтрЗапасы.Объем = СтруктураДанные.ОбъемЕдиницыТовара *СтрЗапасы.Количество;

		
	конеццикла;
	
	Списание.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
КонецПроцедуры


&НаСервере
Функция ПолучитьДанныеНоменклатураПриИзменении(СтруктураДанные)
	
	Реквизиты = Новый Массив;
	Реквизиты.Добавить("ЕдиницаИзмерения");
	Реквизиты.Добавить("СтранаПроисхождения");
	Реквизиты.Добавить("СчетУчетаЗатрат");
	Реквизиты.Добавить("ЭтоНабор");
	Реквизиты.Добавить("ИспользоватьХарактеристики");
	Реквизиты.Добавить("ПроверятьЗаполнениеХарактеристики");
	Реквизиты.Добавить("ИспользоватьПартии");
	Реквизиты.Добавить("ПроверятьЗаполнениеПартий");
	Реквизиты.Добавить("ИспользоватьСерииНоменклатуры");
	Реквизиты.Добавить("ПрослеживаемыйТовар");
	Реквизиты.Добавить("ПрослеживаемыйКомплект");
	Реквизиты.Добавить("ТипНоменклатуры");
	Реквизиты.Добавить("Вес");
	Реквизиты.Добавить("Объем");
	Реквизиты.Добавить("ЗапретитьВводДробногоКоличества");
	ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанные.Номенклатура, Реквизиты);
	
	СтруктураДанные.Вставить("ЕдиницаИзмерения", ЗначенияРеквизитовНоменклатуры.ЕдиницаИзмерения);
	СтруктураДанные.Вставить("СтранаПроисхождения", ЗначенияРеквизитовНоменклатуры.СтранаПроисхождения);
	ТипСчетаЗатрат = Перечисления.ТипыСчетов.ПустаяСсылка();
	Если ЗначениеЗаполнено(ЗначенияРеквизитовНоменклатуры.СчетУчетаЗатрат) Тогда
		ТипСчетаЗатрат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначенияРеквизитовНоменклатуры.СчетУчетаЗатрат,
		"ТипСчета");
	КонецЕсли;

	СтруктураДанные.Вставить("ТипСчетаЗатрат", ТипСчетаЗатрат);
	СтруктураДанные.Вставить("НомерГТД", Неопределено);
	
	// Наборы
	СтруктураДанные.Вставить("ЭтоНабор", ЗначенияРеквизитовНоменклатуры.ЭтоНабор);
	
	// Характеристики
	СтруктураДанные.Вставить("ИспользоватьХарактеристики", Ложь);
	СтруктураДанные.Вставить("ПроверятьЗаполнениеХарактеристики", Ложь);
	
	Если ЗначениеЗаполнено(СтруктураДанные.Номенклатура) Тогда
		СтруктураДанные.ИспользоватьХарактеристики = ЗначенияРеквизитовНоменклатуры.ИспользоватьХарактеристики;
		СтруктураДанные.ПроверятьЗаполнениеХарактеристики = ЗначенияРеквизитовНоменклатуры.ПроверятьЗаполнениеХарактеристики;
	КонецЕсли;
	
	Если СтруктураДанные.ИспользоватьХарактеристики Тогда
		ЗначенияПоУмолчанию = НоменклатураВДокументахСервер.ЗначенияНоменклатурыПоУмолчанию(
			СтруктураДанные.Номенклатура);
		
		Если Не ЗначенияПоУмолчанию = Неопределено Тогда
			ХарактеристикаПоУмолчанию = ЗначенияПоУмолчанию;
		КонецЕсли;
		
		Если Не СтруктураДанные.Свойство("Характеристика") Тогда
			СтруктураДанные.Вставить("Характеристика", ХарактеристикаПоУмолчанию);
		Иначе
			СтруктураДанные.Характеристика = ?(ЗначениеЗаполнено(СтруктураДанные.Характеристика),
				СтруктураДанные.Характеристика, ХарактеристикаПоУмолчанию);
		КонецЕсли;
		
	КонецЕсли; 
	// Конец Характеристики
	
	//Партии
	СтруктураДанные.Вставить("ИспользоватьПартии", Ложь);
	СтруктураДанные.Вставить("ПроверятьЗаполнениеПартий", Ложь);
	
	Если ЗначениеЗаполнено(СтруктураДанные.Номенклатура) Тогда
		СтруктураДанные.ИспользоватьПартии = ЗначенияРеквизитовНоменклатуры.ИспользоватьПартии;
		СтруктураДанные.ПроверятьЗаполнениеПартий = ЗначенияРеквизитовНоменклатуры.ПроверятьЗаполнениеПартий;
	КонецЕсли;
	
	Если НЕ СтруктураДанные.Свойство("Партия") Тогда
		СтруктураДанные.Вставить("Партия", Неопределено);
	КонецЕсли;
	
	Если СтруктураДанные.ИспользоватьПартии Тогда
		
		Если СтруктураДанные.Свойство("СтатусПартии")
			Тогда
			ЗначенияПартииПоУмолчанию = НоменклатураВДокументахСервер.ЗначенияПартийНоменклатурыПоУмолчанию(
				СтруктураДанные.Номенклатура, СтруктураДанные.СтатусПартии);
		Иначе
			Если Не СтруктураДанные.Свойство("ВидОперации")
				Тогда
				ВидОперации = Неопределено
			Иначе
				ВидОперации = СтруктураДанные.ВидОперации
			КонецЕсли;
			
			СтатусПартии = НоменклатураВДокументахСервер.СоответствиеВидаОперацииИлиХозОперацииСтатусуПартии( ,
				ВидОперации);
			ЗначенияПартииПоУмолчанию = НоменклатураВДокументахСервер.ЗначенияПартийНоменклатурыПоУмолчанию(
				СтруктураДанные.Номенклатура, СтатусПартии);
		КонецЕсли;
		
		ПартияПоУмолчанию = Справочники.ПартииНоменклатуры.ПустаяСсылка();
		
		Если Не ЗначенияПартииПоУмолчанию = Неопределено
			Тогда
			ПартияПоУмолчанию = ЗначенияПартииПоУмолчанию;
		КонецЕсли;
		
		СтруктураДанные.Партия = ?(ЗначениеЗаполнено(СтруктураДанные.Партия), СтруктураДанные.Партия, ПартияПоУмолчанию);
		
	КонецЕсли;
	// Конец Партии
	
	Если ЗначениеЗаполнено(СтруктураДанные.Номенклатура)
		И ЗначенияРеквизитовНоменклатуры.ИспользоватьСерииНоменклатуры Тогда
		
		СтатусПодбораСерий = СерииНоменклатурыУНФ.СтатусСерийНоменклатурыПриИзменении(СтруктураДанные);
		
		Если СтатусПодбораСерий = 0 И СтруктураДанные.Свойство("ПараметрыПодбораСтатуса") Тогда
			СтруктураДанные.ПараметрыПодбораСтатуса.СтруктурнаяЕдиница = СтруктураДанные.ПараметрыПодбораСтатуса.СтруктурнаяЕдиницаПолучатель;
			СтатусПодбораСерий = СерииНоменклатурыУНФ.СтатусСерийНоменклатурыПриИзменении(СтруктураДанные);
		КонецЕсли;
		
		СтруктураДанные.Вставить("СтатусыСерийНоменклатуры", СтатусПодбораСерий);
		
	Иначе
		СтруктураДанные.Вставить("СтатусыСерийНоменклатуры", 0);
	КонецЕсли;
	
	Если СтруктураДанные.ВидОперации = Перечисления.ВидыОперацийПеремещениеЗапасов.СписаниеНаРасходы
		ИЛИ СтруктураДанные.ВидОперации = Перечисления.ВидыОперацийПеремещениеЗапасов.ВозвратИзЭксплуатации Тогда
		
		ГрузовыеТаможенныеДекларацииСервер.АвтоматическийПодборВРеализацииНомераГТД(СтруктураДанные);
		
	КонецЕсли;
	
	СтруктураДанные.Вставить("ТипНоменклатуры", ЗначенияРеквизитовНоменклатуры.ТипНоменклатуры);
	
	// Прослеживаемость
	ЭтоПрослеживаемыйТовар = Ложь;
	Если ТипЗнч(ЗначенияРеквизитовНоменклатуры.ПрослеживаемыйТовар) = Тип("Булево") Тогда
		ЭтоПрослеживаемыйТовар = ЗначенияРеквизитовНоменклатуры.ПрослеживаемыйТовар;
	КонецЕсли;
	СтруктураДанные.Вставить("ПрослеживаемыйТовар", ЭтоПрослеживаемыйТовар
		И ЗначенияРеквизитовНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас);
	ЭтоПрослеживаемыйКомплект = Ложь;
	Если ТипЗнч(ЗначенияРеквизитовНоменклатуры.ПрослеживаемыйКомплект) = Тип("Булево") Тогда
		ЭтоПрослеживаемыйКомплект = ЗначенияРеквизитовНоменклатуры.ПрослеживаемыйКомплект;
	КонецЕсли;
	СтруктураДанные.Вставить("ПрослеживаемыйКомплект", ЭтоПрослеживаемыйКомплект
		И ЗначенияРеквизитовНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас);
	Если СтруктураДанные.ПрослеживаемыйТовар 
		И ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		СтруктураДанные.Вставить("НомерГТД", Неопределено);
	КонецЕсли; 
	// Конец Прослеживаемость

	СтруктураДанные.Вставить("ВесЕдиницыТовара", ЗначенияРеквизитовНоменклатуры.Вес);
	СтруктураДанные.Вставить("ОбъемЕдиницыТовара", ЗначенияРеквизитовНоменклатуры.Объем);
	
	СтруктураДанные.Вставить("ЗапретитьВводДробногоКоличества",
		ЗначенияРеквизитовНоменклатуры.ЗапретитьВводДробногоКоличества);
	
	Возврат СтруктураДанные;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЗаказИзРегистраФоновое(Параметры) Экспорт
	СоздатьЗаказНаСервере(Параметры[0]);
КонецПроцедуры
&НаСервере
Процедура ЗаписатьФормуЗаказаВРегистр(Форма) Экспорт
	
	МенеджерЧтения = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
	МенеджерЧтения.Заказ = Форма.Объект.Ссылка;
	МенеджерЧтения.Прочитать();                                                       
	
	Если НЕ МенеджерЧтения.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЧтения.ХолоднаяЧастьСобрана              = Форма["ХолоднаяЧастьСобрана"];     
	МенеджерЧтения.ОтменаДоОтгрузки              	 = Форма["ОтменаДоОтгрузки"];
	МенеджерЧтения.СухаяЧастьСобрана                 = Форма["СухаяЧастьСобрана"];
	МенеджерЧтения.МоментОтмены                      = Форма["МоментОтмены"];
	МенеджерЧтения.ПричинаОтмены                     = Форма["ПричинаОтмены"];
	МенеджерЧтения.ПризнакОтложенногоВозврата 	     = Форма["ПризнакОтложенногоВозврата"];
	МенеджерЧтения.ПризнакЧастичнойСборки            = Форма["ПризнакЧастичнойСборки"]; 
	МенеджерЧтения.ДатаОкончанияПриема               = Форма["ДатаОкончанияПриема"];
	МенеджерЧтения.ЗаказОтменен                      = Форма["ЗаказОтменен"];    
	
	ВСборке = (Форма.Объект.СостояниеЗаказа = mona_СтатусыЗаказов.ВСборке());
	Если ВСборке И Форма["ПризнакЧастичнойСборки"] Тогда
		Если ЗначениеЗаполнено(Форма["ВремяУстановкиЧастичнойСборки"]) Тогда
			МенеджерЧтения.ВремяУстановкиЧастичнойСборки = Форма["ВремяУстановкиЧастичнойСборки"];
		Иначе
			МенеджерЧтения.ВремяУстановкиЧастичнойСборки = ТекущаяДата();
		КонецЕсли;                                                                                           
	Иначе
		МенеджерЧтения.ВремяУстановкиЧастичнойСборки ='00010101';
	КонецЕсли;
	
	МенеджерЧтения.Записать();
КонецПроцедуры
&НаСервере
функция ЗаполнитьФормуЗаказаИзРегистра(Форма) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыОнлайн.ХолоднаяЧастьСобрана КАК ХолоднаяЧастьСобрана,
	               |	ЗаказыОнлайн.СухаяЧастьСобрана КАК СухаяЧастьСобрана,
	               |	ЗаказыОнлайн.ИсточникЗаказа КАК ИсточникЗаказа,
	               |	ЗаказыОнлайн.МоментОтмены КАК МоментОтмены,
	               |	ЗаказыОнлайн.НачалоВременногоИнтервалаДоставки КАК НачалоВременногоИнтервалаДоставки,
	               |	ЗаказыОнлайн.ПричинаОтмены КАК ПричинаОтмены,
	               |	ЗаказыОнлайн.ПризнакОтложенногоВозврата КАК ПризнакОтложенногоВозврата,
	               |	ЗаказыОнлайн.ПризнакЧастичнойСборки КАК ПризнакЧастичнойСборки,
	               |	ЗаказыОнлайн.ДатаОкончанияПриема КАК ДатаОкончанияПриема,
	               |	ЗаказыОнлайн.ВремяУстановкиЧастичнойСборки КАК ВремяУстановкиЧастичнойСборки,
	               |	ЗаказыОнлайн.ОтменаДоОтгрузки КАК ОтменаДоОтгрузки,
	               |	ЗаказыОнлайн.ЗаказОтменен КАК ЗаказОтменен,
	               |	ЗаказыОнлайн.ДатаРешенияОператора КАК ДатаРешенияОператора,
	               |	ЗаказыОнлайн.РешениеОператораПринято КАК РешениеОператораПринято
	               |ИЗ
	               |	РегистрСведений.ЗаказыОнлайн КАК ЗаказыОнлайн
	               |ГДЕ
	               |	ЗаказыОнлайн.Заказ = &Заказ";  
	Запрос.УстановитьПараметр("Заказ", Форма.Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Форма,Выборка);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;  
КонецФункции
Функция ВХран(Владелец,Данные,Ключ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	//ОбщегоНазначения.ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Владелец,Данные,Ключ);
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции  

Функция ИзХран(Владелец,Ключ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Возврат ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Владелец,Ключ);
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции

Функция СкладЦена() Экспорт
    СтруктураВозврата = Новый Структура("Склад,ВидЦен");
	ТочкиОтгрузки = Справочники.mona_ТочкиОтгрузки.Выбрать();
	Если ТочкиОтгрузки.Следующий() Тогда 
		СтруктураВозврата.Склад = ТочкиОтгрузки.Склад;
		СтруктураВозврата.ВидЦен = ТочкиОтгрузки.ВидЦеныОнлайн;
	КонецЕсли;
	Возврат СтруктураВозврата;	
КонецФункции
