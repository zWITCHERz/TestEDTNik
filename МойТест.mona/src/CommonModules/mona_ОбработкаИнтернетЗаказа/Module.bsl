&НаСервере
Процедура СоздатьЗаказНаСервере(Заказ) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ КодJSON ИЗ РегистрСведений.ЗаказыОнлайн ГДЕ Заказ = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если выборка.Следующий() Тогда  
		ДанныеЗаказа = ПрочитатьJSONизХранилища(Выборка.КодJSON);
	КонецЕсли;
	Заказ = Заказ.ПолучитьОбъект(); 
	//	Заказ.Дата = ТекущаяДата();
	//  ТочкаОтгрузки = Справочники.mona_ТочкиОтгрузки.
	Заказ.ДатаОтгрузки = ТекущаяДата();
	Если ДанныеЗаказа.delivery_type = "pickup" Тогда  
		Заказ.ВидЗаказа = ВидЗаказаПВЗ(); 
		Заказ.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	Иначе
		Заказ.ВидЗаказа = ВидЗаказаИнтернет(); 
		Заказ.СпособДоставки = Перечисления.СпособыДоставки.Курьер;
	КонецЕсли;
	
	ЗаполнитьПоТочкеОтгрузки(Заказ);
	Заказ.СостояниеЗаказа = mona_СтатусыЗаказов.Создан();
	Заказ.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу;
	
	Попытка 
		
		СтрКонтрагент = НайтиИлиСоздатьКонтрагента(ДанныеЗаказа.recipient);
		Заказ.Контрагент = СтрКонтрагент.Контрагент;
		Заказ.Телефон = СтрКонтрагент.Телефон;
		Заказ.АдресЭП = СтрКонтрагент.Email; 
		ЗаполнениеОбъектовУНФ.ЗаполнитьДоговорПоУмолчанию(Заказ);
		Если ДанныеЗаказа.Свойство("delivery_address") Тогда
			Заказ.АдресДоставки = ДанныеЗаказа.delivery_address;
			Заказ.Комментарий = ДанныеЗаказа.delivery_comment;
			//Если ДанныеЗаказа.delivery_address.Свойство("coordinates") Тогда
			//	Заказ.Комментарий = Заказ.Комментарий +" "+ ДанныеЗаказа.delivery_address.coordinates;
			//	ТочкаДоставки = ДанныеЗаказа.delivery_address.coordinates;
			//	Заказ.mona_Долгота = ТочкаДоставки.longitude; 
			//	Заказ.mona_Широта = ТочкаДоставки.latitude; 
			//КонецЕсли;
		КонецЕсли;  
		Если Заказ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС Тогда 
			СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.БезНДС);	
		КонецЕсли;  
		Заказ.СтатусСборки = 0;
		Заказ.Запасы.Очистить();
		Заказ.СерииНоменклатуры.Очистить();
		Если ДанныеЗаказа.Свойство("payment_method") Тогда
			Заказ.СпособЗачетаПредоплаты = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто;
		КонецЕсли;     
		СуммаДокумента = 0;
		
		Если ДанныеЗаказа.Свойство("items") Тогда
			Для каждого ТоварJSON Из ДанныеЗаказа.items Цикл
				СтрокаТЧ = Заказ.Запасы.Добавить();
				
				
				Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ТоварJSON.external_product_id));
				//Номенклатура = НайтиНоменклатуру(ТоварJSON.name);
				
				СтрокаТЧ.Номенклатура = Номенклатура;
				СтрокаТЧ.ТипНоменклатурыЗапас = Истина;
				СтрокаТЧ.Количество = ТоварJSON.quantity;
				СтрокаТЧ.КоличествоСобрано = 0;
				СтрокаТЧ.КоличествоСобрано = 0;
				СтрокаТЧ.Резерв = ТоварJSON.quantity;
				СтрокаТЧ.Цена = ТоварJSON.price;
				СтрокаТЧ.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
				СтрокаТЧ.КлючСвязи = СтрокаТЧ.НомерСтроки;
				СтрокаТЧ.Сумма = ТоварJSON.price * ТоварJSON.quantity;
				СтрокаТЧ.СтавкаНДС = СтавкаНДС;
				Если ТоварJSON.Свойство("discount") И ТоварJSON.discount > 0 Тогда
					СтрокаТЧ.СуммаСкидкиНаценки = ТоварJSON.discount;
				Иначе
					СтрокаТЧ.СуммаСкидкиНаценки = 0;
				КонецЕсли; 
				СтрокаТЧ.Всего = СтрокаТЧ.Сумма - СтрокаТЧ.СуммаСкидкиНаценки;
				
				//Серии=НайтиСерииНоменклатуры(Номенклатура,ТоварJSON.quantity);
				
				//Для Каждого СерияИзМассива Из Серии Цикл
				//	СтрокаСерии = Заказ.СерииНоменклатуры.Добавить(); 
				//	СтрокаСерии.КлючСвязи = СтрокаТЧ.НомерСтроки;
				//	СтрокаСерии.Серия = СерияИзМассива.Серия;
				//	СтрокаСерии.Количество = СерияИзМассива.Количество; 
				//	СтрокаСерий = СтрокаТЧ.СерииНоменклатуры + СерияИзМассива.Серия + ",";
				//	СтрокаТЧ.СерииНоменклатуры = Сред(СтрокаСерий,2);
				//КонецЦикла;
				СтрокаТЧ.СтруктурнаяЕдиницаРезерв = Заказ.СтруктурнаяЕдиницаРезерв;
				
				СуммаДокумента = СуммаДокумента + СтрокаТЧ.Всего;	
			КонецЦикла;
		КонецЕсли;
		Если СуммаДокумента <> ДанныеЗаказа.total_price Тогда 
			Сообщить ("Сумма заказа не равна сумме строк");
		КонецЕсли;
		Заказ.СуммаДокумента = СуммаДокумента;
		Заказ.Записать(РежимЗаписиДокумента.Проведение);
		
	Исключение
		Заказ.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
КонецПроцедуры 

