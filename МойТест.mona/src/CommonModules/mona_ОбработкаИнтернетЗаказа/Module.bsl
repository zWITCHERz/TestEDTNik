Функция ЗаполнитьПоТочкеОтгрузки(ДокОбъект) Экспорт
	Если ДокОбъект.ПоложениеСклада <> Перечисления.ПоложениеРеквизитаНаФорме.ВШапке Тогда 
		ДокОбъект.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
	КонецЕсли;	 
	ДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС;
	ДокОбъект.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	ДокОбъект.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	ВалютаКурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокОбъект.ВалютаДокумента, ДокОбъект.Дата);
	ДокОбъект.Курс = ВалютаКурсКратность.Курс;
	ДокОбъект.Кратность = ВалютаКурсКратность.Кратность;
	
	Если ДокОбъект.ВидЗаказа = ВидЗаказаИнтернет() или 
		ДокОбъект.ВидЗаказа = ВидЗаказаИнтернет("ПВЗ") Тогда 
		ТочкиОтгрузки = Справочники.mona_ТочкиОтгрузки.Выбрать();
		Если ТочкиОтгрузки.Следующий() Тогда 
			Если ДокОбъект.СтруктурнаяЕдиницаРезерв <> ТочкиОтгрузки.Склад  Тогда 
				ДокОбъект.СтруктурнаяЕдиницаРезерв = ТочкиОтгрузки.Склад;
			КонецЕсли;
			ДокОбъект.ВидЦен = ТочкиОтгрузки.ВидЦеныОнлайн;
		КонецЕсли;
	КонецЕсли; 
	//Заполнение для Доставки 
	Если ДокОбъект.ВидЗаказа = ВидЗаказаИнтернет() Тогда       
		ДокОбъект.СлужбаДоставки = ТочкиОтгрузки.СлужбаДоставки;  
		ДокОбъект.Грузоотправитель = ДокОбъект.Организация; 
	КонецЕсли;	
КонецФункции


Процедура ЗаполнитьДоставку(ДокОбъект,Самовывоз = Ложь,Результат = Неопределено) Экспорт;
	Сообщение = "";
	Если ДокОбъект.mona_ТочкаОтгрузки.Пустая() Тогда 
    	 ДокОбъект.mona_ТочкаОтгрузки = Справочники.mona_ТочкиОтгрузки.ПоУмолчанию();
	КонецЕсли;
	Если Самовывоз Тогда
		ДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз; 
	// Нужно ли что-то очистить ?	
	Иначе    
		ДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.Курьер; 
		ДокОбъект.СлужбаДоставки = ДокОбъект.mona_ТочкаОтгрузки.СлужбаДоставки;
		ДокОбъект.НоменклатураДоставки = Справочники.Номенклатура.НайтиПоНаименованию("Доставка"); 
		ДокОбъект.СтавкаНДСДоставки = Справочники.СтавкиНДС.СтавкаНДС(ДокОбъект.НоменклатураДоставки.ВидСтавкиНДС);
	// + перерасчет суммы доставки и суммы документа
		Если ДокОбъект.mona_Широта = 0 или ДокОбъект.mona_Долгота = 0 Тогда
			Сообщение = Сообщение + "Не указаны координаты получателя; "; 
		КонецЕсли;
		Если ПустаяСтрока(ДокОбъект.АдресДоставки)  Тогда
			Сообщение = Сообщение + "Не указаны адрес доставки; "; 
		КонецЕсли;
		Если ПустаяСтрока(ДокОбъект.КонтактныйТелефон)  Тогда
			Сообщение = Сообщение + "Не указаны контакный телефон получателя; "; 
		КонецЕсли; 
	КонецЕсли; 
	// Проверить и заполнить остальные поля
	Если Не ПустаяСтрока(Сообщение) Тогда 
		Если Не Результат = Неопределено Тогда 
        	Результат.Сообщение = Сообщение;	
		КонецЕсли;	
		Сообщить(Сообщение);
	КонецЕсли; 
	Возврат;
КонецПроцедуры
