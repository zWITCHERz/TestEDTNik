				//    Заказ,
				//    1,
				//    Заказ.СуммаДокумента);
				//Исключение       
				//    mona_ЖурналОбмена.ЗаписатьСобытие(
				//    Перечисления.mona_ТипСобытийОбмена.ФискальныйЧекПродажи,
				//    Перечисления.mona_НаправлениеОбмена.Исходящее,
				//    Перечисления.mona_Источник.Система,
				//    Перечисления.mona_Источник.Webkassa,
				//    Перечисления.mona_Инициатор.АвтоматическийПроцесс,
				//    "",
				//    Заказ,
				//    Перечисления.mona_Статус.Ошибка,
				//    ОписаниеОшибки(),
				//    1);
				//    КонецПопытки;
			Конецесли; 
		Конецесли;
		
	Исключение 
		ВернутьЧЕК = неопределено;
	конецпопытки;
	Возврат ВернутьЧЕК ;
КонецФункции 

