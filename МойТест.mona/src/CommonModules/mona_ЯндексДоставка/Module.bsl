Асинх Функция claims(Знач Действие, claim_id, СтруктураЗапроса = Неопределено, Знач request_id ="",Результат = Неопределено) Экспорт
	Если Не ПустаяСтрока(request_id) Тогда 
		Действие = Действие + "?request_id="+request_id;
	Иначе
		Действие = Действие + "?claim_id=" + СОКРЛП(claim_id);
	КонецЕсли;
	ОтветСтруктура  = Ждать ЗапросВЯндекс(,"claims/"+Действие,СтруктураЗапроса,Результат);  
	Возврат ОтветСтруктура;
КонецФункции
