//3.3.6.1.	Этап 1 — создание заявки - Момент создания заявки в Яндекс.Доставке зависит от выбранного клиентом временного интервала доставки и определяется автоматически в 1С по следующему правилу. 
//3.3.6.1.1.	Для плановой доставки (основной режим работы) 
//Ø	— заявка создаётся за N часов до начала временного интервала, где N — настраиваемый параметр (по умолчанию 3 часа, окончательное значение определяется на этапе технического проекта). 
//Ø	До момента создания заявки заказ должен находиться в статусе «Собран»; если к этому моменту заказ ещё не собран — оператор онлайн-заказов получает уведомление. 
//3.3.6.1.2.	Для срочной доставки (выбранный временной интервал начинается менее чем через час от текущего времени) — 

//Создание 

//Ø	заявка создаётся немедленно при переходе заказа в статус «Собран». 1С отправляет запрос POST /b2b/cargo/integration/v2/claims/create с указанием полного состава заказа: 
//§	координаты и адрес точки отгрузки (ПВЗ), 
//§	координаты и адрес клиента, 
//§	фамилия, 
//§	имя, 
//§	телефон получателя, 
//§	комментарий курьеру, 
//§	желаемое время подачи курьера к точке отгрузки (рассчитывается как начало слота клиента минус среднее время доставки от ПВЗ до клиента, ориентировочно 60 минут — параметр настраивается), 
//§	состав посылки 
//3.3.6.1.2...1.	(наименования товаров, 
//3.3.6.1.2...2.	количество, 
//3.3.6.1.2...3.	общая стоимость для расчёта компенсации Яндекс.Доставкой при повреждении), 
//§	общий вес заказа и габариты, 
//§	тариф 
//3.3.6.1.2...1.	(same_day для плановой доставки, 
//3.3.6.1.2...2.	express для срочной). 
//Ø	В составе запроса 1С передаёт собственный идентификатор заказа в поле claim_id_ext или request_id (используется для идемпотентности и сверки) =  UUID документа «Заказ клиента» в 1С (отдельный реквизит, генерируется при создании заказа, неизменяемый)
//Ø	В ответ Яндекс.Доставка возвращает 
//§	идентификатор заявки (claim_id), 
//§	статус «new», 
//§	оценочную стоимость 
//§	срок действия предложения
// ДанныеДокумента -  Структура со значениями документа ЗаказПокупателя
//		добавить РасчетВеса    



Асинх Функция claims_create(ДанныеДокумента,Результат = Неопределено,НомерИнтервала = 2) Экспорт
	Point1 = Point(ДанныеДокумента.ТочкаОтгрузкиДолгота,ДанныеДокумента.ТочкаОтгрузкиШирота);
	
	tariffs			= Await tariffs(Point1,ДанныеДокумента.ТочкаОтгрузкиАдрес,Результат);
	if не Результат.Успех then
		return undefined;
	endif;	
	delivery_methods = Await delivery_methods(Point1,ДанныеДокумента.ТочкаОтгрузкиАдрес,Результат);
	interval = delivery_methods.same_day_delivery.available_intervals[НомерИнтервала-1];	
	if interval = undefined then 
		Результат.Успех = Ложь;
		Результат.Вставить("Причина","Тариф Same Day не доступен");
		return undefined;
	endif;
	DateFrom =  ReadJSONDate(interval.from, JSONDateFormat.ISO);
	DateTo   =  ReadJSONDate(interval.to,   JSONDateFormat.ISO); 

	request_id = ДанныеДокумента.order_id;
		
	bodyclaim = bodyclaim(CargoItems(ДанныеДокумента.Запасы),RequestCargoRoutePoints(
		RequestPoint(
			CargoPointAddress(Point(ДанныеДокумента.ТочкаОтгрузкиДолгота,ДанныеДокумента.ТочкаОтгрузкиШирота),СокрЛП(ДанныеДокумента.ТочкаОтгрузкиАдрес))
					,CreatedContactOnPoint(ДанныеДокумента.ТочкаОтгрузкиКонтакт,ДанныеДокумента.ТочкаОтгрузкиТелефон,ДанныеДокумента.АдресЭП))  // мыло подправить
		,RequestPoint(
			CargoPointAddress(Point(ДанныеДокумента.mona_Долгота,ДанныеДокумента.mona_Широта),ДанныеДокумента.АдресДоставки)
					,CreatedContactOnPoint(ДанныеДокумента.КонтактноеЛицо,ДанныеДокумента.КонтактныйТелефон,ДанныеДокумента.АдресЭП)) // мыло подправить

					),Requirements(ДанныеДокумента.ТаксиКласс,,,,Delivery_interval(DateFrom,DateTo))); 
					
	bodyclaim.same_day_data = Delivery_interval(DateFrom,DateTo);				
	if bodyclaim.client_requirements.taxi_class = "cargo" then 
		cargo_type = cargo_type(bodyclaim.items);		
		if cargo_type = undefined then
 			Результат.Успех = Ложь;
			Результат.Сообщение = "заказ не помещается даже в большой кузов тарифа «Грузовой» (до 3.80×1.80×1.80 м, 1400 кг) — "
				+ "разделите заказ на несколько отправлений.";
			return undefined;
		endif; 	
		bodyclaim.client_requirements.insert("cargo_type",cargo_type); 
	else
		Превышения = ПревышеныЛимитыТарифа(bodyclaim.items, ДанныеДокумента.Тариф);
		Если Превышения.Количество() > 0 Тогда
			ТекстПревышений = "";
			Для Каждого Стр Из Превышения Цикл
				ТекстПревышений = ТекстПревышений + Стр + "; ";
			КонецЦикла;
 			Результат.Успех = Ложь;
			Результат.Вставить("Причина","превышены лимиты веса/габаритов: " + ТекстПревышений
				+ "Разделите заказ на несколько отправлений или оформите доставку тарифом «Грузовой» вручную.");
		КонецЕсли;
		
	endif;
	if ДанныеДокумента.Property("claim_id") and  not IsBlankString(ДанныеДокумента.claim_id) then
		claim_id  = ДанныеДокумента.claim_id; 
		if Не СтрНачинаетсяС(claim_id,"x") Тогда 
			info = Await ИнфоЗаявкиНаДоставку(claim_id,Результат); 
			if  info.status = "estimating_failed" then
				pararam = claim_id+"&version="+строка(info.version+1);
				return Ждать claims("edit",pararam,bodyclaim,,Результат);
			endif;
			if  info.status = "cancelled" then
				request_id = ДанныеДокумента.ExtUUID; 
			endif;
		else
			request_id = ДанныеДокумента.ExtUUID; 
		endif;
	endif;	
	return  Ждать claims("create",,bodyclaim,request_id,Результат); 
КонецФункции


Async Function tariffs(Point,AddressFullname,Result = undefined) Export
	СтруктураЗапроса = Новый Структура("start_point,fullname",Point,AddressFullname);
	tariffs = await ЗапросВЯндекс(,"tariffs",СтруктураЗапроса,Result);
	if tariffs.available_tariffs.count() = 0 then
		Result.Успех = Ложь;
		Result.Сообщение = "Нет доступных тарифов";
		return undefined;
	endif;	
    return tariffs;
EndFunction
Async Function delivery_methods(Point,AddressFullname,Result) Export
	СтруктураЗапроса = Новый Структура("start_point,fullname",Point,AddressFullname);
    delivery_methods = await ЗапросВЯндекс(,"delivery-methods",СтруктураЗапроса,Result);
	if not delivery_methods.same_day_delivery.allowed  then
		Result.Успех = Ложь;
		Result.insert("Причина","Тариф Same Day не доступен");
		Result.Сообщение = "Тариф Same Day не доступен";
		return undefined;
	endif;
	if delivery_methods.same_day_delivery.available_intervals.count() = 0 Тогда 
		Result.Успех = Ложь;
		Result.insert("Причина","Нет свободных слотов доставки");
		Result.Сообщение = "Нет свободных слотов доставки";
		return undefined;
	endif;
    return delivery_methods;
EndFunction

