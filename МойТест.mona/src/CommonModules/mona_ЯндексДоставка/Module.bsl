// если заказ остаётся в статусе «Отгружен» свыше 90 минут после события pickup без последующих событий, 
// или в статусе «Назначен курьер» свыше 60 минут после performer_found. 
// При обнаружении расхождения статус заказа обновляется, в журнале обмена фиксируется источник информации (webhook или резервный опрос).


Функция РасчетВеса(ДанныеДокумента) 
	Возврат 1.5; // Заглушка
КонецФункции
// Реальная стоимость, которую Яндекс.Доставка выставит за рейс, рассчитывается Яндекс.Доставкой динамически 
// в зависимости от расстояния, веса, тарифа и дорожной обстановки 
// — разница относится в 1С на расходы компании по статье «Услуги доставки».
//	Проверка доступности зоны доставки и оценочной стоимости. 
// 1С при приёме заказа из приложения выполняет запрос /b2b/cargo/integration/v2/check-price к API Яндекс.Доставки с указанием
//.	координат точки отгрузки (ПВЗ), 
//.	координат адреса клиента, 
//.	веса посылки
//.	габаритов посылки,
//.	выбранного тарифа. 
// 2.	В ответ Яндекс.Доставка возвращает оценочную стоимость и срок доставки. 
Асинх Функция check_price(ДанныеДокумента,Результат) export
    taxi_class ="courier";
	Point1 = Point(ДанныеДокумента.ТочкаОтгрузкиДолгота,ДанныеДокумента.ТочкаОтгрузкиШирота);
	tariffs			= Await tariffs( Point1,ДанныеДокумента.ТочкаОтгрузкиАдрес,Результат);
	if не Результат.Успех then
		return undefined;
	endif;	
	delivery_methods = Await delivery_methods(Point1,ДанныеДокумента.ТочкаОтгрузкиАдрес,Результат);
	if не Результат.Успех then
		return undefined;
	endif;	
	interval = delivery_methods.same_day_delivery.available_intervals[1];	
	DateFrom = ПрочитатьДатуJSON(interval.from, ФорматДатыJSON.ISO);
	DateTo   = ПрочитатьДатуJSON(interval.to,   ФорматДатыJSON.ISO); 

	bodycheck = bodycheck(_Items(ДанныеДокумента.Запасы),
					RoutePointsWithAddress(
						RoutePointWithAddress(Point(ДанныеДокумента.ТочкаОтгрузкиДолгота,ДанныеДокумента.ТочкаОтгрузкиШирота),ДанныеДокумента.ТочкаОтгрузкиАдрес),
						RoutePointWithAddress(Point(ДанныеДокумента.mona_Долгота,ДанныеДокумента.mona_Широта),ДанныеДокумента.АдресДоставки)),
					Requirements(ДанныеДокумента.ТаксиКласс,,,,Delivery_interval(DateFrom,DateTo)));
	Возврат	 Ждать mona_ЯндексДоставка.ЗапросВЯндекс(,"check-price",bodycheck,Результат);
КонецФункции
Function bodyclaim(CargoItems,RequestCargoRoutePoints,ClientRequirements)
	Возврат new structure("items,route_points,client_requirements,same_day_data",CargoItems,RequestCargoRoutePoints,ClientRequirements);	
EndFunction
Function bodycheck(_Items,RoutePointsWithAddress,requirements)
	Возврат new structure("items,route_points,client_requirements",_Items,RoutePointsWithAddress,requirements);	
EndFunction

Процедура БлокировкаКнопкиОтмены(Статус,ЭлементКнопки)
	СтатусыЯндекДоставки = СтатусыЯндекДоставки();
	ЭлементКнопки.Доступность = СтатусыЯндекДоставки[Статус].ВозможнаОтмена; //По умолчанию 1С автоматически блокирует кнопку «Отменить заявку Яндекс.Доставки» в карточке заказа после получения статуса pickup		
КонецПроцедуры 

Function Point(lng,lat) export

	Point = new Array();
	Если lng = 0 и lat =0 Тогда
		return Point;
	КонецЕсли;	
	Point.add(lng);
	Point.add(lat); 
	return Point;
EndFunction
Function RoutePoint(Point,fullname)
	RoutePoint = new structure("coordinates,fullname,id",Point,fullname);	
	return RoutePoint;
EndFunction
Function Size(length,width,height)
	Size = new structure("length,width,height",length,width,height);	
	return Size;
EndFunction

Function Item(quantity,size = undefined,weight) 
	if size = undefined then
		size = Size(0.01,0.02,0.03);	
	endif;
	
	Item = new structure("size,weight,quantity,pickup_point,dropoff_point"
						,size,weight,quantity,1,2);
	return Item;
EndFunction
Function _Items(TableItems)
    ar = new array();
	for each i из TableItems do
		ar.add(Item(i.Количество,,0.5));	
	enddo;
return ar;
EndFunction


Function CargoItems(TableItems)
    ar = new array();
	for each i из TableItems do
		ar.add(CargoItem(i.НоменклатураНаименование,i.Цена,i.Количество,,0.5));	
	enddo;
return ar;
EndFunction
	
Function CargoItem(title,cost_value,quantity,size = undefined,weight) 
	if size = undefined then
		size = Size(0.01,0.02,0.03);	
	endif;
	
	Item = new structure("title,cost_value,quantity,cost_currency,size,weight,pickup_point,dropoff_point"
						,title
						,Format(cost_value,"NG=0")
						,quantity
						,"KZT"                 
						,size,weight,1,2);
	return Item;
EndFunction



Function RoutePoints(Point1,Point2)
	RoutePoints = new Array();
	Point1.id = 1;
	RoutePoints.add(Point1);
	Point2.id = 2;
	RoutePoints.add(Point2); 
	return RoutePoints;
EndFunction

Function Requirements(taxi_class = "courier",cargo_type = undefined,pro_courier = undefined,cargo_options = undefined,same_day_data = undefined)

	
	Requirements = new structure("taxi_class",taxi_class);
				if not pro_courier = undefined then
					Requirements.Insert("pro_courier",pro_courier);		
				endif;
				if not cargo_options = undefined then
					Requirements.Insert("cargo_options",cargo_options);		
				endif;
				if not cargo_type  = undefined then
					Requirements.Insert("cargo_type",cargo_type);		
				endif;
				if not same_day_data  = undefined then
					Requirements.Insert("same_day_data",same_day_data);		
				endif;
	return Requirements;
EndFunction
Function Delivery_interval(DateFrom,DateTo) 
	Delivery_interval = new structure("delivery_interval",
	                    new structure("from,to",DateKZ(DateFrom),DateKZ(DateTo)));
    return Delivery_interval;
EndFunction

// расширить https://yandex.com/support/delivery-profile/ru/api/express/openapi/IntegrationV2ClaimsCreate#entity-CargoPointAddress
Function CargoPointAddress(Point,fullname)    
	RoutePoint = new structure("coordinates,fullname",Point,fullname);	
	return RoutePoint;
EndFunction
Function RoutePointWithAddress(Point,fullname) 
	RoutePoint = new structure("fullname,id",fullname);	
	if Point.Count() =2 then
		RoutePoint.insert("coordinates",Point);	
	endif;
	return RoutePoint;
EndFunction
	
Function RequestPoint(CargoPointAddress,CreatedContactOnPoint)    
	RoutePoint = new structure("address,contact,point_id,type,visit_order",CargoPointAddress,CreatedContactOnPoint);	
	return RoutePoint;
EndFunction

Function CreatedContactOnPoint(name,phone,email="")
	CreatedContactOnPoint = new structure("name,phone",name,phone);	
	if not IsBlankString(email) then
		CreatedContactOnPoint.insert("email",email);	
	endif;
	return CreatedContactOnPoint;
EndFunction
Function RoutePointsWithAddress(RoutePointWithAddress1,RoutePointWithAddress2) 
	RoutePoints = new Array();
	RoutePointWithAddress1.id = 1;
	RoutePoints.add(RoutePointWithAddress1);
	RoutePointWithAddress2.id = 2;
	RoutePoints.add(RoutePointWithAddress2); 
	return RoutePoints;
EndFunction	
Function RequestCargoRoutePoints(RequestPoint1,RequestPoint2)
	RoutePoints = new Array();
	RequestPoint1.point_id = 1;
	RequestPoint1.visit_order = 1;
	RequestPoint1.type = "source" ;
	RoutePoints.add(RequestPoint1);
	RequestPoint2.point_id = 2;
	RequestPoint2.visit_order = 2;
	RequestPoint2.type = "destination";
	RoutePoints.add(RequestPoint2); 
	return RoutePoints;
EndFunction 
