Функция СтруктураДоставки(route_points = Неопределено,items_product,same_day_data)
	
	СтруктураЗапроса = Новый Структура;
	Если route_points <> Неопределено Тогда 
		СтруктураЗапроса.Вставить("route_points", route_points); 
	КонецЕсли;
	СтруктураЗапроса.Вставить("items", items_product); // Добавляем состав груза в v2
	
	requirements = New Structure;
	requirements.Insert("taxi_class", "express"); 
	СтруктураЗапроса.Вставить("requirements", requirements);
	
	// ГЛАВНОЕ ОТЛИЧИЕ: Блок интервальной межгородской доставки
	//	Если eq_same_day_data Тогда 
	
	СтруктураЗапроса.Вставить("same_day_data", same_day_data); 
	//	КонецЕсли;
	Возврат  СтруктураЗапроса;
	
КонецФункции

// Лимиты веса и габаритов по тарифам — см. документацию Яндекс.Доставки
// (раздел CargoItem: size/weight). Размеры — метры, вес — кг.
// Если фактические характеристики превысят допустимые, курьер вправе
// отказаться от заказа на месте, и будет удержана стоимость подачи — поэтому
// лучше предупредить оператора ДО отправки заявки, а не после отказа курьера.
Функция ЛимитыТарифа(Тариф)
	Лимиты = Новый Структура("Вес,Габариты");
	Габариты = Новый Массив; // отсортированы по убыванию
	Если Тариф = "express" Тогда
		Лимиты.Вес = 20;
		Габариты.Добавить(1.00);
		Габариты.Добавить(0.60);
		Габариты.Добавить(0.50);
	Иначе
		// same_day (SDD): по документации лимит на точку — до 10 кг и до 0.5 м   по каждой стороне.
		Лимиты.Вес = 10;
		Габариты.Добавить(0.5);
		Габариты.Добавить(0.5);
		Габариты.Добавить(0.5);
	КонецЕсли;
	Лимиты.Габариты = Габариты;	
	Возврат Лимиты;
КонецФункции

// Лимиты грузового тарифа по типу кузова (см. документацию, CargoType/size/weight).
// Значения не задокументированы для lcv_xl — эта градация не автоподбирается,
// им оператор выбирает вручную при необходимости.
Функция ЛимитыКузова(ТипКузова)
	Лимиты = Новый Структура("Вес,Габариты");
	Габариты = Новый Массив;
	Если ТипКузова = "van" Тогда
		Лимиты.Вес = 300;
		Габариты.Добавить(1.70); Габариты.Добавить(0.96); Габариты.Добавить(0.90);
	ИначеЕсли ТипКузова = "lcv_m" Тогда
		Лимиты.Вес = 700;
		Габариты.Добавить(2.60); Габариты.Добавить(1.30); Габариты.Добавить(1.50);
	ИначеЕсли ТипКузова = "lcv_l" Тогда
		Лимиты.Вес = 1400;
		Габариты.Добавить(3.80); Габариты.Добавить(1.80); Габариты.Добавить(1.80);
	КонецЕсли;
	Лимиты.Габариты = Габариты;
	Возврат Лимиты;
КонецФункции

Функция ТриСтороныПоУбыванию(size)
	Стороны = Новый Массив;
	Стороны.Добавить(size.length);
	Стороны.Добавить(size.width);
	Стороны.Добавить(size.height);
	// Ручная сортировка по убыванию (элементов всего 3, пузырьком — без
	// зависимости от Массив.Сортировать(), которая появилась не во всех версиях).
	Для А = 0 По Стороны.ВГраница() - 1 Цикл
		Для Б = 0 По Стороны.ВГраница() - 1 - А Цикл
			Если Стороны[Б] < Стороны[Б+1] Тогда
				Врем = Стороны[Б];
				Стороны[Б] = Стороны[Б+1];
				Стороны[Б+1] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Стороны;
КонецФункции

// Возвращает массив текстовых описаний превышений против заданных Лимитов
// (пустой массив — всё в норме). Общее ядро для проверки и по тарифу
// (курьер/экспресс/same_day), и по типу кузова (van/lcv_m/lcv_l).
Функция ПревышеныЛимиты(items_product, Лимиты, ИмяЛимита)
	Превышения = Новый Массив;
	ОбщийВес = 0;
	
	Для Каждого item_product Из items_product Цикл
		ОбщийВес = ОбщийВес + item_product.weight * item_product.quantity;
		
		СтороныТовара = ТриСтороныПоУбыванию(item_product.size);
		Для Индекс = 0 По СтороныТовара.ВГраница() Цикл
			Если СтороныТовара[Индекс] > Лимиты.Габариты[Индекс] Тогда
				Превышения.Добавить(item_product.title + ": габарит " + Формат(СтороныТовара[Индекс], "ЧЦ=0; ЧДЦ=2")
					+ " м превышает лимит """ + ИмяЛимита + """ (" + Формат(Лимиты.Габариты[Индекс], "ЧЦ=0; ЧДЦ=2") + " м)");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ОбщийВес > Лимиты.Вес Тогда
		Превышения.Добавить("Общий вес заказа " + Формат(ОбщийВес, "ЧЦ=0; ЧДЦ=2") + " кг превышает лимит """
			+ ИмяЛимита + """ (" + Лимиты.Вес + " кг)");
	КонецЕсли;
	
	Возврат Превышения;
КонецФункции

Функция ПревышеныЛимитыТарифа(items_product, Тариф) Экспорт
	Возврат ПревышеныЛимиты(items_product, ЛимитыТарифа(Тариф), Тариф);
КонецФункции

// Автоподбор наименьшего подходящего кузова для тарифа "Грузовой".
// Возвращает "van"/"lcv_m"/"lcv_l", либо Неопределено, если заказ не помещается
// даже в большой кузов (нужно делить заказ на несколько отправлений).
Функция cargo_type(items_product)
	ТипыПоВозрастанию = Новый Массив;
	ТипыПоВозрастанию.Добавить("van");
	ТипыПоВозрастанию.Добавить("lcv_m");
	ТипыПоВозрастанию.Добавить("lcv_l");
	
	Для Каждого ТипКузова Из ТипыПоВозрастанию Цикл
		Если ПревышеныЛимиты(items_product, ЛимитыКузова(ТипКузова), "cargo/" + ТипКузова).Количество() = 0 Тогда
			Возврат ТипКузова;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

// Публичная проверка для клиентского кода формы (например, чтобы включать/
// выключать кнопку "Оформить тарифом Грузовой" только для заказов, которые
// действительно не влезают в обычный тариф). Не делает сетевых обращений.
Функция ПревышенияЗаказа(items_product, Тариф = "same_day") Экспорт
	Возврат ПревышеныЛимитыТарифа(items_product, Тариф);
КонецФункции
Функция ДождатьсяОценки(claim_id, МаксПопыток = 10) Экспорт
	
	Инфо = Неопределено;
	
	Для НомерПопытки = 1 По МаксПопыток Цикл
		Инфо = ИнфоЗаявкиНаДоставку(claim_id);
		
		Если Инфо.status = "ready_for_approval" Тогда
			Возврат Инфо;
		ИначеЕсли Инфо.status = "estimating_failed" Тогда
			Сообщить("Оценка заявки не удалась. Ответ: " + Строка(Инфо));
			Возврат Инфо;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Инфо;
	
КонецФункции


Асинх Функция ЗапросВЯндекс(Версия ="v2",ИмяМетода,СтруктураЗапроса,Результат = Неопределено) Экспорт 
	СтрокаJSON = ПодготовитьJSON(СтруктураЗапроса);

	Заголовки = Новый Соответствие;
    Заголовки.Вставить("Authorization", "Bearer " +  ТокенИнтеграции(ЭтоТест()));
    Заголовки.Вставить("Content-Type", "application/json");
    Заголовки.Вставить("Accept-Language", "ru-RU"); 

	Таймаут = ТаймАутЯндексДоставки();

	Если ЭтоТест() Тогда 
		HTTPСоединение = Новый HTTPСоединение(СерверЯндексДоставки(Истина),,"odata_all","odata_all", , Таймаут);
	Иначе
		HTTPСоединение = Новый HTTPСоединение(СерверЯндексДоставки(), 443, , , , Таймаут, Новый ЗащищенноеСоединениеOpenSSL);
	КонецЕсли;
	МаксПопыток = МаксПопытокЯндексДоставка();
    Для НомерПопытки = 1 По МаксПопыток Цикл
        Попытка
		    HTTPЗапрос = Новый HTTPЗапрос(АдресИнтеграции(Версия,ЭтоТест()) + ИмяМетода, Заголовки);
		    Если Не ПустаяСтрока(СтрокаJSON) Тогда
				HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		    КонецЕсли;
            Обещание = HTTPСоединение.ОтправитьДляОбработкиАсинх(HTTPЗапрос);
            HTTPОтвет = Ждать Обещание;
        	Исключение 
				Прервать;
			КонецПопытки;
			Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
				СтрокаОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
                        
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
            Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
            ЧтениеJSON.Закрыть();
			Данные.Вставить("СтрокаОтвета",СтрокаОтвета);
			Возврат Данные;
				
				
				
			ИначеЕсли HTTPОтвет.КодСостояния >= 500 Тогда
                Если НомерПопытки < МаксПопыток Тогда
                    Ждать Таймаут; // пауза
                    Продолжить;
                КонецЕсли;
            Иначе
              // Бизнес‑ошибка (4xx) — не повторяем
                Сообщить("Ошибка API: " + HTTPОтвет.КодСостояния + ". Ответ: " + HTTPОтвет.ПолучитьТелоКакСтроку());
				Если Результат <> Неопределено Тогда 	
					Результат.Успех = Ложь;
					Результат.Сообщение = "Ошибка API: " + HTTPОтвет.КодСостояния + ". Ответ: " + HTTPОтвет.ПолучитьТелоКакСтроку();
				КонецЕсли;
				Прервать;
            КонецЕсли;
            Если НомерПопытки < МаксПопыток Тогда
                Ждать 3;
                Продолжить;
            КонецЕсли;
    КонецЦикла;
    Если НомерПопытки = МаксПопыток Тогда
		Сообщить("Превышено число попыток.");  
    КонецЕсли;
	
КонецФункции

Function DateKZ(Val Date1С = undefined) Export
	if Date1С = undefined then 
		Date1С = CurrentDate();	
	endif;
	DateISO = WriteJSONDate(Date1С,JSONDateFormat.ISO,JSONDateWritingVariant.ЛокальнаяДатаСоСмещением); 
    return DateISO;
EndFunction
//Функция ЗапросВЯндекс(Версия = "v2", ИмяМетода, СтруктураЗапроса)
//3.3.6.2.	Этап 2 — подтверждение заявки. 
//3.3.6.2.1.	После получения claim_id и оценочной стоимости 1С отправляет запрос POST /b2b/cargo/integration/v2/claims/accept с указанием claim_id для подтверждения заказа курьерской службе. 
//3.3.6.2.2.	После подтверждения Яндекс.Доставка 
//Ø	начинает поиск курьера 
//Ø	отправляет заявку в работу. 
//Ø	Идентификатор заявки (claim_id) сохраняется в реквизите документа «Заказ клиента» «Внешний идентификатор заявки доставки» и используется во всех последующих обращениях к API.

асинх Функция ПодтвердитьЗаявкуНаДоставку(claim_id,Результат = Неопределено) Экспорт
	ОтветСтруктура = ждать claims("accept",claim_id,,,Результат);
	Возврат ОтветСтруктура;
КонецФункции

Асинх Функция ОтменаДоставки(Знач claim_id,Результат = Неопределено)  Экспорт 
	СтатусыЯндекДоставки = СтатусыЯндекДоставки();
	Если СтрНачинаетсяС(claim_id,"x") Тогда 
    	claim_id = Прав(claim_id,СтрДлина(claim_id));	
	КонецЕсли;
	
	info = ЖДАТЬ ИнфоЗаявкиНаДоставку(claim_id,Результат);
	Если Не Результат.Успех Тогда 
		Возврат Неопределено	
	КонецЕсли;	
	Если info = Неопределено  Тогда 
		Результат.Успех = Ложь;
		Результат.Сообщение = "Не удалось получить информацию о заявке в Яндекс.Доставке.";
		Возврат Неопределено;
	КонецЕсли;
	Статус = info.status;
	//Если  СтатусыЯндекДоставки[Статус].БесплатнаяОтмена Тогда  //До назначения курьера (статусы new, ready_for_approval, performer_lookup) 
	//	Ответ = ждать claims("cancel",claim_id); //POST /b2b/cargo/integration/v2/claims/cancel с указанием причины. 
	//ИначеЕсли  СтатусыЯндекДоставки[Статус].ВозможнаОтмена Тогда  //Яндекс.Доставка может удержать частичную стоимость подачи (зависит от тарифа и времени отмены) 
	//	Ответ = ждать claims("cancel",claim_id); //POST /b2b/cargo/integration/v2/claims/cancel с указанием причины.
	//Иначе
	//	//	ОбращениеВПоддержку();		
	//КонецЕсли;
	    Если Статус = "cancelled" Тогда 
			Результат.Успех = Ложь;
			Результат.Сообщение = "Заявка в Яндекс.Доставке уже отменена."+ ?(info.error_messages.count() > 0,info.error_messages[0].code,"");
			Возврат Неопределено;
		КонецЕсли;
	
		РезультатОтмены = ЖДАТЬ claims("cancel", claim_id,
			new structure("version,cancel_state",info.version,info.available_cancel_state),,Результат);
		Если Не Результат.Успех Тогда 
			Возврат Неопределено	
		КонецЕсли;	
		Если РезультатОтмены = Неопределено Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение("Отмена недоступна при текущем статусе доставки: " + Статус);
			Возврат Неопределено	
		КонецЕсли;
	
	//ЗаписьВЖурнал(Инициатор,"cancel",причина,СуммаУдержания);
	//		фиксирует факт отмены в комментарии к заказу. 
	//	При успешной отмене 1С фиксирует 
	//	Ø	инициатора (клиент, оператор, Яндекс.Доставка), 
	//	Ø	причину, 
	//	Ø	время отмены и 
	//	Ø	удержанную сумму (если есть) — для последующего учёта расходов.
	Возврат РезультатОтмены;
КонецФункции


// при последующих запросах /claims/info — ссылку для отслеживания (sharing_url), которую курьер видит в приложении Яндекс Go. 
// Трек-ссылка сохраняется в реквизите «Ссылка на отслеживание» документа «Заказ клиента» и передаётся клиенту в мобильное приложение через канал обмена. 
