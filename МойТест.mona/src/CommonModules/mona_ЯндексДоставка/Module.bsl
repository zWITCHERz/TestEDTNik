Функция СтатусыЯндекДоставки() Экспорт 
	СтатусыЯндекДоставки = Новый Соответствие;
	СтатусыЯндекДоставки.Вставить("new",				СтрЯД("заявка создана, ожидает подтверждения",,Истина,Истина));
	СтатусыЯндекДоставки.Вставить("ready_for_approval",	СтрЯД("заявка создана, ожидает подтверждения",,Истина,Истина));
	СтатусыЯндекДоставки.Вставить("estimating_failed",	СтрЯД("Оценка не удалась",,Истина,Истина)); 
	СтатусыЯндекДоставки.Вставить("accepted",			СтрЯД("заявка подтверждена 1С через /claims/accept",,Истина,Истина)); 
	СтатусыЯндекДоставки.Вставить("performer_lookup",	СтрЯД("Яндекс.Доставка ищет курьера",,Истина)); //Промежуточное событие, фиксируются в журнале обмена, но не меняют основной статус заказа.
	СтатусыЯндекДоставки.Вставить("performer_not_found",СтрЯД("не удалось найти курьера в течение установленного времени",,Истина,Истина)); 
	СтатусыЯндекДоставки.Вставить("performer_draft",	СтрЯД("",,,Истина)); //Промежуточное событие, фиксируются в журнале обмена, но не меняют основной статус заказа
	//После назначения курьера и до прибытия на точку отгрузки
	СтатусыЯндекДоставки.Вставить("performer_found",	СтрЯД("курьер назначен",,Истина,Истина,Новый структура ("ИмяКурьера,ТелефонКурьера,СсылкаОтслеживания"))); 
	СтатусыЯндекДоставки.Вставить("pickup_arrived",		СтрЯД("курьер прибыл на точку отгрузки",,,Истина)); 
	// После забора посылки курьером (статус pickup и далее) стандартная отмена через API не поддерживается; 
	//	требуется обращение в поддержку Яндекс.Доставки. 
	
	СтатусыЯндекДоставки.Вставить("pickup",				СтрЯД("курьер забрал посылку",		"Отгружен")); // (бухгалтерское событие реализации, см. 4.2.1); 
	СтатусыЯндекДоставки.Вставить("delivery_arrived",	СтрЯД("курьер прибыл к получателю","В пути")); //Промежуточное событие, фиксируются в журнале обмена, но не меняют основной статус заказа
	СтатусыЯндекДоставки.Вставить("delivered_finish",	СтрЯД(""));
	СтатусыЯндекДоставки.Вставить("delivered",			СтрЯД("доставка завершена успешно",	"Доставлен")); 
	
	СтатусыЯндекДоставки.Вставить("cancelled",			СтрЯД("заявка отменена","Отменён"));  //статус «Отменён» с указанием инициатора 
	СтатусыЯндекДоставки.Вставить("failed",				СтрЯД("доставка не выполнена"));    //  статус «Доставка не выполнена» с уведомлением оператора для ручного разбора. 
	Возврат  СтатусыЯндекДоставки;
КонецФункции
