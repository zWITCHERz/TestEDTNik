//Все сценарии работают с защитой от дублирования и с возможностью повторной передачи при временном сбое.

Функция ДубльОтПриложения(ИмяПоля,ДанныеЗапроса) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 order_id ИЗ	РегистрСведений.ЗаказыОнлайн ГДЕ ");
	Запрос.Текст = Запрос.Текст + ИмяПоля + " = &Значение";  
    Если ТипЗнч(ДанныеЗапроса) = Тип("Структура") Тогда 
		Запрос.УстановитьПараметр("Значение",Строка(ДанныеЗапроса[ИмяПоля]));
	Иначе 
		Запрос.УстановитьПараметр("Значение",Строка(ДанныеЗапроса));
	КонецЕсли;	
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда 
		Возврат Выб.order_id;
	Иначе
		Возврат "";
	КонецЕсли;	
КонецФункции


//Тайм-аут единичного HTTP-вызова на стороне 1С при обращении к внешним сервисам — 30 секунд (параметр настраивается в 1С без правки конфигурации). 

Функция ТаймаутЕдиничногоHTTPвызова() Экспорт
	Возврат 30;
КонецФункции


//При превышении тайм-аута срабатывает механизм повторных попыток (см. 4.4.4.1). 
//Длительные операции (массовая выгрузка каталога) выполняются в фоновом задании 1С, чтобы не блокировать пользовательскую сессию. 
