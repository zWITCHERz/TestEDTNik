Функция GetPicture(ItemID) Экспорт

	МенеджерОбъекта = Справочники.Номенклатура;
	СсылкаНаОбъект = ПолучитьСсылкуПоИдентификатору(МенеджерОбъекта, ItemID);
	
	МассивСсылокНаТовары = Новый Массив;
	МассивСсылокНаТовары.Добавить(СсылкаНаОбъект);

	РазрешенныеТипыКартинок = Новый Массив;
	РазрешенныеТипыКартинок.Добавить("gif");
	РазрешенныеТипыКартинок.Добавить("jpg");
	РазрешенныеТипыКартинок.Добавить("jpeg");
	РазрешенныеТипыКартинок.Добавить("png");

	Выборка = ПолучитьПрисоединенныеФайлы(МассивСсылокНаТовары, РазрешенныеТипыКартинок);
	Если Выборка.Следующий() Тогда
		
		СериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
		ДвоичныеДанныеФайла = ПолучитьДвоичныеДанныеФайла(Выборка);
		
		Попытка
			КартинкаXDTO = СериализаторXDTO.ЗаписатьXDTO(ДвоичныеДанныеФайла);
		Исключение
			ВызватьИсключение ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат КартинкаXDTO;
	
	
КонецФункции
Функция ПолучитьДвоичныеДанныеФайла(ДанныеФайла)
	
	ДвоичныеДанныеФайла = Неопределено;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ПлатформаWindows = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64;
	
	ФайлВХранилище = ДанныеФайла.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	Если ФайлВХранилище Тогда
		
		Если ДанныеФайла.ХранимыйФайл = NULL Тогда
			ДвоичныеДанныеФайла = Неопределено;
		Иначе
			ДвоичныеДанныеФайла = ДанныеФайла.ХранимыйФайл.Получить();
		КонецЕсли;
		
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			
			ОписаниеОшибки = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'GetPicture: не удалось получить данные файла %1 номенклатуры %2.'"),
				ДанныеФайла.Файл,
				ДанныеФайла.Номенклатура),
				УровеньЖурналаРегистрации.Ошибка,,,
				ОписаниеОшибки.Описание);
			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;
		
	Иначе
		
		ИмяФайла = ОбменССайтом.ПодготовитьПутьДляПлатформы(ПлатформаWindows,
			ОбменССайтом.ПолучитьПутьТомаДляПлатформы(ПлатформаWindows, ДанныеФайла.Том) + "\" + ДанныеФайла.ПутьКФайлу);
		
		Попытка
			
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
			
		Исключение
			
			ВызватьИсключение ИнформацияОбОшибке();
			
		КонецПопытки;
	КонецЕсли;
	
	Возврат ДвоичныеДанныеФайла;
	
КонецФункции
Функция ПолучитьПрисоединенныеФайлы(МассивСсылокНаТовары, РазрешенныеТипыКартинок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	НоменклатураПрисоединенныеФайлы.Ссылка КАК Файл,
	|	НоменклатураПрисоединенныеФайлы.Наименование КАК Наименование,
	|	НоменклатураПрисоединенныеФайлы.Описание КАК Описание,
	|	НоменклатураПрисоединенныеФайлы.Том КАК Том,
	|	НоменклатураПрисоединенныеФайлы.ТипХраненияФайла КАК ТипХраненияФайла,
	|	НоменклатураПрисоединенныеФайлы.Расширение КАК Расширение,
	|	НоменклатураПрисоединенныеФайлы.ПутьКФайлу КАК ПутьКФайлу,
	|	ПрисоединенныеФайлы.ДвоичныеДанныеФайла КАК ХранимыйФайл
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УдалитьДвоичныеДанныеФайлов КАК ПрисоединенныеФайлы
	|			ПО НоменклатураПрисоединенныеФайлы.Ссылка = ПрисоединенныеФайлы.Файл
	|				И (НоменклатураПрисоединенныеФайлы.ТипХраненияФайла = ЗНАЧЕНИЕ(Перечисление.ТипыХраненияФайлов.ВИнформационнойБазе))
	|		ПО Номенклатура.ФайлКартинки = НоменклатураПрисоединенныеФайлы.Ссылка
	|ГДЕ
	|	НоменклатураПрисоединенныеФайлы.Расширение В(&РазрешенныеТипыКартинок)
	|	И Номенклатура.Ссылка В(&МассивСсылокНаТовары)
	|	И НЕ НоменклатураПрисоединенныеФайлы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";
	
	Запрос.УстановитьПараметр("РазрешенныеТипыКартинок", РазрешенныеТипыКартинок);
	Запрос.УстановитьПараметр("МассивСсылокНаТовары", МассивСсылокНаТовары);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции
Функция ПолучитьСсылкуПоИдентификатору(МенеджерОбъекта, Знач СтрокаGUID)
	
	НовыйGUID = Новый УникальныйИдентификатор(СтрокаGUID);
	
	Попытка
		СсылкаНаОбъект = МенеджерОбъекта.ПолучитьСсылку(НовыйGUID);
	Исключение
		ОписаниеОшибки = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'GetPicture: не удалось получить объект по идентификатору.'"), УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки.Описание);
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат СсылкаНаОбъект;
	
КонецФункции

//// Записывает в структуру ссылки на измененные объекты по узлу плана обмена.
////
//// Параметры:
////	Параметры - Структура
////
Функция ЗаполнитьСтруктуруИзменений(Параметры) Экспорт
	
	СтруктураИзменений = Новый Структура;
	СтруктураИзменений.Вставить("Товары", Новый Массив);
	СтруктураИзменений.Вставить("Услуги", Новый Массив);
	СтруктураИзменений.Вставить("Ресурсы", Новый Массив);
	СтруктураИзменений.Вставить("Заказы", Новый Массив);
	СтруктураИзменений.Вставить("Файлы", Новый Массив);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НоменклатураИзменения.Ссылка КАК Ссылка,
	|	Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры
	|ПОМЕСТИТЬ втНоменклатура
	|ИЗ
	|	Справочник.Номенклатура.Изменения КАК НоменклатураИзменения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО НоменклатураИзменения.Ссылка = Номенклатура.Ссылка
	|ГДЕ
	|	НоменклатураИзменения.Узел = &УзелОбменаТовары
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТипНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ХарактеристикиНоменклатурыИзменения.Ссылка КАК Ссылка,
	|	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура
	|ПОМЕСТИТЬ втХарактеристика
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры.Изменения КАК ХарактеристикиНоменклатурыИзменения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО ХарактеристикиНоменклатурыИзменения.Ссылка = ХарактеристикиНоменклатуры.Ссылка
	|ГДЕ
	|	ХарактеристикиНоменклатурыИзменения.Узел = &УзелОбменаТовары
	|	И ХарактеристикиНоменклатуры.Владелец ССЫЛКА Справочник.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныНоменклатурыИзменения.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_ЦенаКоличество
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.Изменения КАК ЦеныНоменклатурыИзменения
	|ГДЕ
	|	ЦеныНоменклатурыИзменения.Узел = &УзелОбменаТовары
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиТоваровИзменения.Номенклатура
	|ИЗ
	|	РегистрСведений.ОстаткиТоваров.Изменения КАК ОстаткиТоваровИзменения
	|ГДЕ
	|	ОстаткиТоваровИзменения.Узел = &УзелОбменаТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНоменклатура.Ссылка КАК Ссылка,
	|	""Товары"" КАК ТипСсылки
	|ИЗ
	|	втНоменклатура КАК втНоменклатура
	|ГДЕ
	|	втНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втХарактеристика.Номенклатура,
	|	""Товары""
	|ИЗ
	|	втХарактеристика КАК втХарактеристика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НоменклатураПоставщиков.Номенклатура,
	|	""Товары""
	|ИЗ
	|	Справочник.НоменклатураПоставщиков.Изменения КАК НоменклатураПоставщиковИзменения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
	|		ПО НоменклатураПоставщиковИзменения.Ссылка = НоменклатураПоставщиков.Ссылка
	|ГДЕ
	|	НоменклатураПоставщиковИзменения.Узел = &УзелОбменаТовары
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ЦенаКоличество.Номенклатура,
	|	""Товары""
	|ИЗ
	|	ВТ_ЦенаКоличество КАК ВТ_ЦенаКоличество
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НоменклатураПрисоединенныеФайлыИзменения.Ссылка.ВладелецФайла,
	|	""Товары""
	|ИЗ
	|		Справочник.НоменклатураПрисоединенныеФайлы.Изменения КАК НоменклатураПрисоединенныеФайлыИзменения
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НоменклатураПрисоединенныеФайлы Как НоменклатураПрисоединенныеФайлы
	|		ПО НоменклатураПрисоединенныеФайлы.Ссылка = НоменклатураПрисоединенныеФайлыИзменения.Ссылка
	|ГДЕ
	|	НоменклатураПрисоединенныеФайлыИзменения.Узел = &УзелОбменаТовары
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ХарактеристикиНоменклатурыПрисоединенныеФайлыИзменения.Ссылка.ВладелецФайла.Владелец, 
	|	""Товары""
	|ИЗ
	|		 Справочник.ХарактеристикиНоменклатурыПрисоединенныеФайлы Как ХарактеристикиНоменклатурыПрисоединенныеФайлы
	|		 ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатурыПрисоединенныеФайлы.Изменения КАК ХарактеристикиНоменклатурыПрисоединенныеФайлыИзменения
	|		ПО ХарактеристикиНоменклатурыПрисоединенныеФайлы.Ссылка = ХарактеристикиНоменклатурыПрисоединенныеФайлыИзменения.Ссылка
	|ГДЕ
	|	ХарактеристикиНоменклатурыПрисоединенныеФайлыИзменения.Узел = &УзелОбменаТовары
    |
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НоменклатураПрисоединенныеФайлыИзменения.Ссылка,
	|	""Файлы""
	|ИЗ
	|		Справочник.НоменклатураПрисоединенныеФайлы.Изменения КАК НоменклатураПрисоединенныеФайлыИзменения
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НоменклатураПрисоединенныеФайлы Как НоменклатураПрисоединенныеФайлы
	|		ПО НоменклатураПрисоединенныеФайлы.Ссылка = НоменклатураПрисоединенныеФайлыИзменения.Ссылка
	|ГДЕ
	|	НоменклатураПрисоединенныеФайлыИзменения.Узел = &УзелОбменаТовары
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ХарактеристикиНоменклатурыПрисоединенныеФайлыИзменения.Ссылка,
	|	""Файлы""
	|ИЗ
	|		 Справочник.ХарактеристикиНоменклатурыПрисоединенныеФайлы Как ХарактеристикиНоменклатурыПрисоединенныеФайлы
	|		 ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатурыПрисоединенныеФайлы.Изменения КАК ХарактеристикиНоменклатурыПрисоединенныеФайлыИзменения
	|		ПО ХарактеристикиНоменклатурыПрисоединенныеФайлы.Ссылка = ХарактеристикиНоменклатурыПрисоединенныеФайлыИзменения.Ссылка
	|ГДЕ
	|	ХарактеристикиНоменклатурыПрисоединенныеФайлыИзменения.Узел = &УзелОбменаТовары
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказыИзменения.Ссылка,
	|	""Заказы""
	|ИЗ
	|	Документ.ЗаказПокупателя.Изменения КАК ЗаказыИзменения
	|ГДЕ
	|	ЗаказыИзменения.Узел = &УзелОбменаЗаказы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказыПокупателей.ЗаказПокупателя,
	|	""Заказы""
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Изменения КАК ЗаказыПокупателейИзменения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
	|		ПО ЗаказыПокупателейИзменения.Регистратор = ЗаказыПокупателей.Регистратор
	|ГДЕ
	|	ЗаказыПокупателейИзменения.Узел = &УзелОбменаЗаказы
	|	И НЕ ВЫРАЗИТЬ(ЗаказыПокупателей.Регистратор КАК Документ.ЗаказПокупателя) ССЫЛКА Документ.ЗаказПокупателя
	|	И ЗаказыПокупателей.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОплатаСчетовИЗаказов.СчетНаОплату,
	|	""Заказы""
	|ИЗ
	|	РегистрНакопления.ОплатаСчетовИЗаказов.Изменения КАК ОплатаСчетовИЗаказовИзменения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОплатаСчетовИЗаказов КАК ОплатаСчетовИЗаказов
	|		ПО ОплатаСчетовИЗаказовИзменения.Регистратор = ОплатаСчетовИЗаказов.Регистратор
	|ГДЕ
	|	ОплатаСчетовИЗаказовИзменения.Узел = &УзелОбменаЗаказы
	|	И ВЫРАЗИТЬ(ОплатаСчетовИЗаказов.СчетНаОплату КАК Документ.ЗаказПокупателя) ССЫЛКА Документ.ЗаказПокупателя
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втНоменклатура.Ссылка,
	|	""Услуги""
	|ИЗ
	|	втНоменклатура КАК втНоменклатура
	|ГДЕ
	|	втНоменклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КлючевыеРесурсыИзменения.Ссылка,
	|	""Ресурсы""
	|ИЗ
	|	Справочник.КлючевыеРесурсы.Изменения КАК КлючевыеРесурсыИзменения
	|ГДЕ
	|	КлючевыеРесурсыИзменения.Узел = &УзелОбменаУслуги
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КлючевыеРесурсыПрисоединенныеФайлы.ВладелецФайла,
	|	""Ресурсы""
	|ИЗ
	|	Справочник.КлючевыеРесурсыПрисоединенныеФайлы.Изменения КАК КлючевыеРесурсыПрисоединенныеФайлыИзменения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючевыеРесурсыПрисоединенныеФайлы КАК КлючевыеРесурсыПрисоединенныеФайлы
	|		ПО КлючевыеРесурсыПрисоединенныеФайлыИзменения.Ссылка = КлючевыеРесурсыПрисоединенныеФайлы.Ссылка
	|ГДЕ
	|	КлючевыеРесурсыПрисоединенныеФайлыИзменения.Узел = &УзелОбменаУслуги
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГрафикиРаботыРесурсовИзменения.РесурсПредприятия,
	|	""Ресурсы""
	|ИЗ
	|	РегистрСведений.ГрафикиРаботыРесурсов.Изменения КАК ГрафикиРаботыРесурсовИзменения
	|ГДЕ
	|	ГрафикиРаботыРесурсовИзменения.Узел = &УзелОбменаУслуги
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтклоненияОтГрафиковРаботыРесурсовИзменения.РесурсПредприятия,
	|	""Ресурсы""
	|ИЗ
	|	РегистрСведений.ОтклоненияОтГрафиковРаботыРесурсов.Изменения КАК ОтклоненияОтГрафиковРаботыРесурсовИзменения
	|ГДЕ
	|	ОтклоненияОтГрафиковРаботыРесурсовИзменения.Узел = &УзелОбменаУслуги
	|	И ОтклоненияОтГрафиковРаботыРесурсовИзменения.РесурсПредприятия ССЫЛКА Справочник.КлючевыеРесурсы");
	
	Запрос.УстановитьПараметр("УзелОбменаТовары", Параметры.УзелОбменаТовары);
	Запрос.УстановитьПараметр("УзелОбменаУслуги", Параметры.УзелОбменаУслуги);
	Запрос.УстановитьПараметр("УзелОбменаЗаказы", Параметры.УзелОбменаЗаказы);
	Запрос.УстановитьПараметр("ВидыЦен", Параметры.ВидыЦен.ВыгрузитьКолонку("ВидЦен"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураИзменений[Выборка.ТипСсылки].Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СтруктураИзменений;
	
КонецФункции

&НаСервере
Функция СформироватьJSONОплаты(СсылкаНаЗаказ,order_id) 
	ДанныеОплаты = Новый Структура;
//	ДанныеОплаты.Вставить("order_id",Строка(СсылкаНаЗаказ.УникальныйИдентификатор));
 	ДанныеОплаты.Вставить("order_id",order_id);
	ИтоговаяСумма = ?(ЗначениеЗаполнено(СсылкаНаЗаказ.СуммаДокумента), СсылкаНаЗаказ.СуммаДокумента, 0);
	ИтоговаяСумма = Окр(ИтоговаяСумма, 2); 
	ДанныеОплаты.Вставить("amount", ИтоговаяСумма);
	ДанныеОплаты.Вставить("currency", "KZT");
	ДанныеОплаты.Вставить("payment_method", "card_online");
	ОписаниеПлатежа = "Оплата заказа №" + СсылкаНаЗаказ.Номер;
	Если ЗначениеЗаполнено(СсылкаНаЗаказ.Контрагент) Тогда
		ОписаниеПлатежа = ОписаниеПлатежа + " (" + Строка(СсылкаНаЗаказ.Контрагент) + ")";
	КонецЕсли;
	ДанныеОплаты.Вставить("description", ОписаниеПлатежа);
	
	tiptoppay_id = ПолучитьДопРеквизит(СсылкаНаЗаказ, "tiptoppay_id");
	Если Не ПустаяСтрока(tiptoppay_id) Тогда 
		ДанныеОплаты.Вставить("tiptoppay_id", tiptoppay_id);
	Иначе	
		ПространствоTipTopPay = Новый УникальныйИдентификатор("4b46b020-f13d-11ed-a05b-0242ac120003");
		ИдентификаторТранзакции = Новый УникальныйИдентификатор(ВерсияУникальногоИдентификатора.Версия5, 
		ПространствоTipTopPay,	Строка(СсылкаНаЗаказ.УникальныйИдентификатор() ));
		ДанныеОплаты.Вставить("tiptoppay_id", Строка(ИдентификаторТранзакции));
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеОплаты);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Возврат СтрокаJSON;
КонецФункции	

&НаСервере
Функция СформироватьJSONИзЗаказаПокупателя(СсылкаНаЗаказ) Экспорт
	
	data = Новый Структура;
	
	НомерСтрокой = СтрЗаменить(СсылкаНаЗаказ.Номер, " ", "");
	data.Вставить("order_number", ИзвлечьЧислоИзНомера(НомерСтрокой));
	data.Вставить("created_at"	, Формат(СсылкаНаЗаказ.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss+03:00"));
	
	Получатель = Новый Структура;
	Получатель.Вставить("full_name", Строка(СсылкаНаЗаказ.Контрагент));
	
	Получатель.Вставить("phone", ПолучитьКИКонтрагента(СсылкаНаЗаказ.Контрагент, Перечисления.ТипыКонтактнойИнформации.Телефон));
	Получатель.Вставить("email", ПолучитьКИКонтрагента(СсылкаНаЗаказ.Контрагент, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты));
	data.Вставить("recipient", Получатель);
	
	ВариантДоставки = СсылкаНаЗаказ.СпособДоставки;
	СпособПолучения = ?(ВариантДоставки = Перечисления.СпособыДоставки.Самовывоз,"pickup","delivery");
	data.Вставить("delivery_method", СпособПолучения);
	
	АдресДоставки = Новый Структура;
	АдресДоставки.Вставить("address", СсылкаНаЗаказ.АдресДоставки);
	
	Координаты = Новый Структура;
	Координаты.Вставить("latitude", 0);
	Координаты.Вставить("longitude", 0);
	АдресДоставки.Вставить("coordinates", Координаты);
	
	АдресДоставки.Вставить("courier_comment", СсылкаНаЗаказ.Комментарий); // Или СсылкаНаЗаказ.КомментарийКДоставке
	data.Вставить("delivery_address", АдресДоставки);
	
	data.Вставить("time_slot", Строка(СсылкаНаЗаказ.ВремяДоставкиС) + "-" + Строка(СсылкаНаЗаказ.ВремяДоставкиПо));
	
	data.Вставить("payment_method", "card_online");
//	data.Вставить("tiptoppay_session_id", ПолучитьДопРеквизит(СсылкаНаЗаказ, "TipTopPay_SessionID"));
	
	МассивТоваров = Новый Массив;
	СуммаБезСкидкиОбщая = 0;
	СуммаСкидкиОбщая = 0;
	
	Для Каждого СтрокаТЧ Из СсылкаНаЗаказ.Запасы Цикл
		
		// Пропускаем услугу доставки, если она включена в табличную часть товаров
		Если СтрокаТЧ.Номенклатура = СсылкаНаЗаказ.НоменклатураДоставки Тогда
			Продолжить;
		КонецЕсли;
		
		Товар = Новый Структура;
		Товар.Вставить("scan_id", СтрокаТЧ.Номенклатура.Штрихкод); // Или .Код / .Артикул
		Товар.Вставить("item_id", Строка(СтрокаТЧ.Номенклатура.УникальныйИдентификатор())); // Или .Код / .Артикул
		Товар.Вставить("name", СтрокаТЧ.Номенклатура.Наименование);
		Товар.Вставить("quantity", СтрокаТЧ.Количество);
		
		Цена = СтрокаТЧ.Цена; 
		Товар.Вставить("price", Цена);
		
		МассивТоваров.Добавить(Товар);
		
		// Считаем суммы для итогов
		СуммаБезСкидкиОбщая = СуммаБезСкидкиОбщая + (СтрокаТЧ.Цена * СтрокаТЧ.Количество);
		СуммаСкидкиОбщая    = СуммаСкидкиОбщая + СтрокаТЧ.СуммаАвтоматическойСкидки + СтрокаТЧ.СуммаСкидкиНаценки;
		
	КонецЦикла;
	data.Вставить("items", МассивТоваров);
	
	data.Вставить("total_items_price_without_discount", СуммаБезСкидкиОбщая);
	data.Вставить("total_discount_amount", СуммаСкидкиОбщая);
	data.Вставить("delivery_price", СсылкаНаЗаказ.СтоимостьДоставки);
	data.Вставить("final_amount", СсылкаНаЗаказ.СуммаДокумента);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, data);
	
	СтрокаРезультат = ЗаписьJSON.Закрыть();
	
	Возврат СтрокаРезультат;
КонецФункции

Функция ПолучитьКИКонтрагента(Контрагент, ТипКИ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтрагентыКонтактнаяИнформация.Представление КАК Представление
		|ИЗ
		|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
		|ГДЕ
		|	КонтрагентыКонтактнаяИнформация.Ссылка = &Контрагент
		|	И КонтрагентыКонтактнаяИнформация.Тип = &ТипКИ";
		
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ТипКИ", ТипКИ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Представление;
	КонецЕсли;
	
	Возврат "";
КонецФункции
&НаСервере
Функция ПолучитьДопРеквизит(СсылкаНаЗаказ, ИмяРеквизита)
	Для Каждого Стр Из СсылкаНаЗаказ.ДополнительныеРеквизиты Цикл
		Если Стр.Свойство.Имя = ИмяРеквизита Тогда
			Возврат Стр.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Очистка номера от префиксов 1С, чтобы получить число
&НаСервере
Функция ИзвлечьЧислоИзНомера(Знач Номер)
	// Удаляем текстовые префиксы, оставляем только цифры
	Результат = "";
	Для Позиция = 1 По СтрДлина(Номер) Цикл
		Символ = Сред(Номер, Позиция, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ПустаяСтрока(Результат), 0, Число(Результат));
КонецФункции


Функция  ПричинаОтменыОтказЧерезПриложение()
	Возврат Справочники.ПричиныОтменыЗаказа.НайтиПоНаименованию("Клиент отменил",Истина);
