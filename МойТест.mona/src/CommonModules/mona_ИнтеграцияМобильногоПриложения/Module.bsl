	         |		ИзмененияЦен.Узел = &Узел
	         |	
	         |	ОБЪЕДИНИТЬ
	         |	
	         |	ВЫБРАТЬ РАЗЛИЧНЫЕ
	         |		ИзмененияЗапасов.Номенклатура,
	         |		3,
	         |		ИзмененияЗапасов.Характеристика
	         |	ИЗ
	         |		РегистрСведений.ОстаткиТоваров.Изменения КАК ИзмененияЗапасов
	         |	ГДЕ
	         |		ИзмененияЗапасов.Узел = &Узел) КАК ВсеИзменения
	         |;
	         |
	         |////////////////////////////////////////////////////////////////////////////////
	         |ВЫБРАТЬ
	         |	ЗапасыОстатки.Номенклатура КАК Номенклатура,
	         |	СУММА(ЗапасыОстатки.Количество) КАК Остаток,
	         |	СУММА(ЗапасыОстатки.Резерв) КАК Резерв,
	         |	ЗапасыОстатки.Характеристика КАК Характеристика
	         |ПОМЕСТИТЬ ВТ_Остатки
	         |ИЗ
	         |	РегистрСведений.ОстаткиТоваров КАК ЗапасыОстатки
	         |ГДЕ
	         |	ЗапасыОстатки.СтруктурнаяЕдиница В(&СписокСкладов)
	         |	И ЗапасыОстатки.Номенклатура В
	         |			(ВЫБРАТЬ
	         |				ВТ.Номенклатура
	         |			ИЗ
	         |				ВТ_Изменения КАК ВТ)
	         |
	         |СГРУППИРОВАТЬ ПО
	         |	ЗапасыОстатки.Номенклатура,
	         |	ЗапасыОстатки.Характеристика
	         |;
	         |
	         |////////////////////////////////////////////////////////////////////////////////
	         |ВЫБРАТЬ РАЗЛИЧНЫЕ
	         |	ВТ_Изменения.Номенклатура КАК Номенклатура,
	         |	ВТ_Изменения.ИсточникИзменения КАК ИсточникИзменения,
	         |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ТаблицаОстатков.Характеристика) КАК external_id,
	         |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ТаблицаОстатков.Номенклатура) КАК external_product_id,
	         |	Товары.Наименование КАК name_ru,
	         |	ВЫБОР
	         |		КОГДА Товары.mona_НаименованиеНаКазахский = """"
	         |			ТОГДА Товары.Наименование
	         |		ИНАЧЕ Товары.mona_НаименованиеНаКазахский
	         |	КОНЕЦ КАК name_kz,
	         |	Товары.Штрихкод КАК sku,
	         |	ЕСТЬNULL(ТаблицаЦен.Цена, 0) КАК price,
	         |	ВЫБОР
	         |		КОГДА ЕСТЬNULL(ТаблицаОстатков.Остаток, 0) - ЕСТЬNULL(ТаблицаОстатков.Резерв, 0) < 0
	         |			ТОГДА 0
	         |		ИНАЧЕ ЕСТЬNULL(ТаблицаОстатков.Остаток, 0) - ЕСТЬNULL(ТаблицаОстатков.Резерв, 0)
	         |	КОНЕЦ КАК stock,
	         |	ВЫБОР
	         |		КОГДА Товары.mona_ПризнакПродажиОнлайн
	         |			ТОГДА ""active""
	         |		ИНАЧЕ ""inactive""
	         |	КОНЕЦ КАК status
	         |ИЗ
	         |	ВТ_Изменения КАК ВТ_Изменения
	         |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	         |		ПО ВТ_Изменения.Номенклатура = Товары.Ссылка
	         |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	         |				,
	         |				ВидЦен = &ВидЦен
	         |					И Номенклатура В
	         |						(ВЫБРАТЬ
	         |							ВТ.Номенклатура
	         |						ИЗ
	         |							ВТ_Изменения КАК ВТ)) КАК ТаблицаЦен
	         |		ПО ВТ_Изменения.Номенклатура = ТаблицаЦен.Номенклатура
	         |			И ВТ_Изменения.Характеристика = ТаблицаЦен.Характеристика
	         |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ТаблицаОстатков
	         |		ПО ВТ_Изменения.Номенклатура = ТаблицаОстатков.Номенклатура
	         |			И ВТ_Изменения.Характеристика = ТаблицаОстатков.Характеристика
	         |ГДЕ
	         |	НЕ Товары.ЭтоГруппа
	         |	И Товары.mona_ПризнакПродажиОнлайн = ИСТИНА
	         |
	         |УПОРЯДОЧИТЬ ПО
	         |	external_product_id,
	         |	external_id";
КонецФункции



Функция ПолучитьКарточкуТовара(ИдентификаторТовара,СтруктураОтвета)
	Попытка
		УникальныйИдентификатор = Новый УникальныйИдентификатор(ИдентификаторТовара);
		СсылкаНоменклатура = Справочники.Номенклатура.ПолучитьСсылку(УникальныйИдентификатор);
	Исключение
		отказ = Истина;
		Возврат Новый Структура("status,КодСостояния,message","error",404, "Некорректный формат UUID товара");
	КонецПопытки;

	Карточка = Новый Структура;
	Карточка.Вставить("id", ИдентификаторТовара);
	Карточка.Вставить("name", СсылкаНоменклатура.Наименование);
	Карточка.Вставить("description", СсылкаНоменклатура.НаименованиеПолное);
	Карточка.Вставить("sku", СсылкаНоменклатура.Артикул);
	Карточка.Вставить("isGroup", СсылкаНоменклатура.ЭтоГруппа);
	
	// Варианты / Характеристики товара
	МассивВариантов = Новый Массив;
	
	//Вариант1 = Новый Структура("id, barcode, price, stock", "var_test_01", "4600000000001", 150.00, 10);
	Вариант1 = Новый Структура("id, barcode, price, stock");
	МассивВариантов.Добавить(Вариант1);
	Карточка.Вставить("variants", МассивВариантов);
	СтруктураОтвета.status  = "success";
	СтруктураОтвета.data = Карточка;
	Возврат СтруктураОтвета;
	
КонецФункции
