Функция ТекстПолученияВарианты(external_id = Неопределено)
//data array Массив вариантов
//data[].external_id string ID варианта в 1С
//data[].external_product_id string ID товара в 1С
//Naturalia · Спецификация API «Интеграция с 1С» · v5 (проект) · стр. 8 из 17
//Поле Тип Описание
//data[].name_ru / name_kz string Название варианта (ru / kz)
//data[].sku string Артикул варианта
//data[].price decimal Цена продажи варианта, KZT
//data[].stock integer Остаток на складе (единый магазин/склад — разд.
//1.2, А.4)
//data[].status string active | inactive
//next integer | null Смещение следующей страницы; null — конец

Возврат  "ВЫБРАТЬ
         |	ЗапасыОстатки.Номенклатура КАК Номенклатура,
         |	СУММА(ЗапасыОстатки.Количество) КАК Остаток,
         |	СУММА(ЗапасыОстатки.Резерв) КАК Резерв,
         |	ЗапасыОстатки.Характеристика КАК Характеристика
         |ПОМЕСТИТЬ ВТ_Остатки
         |ИЗ
         |	РегистрСведений.ОстаткиТоваров КАК ЗапасыОстатки
         |ГДЕ
         |	ЗапасыОстатки.СтруктурнаяЕдиница В(&СписокСкладов)
         |
         |СГРУППИРОВАТЬ ПО
         |	ЗапасыОстатки.Номенклатура,
         |	ЗапасыОстатки.Характеристика
         |;
         |
         |////////////////////////////////////////////////////////////////////////////////
         |ВЫБРАТЬ РАЗЛИЧНЫЕ
         |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ТаблицаОстатков.Характеристика) КАК external_id,
         |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Товары.Ссылка) КАК external_product_id,
         |	Товары.Наименование КАК name_ru,
         |	ВЫБОР
         |		КОГДА Товары.mona_НаименованиеНаКазахский = """"
         |			ТОГДА Товары.Наименование
         |		ИНАЧЕ Товары.mona_НаименованиеНаКазахский
         |	КОНЕЦ КАК name_kz,
         |	Товары.Штрихкод КАК sku,
         |	ЕСТЬNULL(ТаблицаЦен.Цена, 0) КАК price,
         |	ВЫБОР
         |		КОГДА ЕСТЬNULL(ТаблицаОстатков.Остаток, 0) - ЕСТЬNULL(ТаблицаОстатков.Резерв, 0) < 0
         |			ТОГДА 0
         |		ИНАЧЕ ЕСТЬNULL(ТаблицаОстатков.Остаток, 0) - ЕСТЬNULL(ТаблицаОстатков.Резерв, 0)
         |	КОНЕЦ КАК stock,
         |	ВЫБОР
         |		КОГДА Товары.mona_ПризнакПродажиОнлайн
         |			ТОГДА ""active""
         |		ИНАЧЕ ""inactive""
         |	КОНЕЦ КАК status
         |ИЗ
         |	ВТ_Остатки КАК ТаблицаОстатков
         |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
         |		ПО ТаблицаОстатков.Номенклатура = Товары.Ссылка
         |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦен = &ВидЦен) КАК ТаблицаЦен
         |		ПО ТаблицаОстатков.Номенклатура = ТаблицаЦен.Номенклатура
         |			И ТаблицаОстатков.Характеристика = ТаблицаЦен.Характеристика
 	     |ГДЕ
	     |	НЕ Товары.ЭтоГруппа" +
             ?(external_id = Неопределено
		 	," И Товары.mona_ПризнакПродажиОнлайн = ИСТИНА"
			," И УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Товары.Ссылка) = &external_id")
	         + "
         |УПОРЯДОЧИТЬ ПО
         |	external_product_id,
         |	external_id";
	
КонецФункции
