// POST    /hs/monapi/v1/orders/cancel  - клиент нажал отмену на фронте до сборки status (Cancelled)
Функция ЗафиксироватьОтменуЗаказа(ДанныеЗапроса,СтруктураОтвета) Экспорт
 	Запись = ПолучитьЗаписьЗаказаОнлайн(ДанныеЗапроса.Идентификатор);
	СтруктураОтвета.order_id = Запись.order_id; //Запись.Заказ.УникальныйИдентификатор(); 
	
	Если mona_СтатусыЗаказов.ЭтоОтменаДоОтгрузки(Запись.СостояниеЗаказа) Тогда 
		ДокЗаказ = Запись.Заказ.ПолучитьОбъект();
		ДокЗаказ.СостояниеЗаказа = mona_СтатусыЗаказов.Отменен();
	    ПричинаОтмены = ПричинаОтменыОтказЧерезПриложение(); 
		ДокЗаказ.ПричинаОтмены = ПричинаОтмены; 
		Попытка
		ДокЗаказ.Записать();
	Исключение
			// не удалось записать отмену заказа	
				СтруктураОтвета.status 	 = "error"; 
				СтруктураОтвета.message = "не удалось записать отмену заказа"; 
				Возврат Ложь;
	КонецПопытки;
		Запись.ПричинаОтмены = ПричинаОтмены;
		Запись.ЗаказОтменен = Истина;
	    Запись.МоментОтмены = ТекущаяДата();
		Запись.Записать();
	КонецЕсли;	
	ЧекСразу = Ложь;
	СтруктураОтвета.order_id = Запись.order_id; //Запись.Заказ.УникальныйИдентификатор(); 
	СтруктураОтвета.message = "Заказ отменен"; 
	СтруктураОтвета.status = Строка(mona_СтатусыЗаказов.Отменен());  //Егор - вставил строку т.к. ответ не уходит 
	Возврат Истина;
КонецФункции


