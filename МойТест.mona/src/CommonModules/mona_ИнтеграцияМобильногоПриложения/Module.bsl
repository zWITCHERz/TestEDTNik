// СтатусыДоОтмены передаётся только если СостояниеЗаказа = "Отменён" —
// используется, чтобы понять, отменили заказ до или после отгрузки,
// и вернуть в приложение соответствующий статус.
Функция СтатусДляПриложения(СостояниеЗаказа, СтатусыДоОтмены = Неопределено) Экспорт
	Данные = mona_СтатусыЗаказов.ДанныеСостояний();
	ИмяТекущегоСостояния = Строка(СостояниеЗаказа);
	ТекущееСостояние = Данные[ИмяТекущегоСостояния];

	Если ТекущееСостояние = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если СостояниеЗаказа = mona_СтатусыЗаказов.Отменен() Тогда
		Если mona_СтатусыЗаказов.ЭтоОтменаДоОтгрузки(СтатусыДоОтмены) Тогда
			Возврат "cancelled-before-shipment";
		Иначе
			Возврат "cancelled-after-shipment";
		КонецЕсли;
	КонецЕсли;

	Возврат ТекущееСостояние.status;
КонецФункции  

Функция ПолучитьЗаписьВозврата(Заказ) Экспорт
	Запись = РегистрыСведений.mona_Возвраты.СоздатьМенеджерЗаписи();
