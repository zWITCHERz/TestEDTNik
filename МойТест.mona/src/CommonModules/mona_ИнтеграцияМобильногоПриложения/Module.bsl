// POST    /hs/monapi/v1/orders/create  - создание заказа  возврат  order_id , status (created)
&НаСервере
Функция ЗафиксироватьСозданиеНовогоЗаказа(ДанныеЗапроса,СтруктураОтвета) Экспорт
	ДокОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
	ДокОбъект.Дата = XMLЗначение(Тип("Дата"),ДанныеЗапроса.created_at);
	Если Не ПустаяСтрока(ДанныеЗапроса.delivery_type) и СтрНайти("pickup,courier",ДанныеЗапроса.delivery_type) > 0 Тогда 
		ДокОбъект.ВидЗаказа = mona_ОбработкаИнтернетЗаказа.ВидЗаказаИнтернет(ДанныеЗапроса.delivery_type);  
	Иначе
		СтруктураОтвета.Вставить("error",Новый Структура("code,mesage","VALIDATION_ERROR","delivery_method error:" +ДанныеЗапроса.delivery_type)); 
		Возврат Ложь;	
	КонецЕсли;
	
	
	
	
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	ДокСсылка = ДокОбъект.Ссылка;
	
	НоваяЗапись = РегистрыСведений.ЗаказыОнлайн.СоздатьМенеджерЗаписи();
	НоваяЗапись.ВидЗаказа = ДокСсылка.ВидЗаказа; 
	НоваяЗапись.Заказ = ДокСсылка;
	НоваяЗапись.Idempotency_Key = ДанныеЗапроса.Заголовки["Idempotency-Key"];
	НоваяЗапись.order_number = СокрЛП(ДанныеЗапроса.external_id);
	НоваяЗапись.order_id 	= Строка(ДокСсылка.УникальныйИдентификатор()); 
	НоваяЗапись.КодJSON = Новый ХранилищеЗначения(ДанныеЗапроса.КодJSON,Новый СжатиеДанных(9)); 
	НоваяЗапись.Записать(); 
	

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ДокСсылка);
	ПараметрыЗадания.Добавить(ДанныеЗапроса.КодJSON);
	
	mona_ОбработкаИнтернетЗаказа.ЗаполнитьЗаказИзРегистраФоновое(ПараметрыЗадания);
	
	//ФоновыеЗадания.Выполнить(
	//	"mona_ОбработкаИнтернетЗаказа.ЗаполнитьЗаказИзРегистраФоновое", // Имя метода: ИмяОбщегоМодуля.ИмяПроцедуры
	//	ПараметрыЗадания, 
	//	"ЗаполнениеЗаказа_" + ДанныеЗапроса.order_number // Ключ (название) задания для администрирования
	//);
   	СтруктураОтвета = Новый Структура("id,external_id,status,created_at,total_price");
	СтруктураОтвета.id = НоваяЗапись.order_id; //Запись.Заказ.УникальныйИдентификатор(); 
	СтруктураОтвета.external_id = НоваяЗапись.order_number; //Запись.Заказ.УникальныйИдентификатор(); 
//	СтруктураОтвета.message = "Заказ успешно создан";
	//СтруктураОтвета.status = mona_СтатусыЗаказов.СтатусДляПриложения(ДокОбъект.СостояниеЗаказа);
	СтруктураОтвета.status = mona_ОтправкаВМобильноеПриложение.ПолучитьСтатусДляПриложения(Строка(ДокОбъект.СостояниеЗаказа));
    СтруктураОтвета.created_at = Формат(ДокСсылка.Дата,fISO8601()); 
    СтруктураОтвета.total_price = ДанныеЗапроса.total_price; 
	Возврат Истина;

КонецФункции
&НаСервере
Функция ОшибкаЗаполненияЗаказа(ДанныеЗапроса,СтруктураОтвета) Экспорт
 Отказ = Ложь;	
 СтрокаПолей = "external_id,created_at,payment_method,payment_status,
 |delivery_type,delivery_address,delivery_address_details,delivery_comment,delivery_slot_from,delivery_slot_to,
 |items_price,discount,delivery_price,total_price,recipient,items";
 МассивПолей = СтрРазделить(СтрокаПолей,",");	
// НетПолей	= Новый Массив;
 СтрокаНетПолей = "";

	Для каждого стр из МассивПолей Цикл
    	Если Не ДанныеЗапроса.Свойство(стр) Тогда
			СтрокаНетПолей =  СтрокаНетПолей + стр+";"; // Найдено отсутствующее поле
		КонецЕсли;
	
		
	КонецЦикла;	
	Если Не ПустаяСтрока(СтрокаНетПолей) Тогда 
		СтруктураОтвета.Вставить("error",Новый Структура("code,mesage","VALIDATION_ERROR","Отстутствуют поля: "+ СтрокаНетПолей)); 
        Отказ = Истина;
	ИначеЕсли ПустаяСтрока(ДанныеЗапроса.delivery_type) и СтрНайти("pickup,courier",ДанныеЗапроса.delivery_type) > 0 Тогда 
		СтруктураОтвета.Вставить("error",Новый Структура("code,mesage","VALIDATION_ERROR","delivery_method error:" +ДанныеЗапроса.delivery_method)); 
        Отказ = Истина;
	Иначе 
		СтрокаПолейТоварыВсе = "external_product_id,external_variant_id,sku,name_ru,name_kz,quantity,price";
		СтрокаПолейТовары = "external_product_id,quantity,price";
		МассивПолейТовары = СтрРазделить(СтрокаПолейТовары,",");
		total_price = 0;
		Для Каждого строчка из ДанныеЗапроса.items Цикл
			СтрокаНетПолейТовары = "";
			Для каждого стр из МассивПолейТовары Цикл
		    	Если Не строчка.Свойство(стр) Тогда
					СтрокаНетПолейТовары =  СтрокаНетПолейТовары + стр+";"; // Найдено отсутствующее поле
				КонецЕсли;
			КонецЦикла;	
			Если ПустаяСтрока(СтрокаНетПолейТовары) Тогда 
            	total_price = total_price + строчка.price*строчка.quantity;
			Иначе
				СтруктураОтвета.Вставить("error",Новый Структура("code,mesage","VALIDATION_ERROR","Отстутствуют поля: "+ СтрокаНетПолейТовары)); 
		        Отказ = Истина;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	Если не отказ Тогда 
 		Разница = total_price + ДанныеЗапроса.delivery_price - ДанныеЗапроса.total_price;
		Если Разница <> 0 Тогда 
			СтруктураОтвета.Вставить("error",Новый Структура("code,mesage","VALIDATION_ERROR","Рассогласование сумм: "+ Разница)); 
        	отказ = Истина;
		КонецЕсли;	
	КонецЕсли;
    Возврат отказ;
КонецФункции	

Функция ОшибкаТоваровВЗаказе(ДанныеЗапроса,СтруктураОтвета) Экспорт
	Отказ = Ложь;	
	Для Каждого строчка из ДанныеЗапроса.items Цикл
		Попытка
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(строчка.external_product_id));
			строчка.Вставить("Номенклатура",Номенклатура);
		Исключение
			СтруктураОтвета.Вставить("error",Новый Структура("code,mesage","PRODUCT_NOT_FOUND","Не правильный external_product_id для продукта: "+ строчка.external_product_id)); 
	        Отказ = Истина;
			Возврат Отказ;	
		КонецПопытки;
    	Если ДанныеЗапроса.Свойство("external_variant_id") Тогда 
			Попытка
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(строчка.external_variant_id));
			Исключение
				СтруктураОтвета.Вставить("error",Новый Структура("code,mesage","VARIANT_NOT_FOUND","Не правильный external_id для варианта: "+ строчка.external_variant_id)); 
		        Отказ = Истина;
			КонецПопытки;  
		Иначе 
        	Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();	
			строчка.Вставить("ХарактеристикаНоменклатуры",Характеристика);
		КонецЕсли;
	КонецЦикла;	
    Возврат отказ;
КонецФункции	

Функция ОтсутствиеНаСкладе(ДанныеЗапроса,СтруктураОтвета) Экспорт
	Отказ = Ложь;	
	Для Каждого строчка из ДанныеЗапроса.items Цикл
		ТочкиОтгрузки  = Справочники.mona_ТочкиОтгрузки.ПоУмолчанию();
		МассивСкладов = Новый Массив();
		МассивСкладов.Добавить(ТочкиОтгрузки.Склад);
		
		Характеристика = строчка.ХарактеристикаНоменклатуры;
//		Попытка
//			Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(строчка.external_variant_id));
//		Исключение
////			СтруктураОтвета.Вставить("error",Новый Структура("code,mesage","VARIANT_NOT_FOUND","Не правильный external_id для варианта: "+ строчка.external_variant_id)); 
////	        Отказ = Истина;
//            Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
//		КонецПопытки;
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ЗапасыОстатки.Номенклатура КАК Номенклатура,
		                      |	ЗапасыОстатки.Количество КАК Остаток,
		                      |	ЗапасыОстатки.Резерв КАК Резерв
		                      |ИЗ
		                      |	РегистрСведений.ОстаткиТоваров КАК ЗапасыОстатки
		                      |ГДЕ
		                      |	ЗапасыОстатки.СтруктурнаяЕдиница В(&СписокСкладов)
		                      |	И УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗапасыОстатки.Номенклатура) = &external_product_id
		                      |	И ЗапасыОстатки.Характеристика = &Характеристика");
		Запрос.УстановитьПараметр("СписокСкладов",МассивСкладов);
		Запрос.УстановитьПараметр("external_product_id",Новый УникальныйИдентификатор(строчка.external_product_id));
//		Запрос.УстановитьПараметр("external_variant_id",строчка.external_variant_id);
		Запрос.УстановитьПараметр("Характеристика",Характеристика);
        Выб = Запрос.Выполнить().Выбрать();
		details = Новый Массив();
		Пока Выб.Следующий() Цикл  
			Если строчка.quantity > (Выб.Остаток - Выб.Резерв) Тогда 
				detail = Новый Структура("external_product_id,requested,available"
												,строчка.external_product_id												
												,строчка.quantity,Выб.Остаток - Выб.Резерв);
				Если строчка.Свойство("external_variant_id") Тогда 
					detail.Вставить("external_variant_id",строчка.external_variant_id);										
				КонецЕсли;								
				details.Добавить(detail);								
			КонецЕсли;	
		КонецЦикла;;
	КонецЦикла;	
	Если details.Количество() > 0 Тогда 
		СтруктураОтвета.Вставить("error",Новый Структура("code,mesage","INSUFFICIENT_STOCK","Недостаточно остатка.")); 
		СтруктураОтвета.error.Вставить("details",details);
        Отказ = Истина;
	КонецЕсли;	

	
	
	Возврат отказ;
КонецФункции	

