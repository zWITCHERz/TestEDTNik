//Подрядчик публикует в 1С веб-сервис, принимающий и возвращающий данные в формате JSON (кодировка UTF-8). 
// См. HTTP-сервисы  mona_HTTP 

//Канал доступен мобильному приложению по сети через внешний адрес. Обмен выполняется по защищённому соединению HTTPS с действующим TLS-сертификатом домена. 
//     /hs/monapi

//Авторизация — по логину/паролю выделенного пользователя 1С с минимально необходимыми правами (роль «Сервис обмена с приложением»).

//Веб-сервис версионируется. Базовый URL включает префикс версии: /monapi/v1/... Изменения, нарушающие обратную совместимость, выпускаются под новым префиксом /v2/. Это позволяет deploy 1С и приложения независимо.
//	/v1/{ИмяСценария}/{Идентификатор}  Функция monaPOST(Запрос)

Функция РазборЗапроса(Запрос) Экспорт 
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если ПустаяСтрока(СтрокаJSON) Тогда 
		ДанныеЗапроса = Новый Структура("ПустойЗапрос",Истина);
	Иначе 	
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ДанныеЗапроса.Вставить("ПустойЗапрос",Ложь);
		ДанныеЗапроса.Вставить("кодJSON",СтрокаJSON);
		ЧтениеJSON.Закрыть();
	КонецЕсли;
	Для Каждого стр из Запрос.ПараметрыЗапроса Цикл
		ДанныеЗапроса.Вставить(стр.Ключ,стр.Значение);			
	КонецЦикла;
	Для Каждого стр из Запрос.ПараметрыURL Цикл
		ДанныеЗапроса.Вставить(стр.Ключ,стр.Значение);			
	КонецЦикла;
	ДанныеЗапроса.Вставить("Заголовки",Запрос.Заголовки);			
	Возврат ДанныеЗапроса;
КонецФункции 

Функция РазборЗапросаЯндекс(Запрос) Экспорт 
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
	ДанныеЗапроса.Вставить("кодJSON",СтрокаJSON);
	ЧтениеJSON.Закрыть();
	Возврат ДанныеЗапроса;
КонецФункции

Функция Ответ(СтруктураОтвета,КодОтвета = 200) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	Возврат Ответ;

КонецФункции

