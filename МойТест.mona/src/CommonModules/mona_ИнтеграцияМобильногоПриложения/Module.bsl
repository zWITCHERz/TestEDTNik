Функция ПолучитьДанныеТовара(СсылкаНоменклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.Артикул КАК Артикул,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена,
	|	ЕСТЬNULL(Запасы.ВНаличииОстаток, 0) КАК Остаток
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Номенклатура = &Номенклатура) КАК Цены
	|	ПО (ИСТИНА)
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Запасы.Остатки(, Номенклатура = &Номенклатура) КАК Запасы
	|	ПО (ИСТИНА)
	|ГДЕ
	|	Номенклатура.Ссылка = &Номенклатура";
	
	// Примечание: Вид цены и Склад в реальной базе нужно ограничить параметрами (например, Розничная цена)
	Запрос.УстановитьПараметр("Номенклатура", СсылкаНоменклатура);
	Рез = Запрос.Выполнить().Выбрать();
	
	ТоварСтруктура = Новый Структура;
	Если Рез.Следующий() Тогда
		ТоварСтруктура.Вставить("id",           Строка(Рез.Ссылка.УникальныйИдентификатор()));
		ТоварСтруктура.Вставить("sku",          Рез.Артикул);
		ТоварСтруктура.Вставить("title",        Рез.Наименование);
		ТоварСтруктура.Вставить("cost_value",   Рез.Цена); // Число для JSON
		ТоварСтруктура.Вставить("stock",        Рез.Остаток); // Число для JSON
	КонецЕсли;
	
	Возврат ТоварСтруктура;
	
КонецФункции


