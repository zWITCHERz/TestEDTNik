Функция СформироватьИзмененияКаталога(СтрСтраница,СтрЛимит,отказ)  Экспорт
	ПропуститьСтрок = (СтрСтраница - 1) * СтрЛимит;
	Узел = ПланыОбмена.ИнтеграцияСИнтернетМагазиномТовары.НайтиПоКоду("NN");
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВсеИзменения.Номенклатура КАК Номенклатура,
	               |	ВсеИзменения.ИсточникИзменения КАК ИсточникИзменения
	               |ПОМЕСТИТЬ ВТ_Изменения
	               |ИЗ
	               |	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		Изменения.Ссылка КАК Номенклатура,
	               |		1 КАК ИсточникИзменения
	               |	ИЗ
	               |		Справочник.Номенклатура.Изменения КАК Изменения
	               |	ГДЕ
	               |		Изменения.Узел = &Узел
	               |	
	               |	ОБЪЕДИНИТЬ
	               |	
	               |	ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		ИзмененияЦен.Номенклатура,
	               |		2
	               |	ИЗ
	               |		РегистрСведений.ЦеныНоменклатуры.Изменения КАК ИзмененияЦен
	               |	ГДЕ
	               |		ИзмененияЦен.Узел = &Узел
	               |	
	               |	ОБЪЕДИНИТЬ
	               |	
	               |	ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		ИзмененияЗапасов.Номенклатура,
	               |		3
	               |	ИЗ
	               |		РегистрСведений.ОстаткиТоваров.Изменения КАК ИзмененияЗапасов
	               |	ГДЕ
	               |		ИзмененияЗапасов.Узел = &Узел) КАК ВсеИзменения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗапасыОстатки.Номенклатура КАК Номенклатура,
	               |	СУММА(ЗапасыОстатки.Количество) КАК Остаток,
	               |	СУММА(ЗапасыОстатки.Резерв) КАК Резерв
	               |ПОМЕСТИТЬ ВТ_Остатки
	               |ИЗ
	               |	РегистрСведений.ОстаткиТоваров КАК ЗапасыОстатки
	               |ГДЕ
	               |	ЗапасыОстатки.СтруктурнаяЕдиница В(&СписокСкладов)
	               |	И ЗапасыОстатки.Номенклатура В
	               |			(ВЫБРАТЬ
	               |				ВТ.Номенклатура
	               |			ИЗ
	               |				ВТ_Изменения КАК ВТ)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗапасыОстатки.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ_Изменения.Номенклатура КАК Номенклатура,
	               |	ВТ_Изменения.ИсточникИзменения КАК ИсточникИзменения,
	               |	ВЫБОР
	               |		КОГДА Товары.Ссылка ЕСТЬ NULL
	               |			ТОГДА ""delete""
	               |		ИНАЧЕ ""update""
	               |	КОНЕЦ КАК Действие,
	               |	Товары.Наименование КАК Наименование,
	               |	Товары.Штрихкод КАК Штрихкод,
	               |	ЕСТЬNULL(ТаблицаЦен.Цена, 0) КАК Цена,
	               |	ЕСТЬNULL(ТаблицаОстатков.Остаток, 0) КАК Остаток,
	               |	ЕСТЬNULL(ТаблицаОстатков.Резерв, 0) КАК Резерв,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ТаблицаОстатков.Остаток, 0) - ЕСТЬNULL(ТаблицаОстатков.Резерв, 0) < 0
	               |			ТОГДА 0
	               |		ИНАЧЕ ЕСТЬNULL(ТаблицаОстатков.Остаток, 0) - ЕСТЬNULL(ТаблицаОстатков.Резерв, 0)
	               |	КОНЕЦ КАК ЧистыйОстаток,
	               |	Товары.Родитель КАК Родитель,
	               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Товары.Ссылка) КАК id,
	               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Товары.Родитель.Ссылка) КАК parent_id
	               |ИЗ
	               |	ВТ_Изменения КАК ВТ_Изменения
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	               |		ПО ВТ_Изменения.Номенклатура = Товары.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |				,
	               |				ВидЦен = &ВидЦен
	               |					И Номенклатура В
	               |						(ВЫБРАТЬ
	               |							ВТ.Номенклатура
	               |						ИЗ
	               |							ВТ_Изменения КАК ВТ)) КАК ТаблицаЦен
	               |		ПО ВТ_Изменения.Номенклатура = ТаблицаЦен.Номенклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ТаблицаОстатков
	               |		ПО ВТ_Изменения.Номенклатура = ТаблицаОстатков.Номенклатура
	               |ГДЕ
	               |	НЕ Товары.ЭтоГруппа
	               |	И Товары.mona_ПризнакПродажиОнлайн = ИСТИНА
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	
	СкладЦена = mona_ОбработкаИнтернетЗаказа.СкладЦена();
	
	МассивСкладов = Новый Массив();
	МассивСкладов.Добавить(СкладЦена.Склад);
	
	Запрос.УстановитьПараметр("Узел",   Узел);
	Запрос.УстановитьПараметр("НомерСообщения",  0);
	Запрос.УстановитьПараметр("ВидЦен",   СкладЦена.ВидЦен); 
	Запрос.УстановитьПараметр("СписокСкладов",  МассивСкладов);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	// 3. Формируем массив товаров с учетом пагинации
	МассивТоваров = Новый Массив;
	СчетчикСтрок = 0;
	
	// Пропускаем строки предыдущих страниц
	Пока СчетчикСтрок < ПропуститьСтрок И Выборка.Следующий() Цикл
		СчетчикСтрок = СчетчикСтрок + 1;
	КонецЦикла;
	
	// Собираем данные для текущей страницы
	СтрокДобавлено = 0;
	Пока СтрокДобавлено < СтрЛимит И Выборка.Следующий() Цикл
		
		СтруктураТовара = Новый Структура;
		СтруктураТовара.Вставить("id",   Строка(Выборка.id));
		СтруктураТовара.Вставить("name", Выборка.Наименование);
		СтруктураТовара.Вставить("scan_code", Выборка.ШтрихКод);
		
		МассивТоваров.Добавить(СтруктураТовара);
		СтрокДобавлено = СтрокДобавлено + 1;
		
	КонецЦикла;
		
	 ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("page",  СтрСтраница);
	ОтветСтруктура.Вставить("limit", СтрЛимит);
	ОтветСтруктура.Вставить("count", МассивТоваров.Количество());
	ОтветСтруктура.Вставить("items", МассивТоваров);
	
	Каталог = Новый Структура("categories, products", Новый Массив, Новый Массив);
	// Пример заполнения структуры...
	Возврат Каталог;
КонецФункции

Функция ПолучитьКаталог(ДанныеЗапроса,СтруктураОтвета,ЭтоГруппы = Ложь,limit = 100)  Экспорт
	ЭтоВарианты = (ДанныеЗапроса.Сценарий = СценарийВариант());
	ИдЗапроса = ?(ДанныеЗапроса.Свойство("Идентификатор"),ДанныеЗапроса.Идентификатор,Неопределено);
	ЭтоОдинЭлемент = Ложь;
	Если Не ПустаяСтрока(ИдЗапроса) Тогда 
		Попытка
			external_id = Новый УникальныйИдентификатор(ИдЗапроса);
			ЭтоОдинЭлемент = Истина;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	
	ПропуститьСтрок = ?(ДанныеЗапроса.Свойство("next"),Число(ДанныеЗапроса.next),0);
    ТолькоИзменения = ?(ДанныеЗапроса.Свойство("changes_only"),ДанныеЗапроса.changes_only,false);
	Запрос = Новый Запрос;
	
	СкладЦена = mona_ОбработкаИнтернетЗаказа.СкладЦена();
	МассивСкладов = Новый Массив();
	МассивСкладов.Добавить(СкладЦена.Склад);
	
	Если ЭтоГруппы Тогда 
		Если ЭтоОдинЭлемент Тогда 
			Запрос.Текст = ТекстПолученияИерархии(external_id);
			Запрос.УстановитьПараметр("external_id",external_id); 
		Иначе
			Запрос.Текст = ТекстПолученияИерархии();
	    КонецЕсли;
    ИначеЕсли ЭтоОдинЭлемент Тогда 
		Если ЭтоВарианты Тогда 
			Запрос.Текст = ТекстПолученияВарианты(external_id);  
		Иначе 
			Запрос.Текст = ТекстПолученияКаталога(external_id);  
		КонецЕсли;
		Запрос.УстановитьПараметр("external_id",external_id); 
		Запрос.УстановитьПараметр("ВидЦен",   СкладЦена.ВидЦен); 
		Запрос.УстановитьПараметр("СписокСкладов",  МассивСкладов);
	ИначеЕсли (ИдЗапроса = "all" или ИдЗапроса = Неопределено или не ТолькоИзменения) Тогда 
		Если ЭтоВарианты Тогда 
			Запрос.Текст = ТекстПолученияВарианты();  
		Иначе 
			Запрос.Текст = ТекстПолученияКаталога();  
		КонецЕсли;
		Запрос.УстановитьПараметр("ВидЦен",   СкладЦена.ВидЦен); 
		Запрос.УстановитьПараметр("СписокСкладов",  МассивСкладов);
	ИначеЕсли ИдЗапроса = "updates" или ТолькоИзменения  Тогда 
		Узел = ПланыОбмена.ИнтеграцияСИнтернетМагазиномТовары.НайтиПоКоду("NN");
		Запрос.Текст = ТекстИзмененияКаталога();
		Если ЭтоВарианты Тогда 
			Запрос.Текст = ТекстИзмененияВарианты();  
		Иначе 
			Запрос.Текст = ТекстИзмененияКаталога();  
		КонецЕсли;
		Запрос.УстановитьПараметр("Узел",   Узел);
		Запрос.УстановитьПараметр("НомерСообщения",  0);
		Запрос.УстановитьПараметр("ВидЦен",   СкладЦена.ВидЦен); 
		Запрос.УстановитьПараметр("СписокСкладов",  МассивСкладов);
	Иначе
		Возврат Ложь; 
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивТоваров = Новый Массив;
	СчетчикСтрок = 0;
	
	// Пропускаем строки предыдущих страниц
	Пока СчетчикСтрок < ПропуститьСтрок И Выборка.Следующий() Цикл
		СчетчикСтрок = СчетчикСтрок + 1;
	КонецЦикла;
	
	// Собираем данные для текущей страницы
	СтрокДобавлено = 0;
	Пока СтрокДобавлено < limit И Выборка.Следующий() Цикл
		
		СтруктураТовара = Новый Структура;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Если ТипЗнч(Выборка[Колонка.Имя]) = Тип("УникальныйИдентификатор") Тогда
				СтруктураТовара.Вставить(Колонка.Имя, Строка(Выборка[Колонка.Имя])); 
			ИначеЕсли Колонка.Имя = "name_kz" и Выборка[Колонка.Имя] = Null Тогда 
				СтруктураТовара.Вставить("name_kz", Выборка.name_ru); 
			ИначеЕсли Колонка.Имя = "Ссылка" Тогда 	
				Продолжить; 
			Иначе	
				СтруктураТовара.Вставить(Колонка.Имя, Выборка[Колонка.Имя]); 
			КонецЕсли;
		КонецЦикла;
		Если ДанныеЗапроса.Сценарий = СценарийКаталог() Тогда 
	    	images(Выборка.Ссылка,СтруктураТовара);
		КонецЕсли;
		
		
		
		МассивТоваров.Добавить(СтруктураТовара);
		СтрокДобавлено = СтрокДобавлено + 1;
		
	КонецЦикла;
	
	
	Если ЭтоОдинЭлемент Тогда 	
		СтруктураОтвета.data  = МассивТоваров[0];
	Иначе 
 		СтруктураОтвета.data  = МассивТоваров;
		СтруктураОтвета.Вставить("next");	
		Если СтрокДобавлено < limit Тогда 
			НуженСледущий = Ложь;			
		Иначе
			НуженСледущий = Истина;			
		КонецЕсли;	
//		Если ПропуститьСтрок > 0 Тогда
			Если НуженСледущий Тогда 
				СтруктураОтвета.next = ПропуститьСтрок + МассивТоваров.Количество();  
			Иначе	
				СтруктураОтвета.next = Неопределено;			
			КонецЕсли;	
//		КонецЕсли;	
	КонецЕсли;	
	Возврат Истина;
КонецФункции   

Процедура images(Номенклатура,СтруктураТовара)
	Файлы = Новый Массив;
	images = Новый Массив();
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(Номенклатура, Файлы);
	Для каждого Файл Из Файлы Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(Файл);
		ДвоичныеДанныеКартинки = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
		Если ДвоичныеДанныеКартинки = Неопределено Тогда
			Продолжить; 
		иначе
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДвоичныеДанныеКартинки);
			СтрокаBase64 = Base64Строка(ДвоичныеДанные);
			СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
			СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
			images.Добавить(Новый Структура("filename,ext,image"
				,ДанныеФайла.ИмяФайла
				,ДанныеФайла.Расширение
				,СтрокаBase64
			));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если images.Количество() > 0 Тогда 
    	СтруктураТовара.Вставить("images",images);
	КонецЕсли;	
КонецПроцедуры
// GET    /hs/monapi/v1/products/all  - инфо 
Функция ТекстПолученияКаталога(external_id = Неопределено)
//data array Массив товаров
//data[].external_id string ID товара в 1С
//data[].external_category_id string ID категории в 1С
//data[].article string Артикул товара (обязателен: отображается в
//карточке товара МП — ТЗ 3.2.5.4; обязательное поле
//АП — ТЗ 3.1.4)
//data[].name_ru / name_kz string Название (ru / kz)
//data[].description_ru /
//description_kz
//string | null Описание (ru / kz)
//data[].base_price decimal Базовая цена товара, KZT (справочно; цена продажи
//— у варианта)
//data[].status string active | inactive
//next  
// Егор - Удалить наименование КЗ или предусмотреть отправку не null
Возврат  "ВЫБРАТЬ
         |	ЗапасыОстатки.Номенклатура КАК Номенклатура,
         |	СУММА(ЗапасыОстатки.Количество) КАК Остаток,
         |	СУММА(ЗапасыОстатки.Резерв) КАК Резерв
         |ПОМЕСТИТЬ ВТ_Остатки
         |ИЗ
         |	РегистрСведений.ОстаткиТоваров КАК ЗапасыОстатки
         |ГДЕ
         |	ЗапасыОстатки.СтруктурнаяЕдиница В(&СписокСкладов)
         |
         |СГРУППИРОВАТЬ ПО
         |	ЗапасыОстатки.Номенклатура
         |;
         |
         |////////////////////////////////////////////////////////////////////////////////
         |ВЫБРАТЬ РАЗЛИЧНЫЕ
         |	Товары.Наименование КАК name_ru,
         |	Товары.Ссылка КАК Ссылка,
         |	Товары.Код КАК article,
         |	ЕСТЬNULL(ТаблицаЦен.Цена, 0) КАК base_price,
         |	ВЫБОР
         |		КОГДА ЕСТЬNULL(ТаблицаОстатков.Остаток, 0) - ЕСТЬNULL(ТаблицаОстатков.Резерв, 0) > 0
         |			ТОГДА ""active""
         |		ИНАЧЕ ""inactive""
         |	КОНЕЦ КАК status,
         |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Товары.Ссылка) КАК external_id,
         |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Товары.Родитель.Ссылка) КАК external_category_id,
         |	ВЫРАЗИТЬ(Товары.Комментарий КАК СТРОКА(250)) КАК description_ru,
         |	Товары.Наименование КАК name_kz,
         |	ВЫРАЗИТЬ(Товары.Комментарий КАК СТРОКА(250)) КАК description_kz
         |ИЗ
         |	Справочник.Номенклатура КАК Товары
         |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ТаблицаОстатков
         |		ПО Товары.Ссылка = ТаблицаОстатков.Номенклатура
         |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦен = &ВидЦен) КАК ТаблицаЦен
         |		ПО Товары.Ссылка = ТаблицаЦен.Номенклатура
         |ГДЕ
         |	НЕ Товары.ЭтоГруппа" +
             ?(external_id = Неопределено
			 	," И Товары.mona_ПризнакПродажиОнлайн = ИСТИНА"
				," И УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Товары.Ссылка) = &external_id")
	         + "
	         |
	         |УПОРЯДОЧИТЬ ПО
	         |	external_id";
	
КонецФункции
